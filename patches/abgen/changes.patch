+ await a.page.getByLabel('Titel',{exact:true}).fill('Synthetic restart durable');
+ await b.page.waitForFunction(()=>document.querySelector('input[aria-label="Titel"]')?.value==='Synthetic restart durable');
+ await a.page.waitForTimeout(2500);
+ await a.context.close();await b.context.close();
+ const c=await signedIn(browser);
+ await c.page.locator('.document-card').first().click();
+ await c.page.getByLabel('Gemeinsam bearbeiten',{exact:true}).check();
+ await c.page.locator('.collab-bar[data-status="verbunden"]').waitFor();
+ assert.equal(await c.page.getByLabel('Titel',{exact:true}).inputValue(),'Synthetic restart durable');
