+ await page.goto(fixture.origin);
+ await page.getByLabel('E-Mail',{exact:true}).fill(fixture.email);
+ await page.getByLabel('Passwort',{exact:true}).fill(fixture.password);
+ assert.equal(await page.getByRole('button',{name:'Neues Konto anlegen',exact:true}).count(),0,'closed registration absent in UI');
+ await page.getByRole('button',{name:'Anmelden',exact:true}).click();
+ await page.locator('.document-card').first().waitFor();
+ return {context,page};
+}
+const browser=await chromium.launch({args:['--disable-dev-shm-usage']});
+try{
+ const a=await signedIn(browser),b=await signedIn(browser);
+ for(const client of [a,b]){
+  await client.page.locator('.document-card').first().click();
+  await client.page.getByLabel('Gemeinsam bearbeiten',{exact:true}).check();
+  await client.page.locator('.collab-bar[data-status="verbunden"]').waitFor();
+ }
