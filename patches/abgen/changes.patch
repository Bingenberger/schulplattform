+import { readFileSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+import type { UserRecord } from '../repositories/types.js';
+
+export function privateValue(env: NodeJS.ProcessEnv, name: string): string | undefined {
+  const direct = env[name];
+  const file = env[name + '_FILE'];
+  if (direct !== undefined && file) throw new Error('Credential has two sources: ' + name);
+  return file ? readFileSync(file, 'utf8').trim() : direct;
+}
+export function credentialVersion(user: Pick<UserRecord, 'id' | 'role' | 'passwordHash' | 'active'>): string {
+  return createHash('sha256').update(JSON.stringify([user.id, user.role, user.passwordHash, user.active])).digest('hex');
+}
