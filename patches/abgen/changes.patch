new file mode 100644
index 0000000..caf88f3
--- /dev/null
+++ b/apps/server/src/setup.ts
@@ -0,0 +1,58 @@
+import fs from 'node:fs';
+import tty from 'node:tty';
+import { randomUUID } from 'node:crypto';
+import { Pool } from 'pg';
+import { hashPassword } from './auth/password.js';
+import { loadConfig } from './config.js';
+import { databaseReady } from './db/migrate.js';
+
+async function hidden(fd: number, label: string): Promise<string> {
+  const input = new tty.ReadStream(fd);
+  input.setRawMode(true); input.resume();
+  fs.writeSync(fd, label);
+  let value = '';
+  return new Promise((resolve, reject) => {
+    const finish = () => { input.off('data', receive); input.setRawMode(false); input.pause(); input.unref(); fs.writeSync(fd, '\n'); };
+    const receive = (chunk: Buffer) => {
+      for (const character of chunk.toString()) {
+        if (character === '\u0003') { finish(); reject(new Error('Cancelled')); return; }
+        if (character === '\r' || character === '\n') { finish(); resolve(value); return; }
+        if (character === '\u007f' || character === '\b') value = value.slice(0, -1);
+        else if (value.length < 128 && character >= ' ') value += character;
+      }
+    };
+    input.on('data', receive);
+  });
+}
+async function main(): Promise<void> {
+  const fd = fs.openSync('/dev/tty', 'r+');
+  try {
+    const email = process.argv[2]?.trim().toLowerCase();
+    const name = process.argv[3]?.trim();
+    if (!email || email.length > 254 || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) || !name || name.length > 120)
+      throw new Error('Personal identity required');
+    const password = await hidden(fd, 'Persönliches Passwort (mindestens 12 Zeichen): ');
+    const confirmation = await hidden(fd, 'Wiederholen: ');
+    if (password.length < 12 || password !== confirmation) throw new Error('Password mismatch');
+    const config = loadConfig();
+    if (config.STORAGE !== 'postgres') throw new Error('Persistent storage required');
+    const pool = new Pool({ connectionString: config.DATABASE_URL, max: 1, connectionTimeoutMillis: 3000 });
+    try {
+      if (!(await databaseReady(pool))) throw new Error('Explicit migration required');
+      const hash = await hashPassword(password);
+      const client = await pool.connect();
+      try {
+        await client.query('BEGIN');
+        await client.query('SELECT pg_advisory_xact_lock($1)', [76401985]);
+        const count = await client.query('SELECT count(*)::int AS count FROM users');
+        if (count.rows[0]?.count !== 0) throw new Error('Existing accounts preserved');
+        await client.query('INSERT INTO users(id,email,display_name,password_hash,role,must_change_password,active) VALUES($1,$2,$3,$4,$5,false,true)',
+          [randomUUID(), email, name, hash, 'admin']);
+        await client.query('COMMIT');
+        fs.writeSync(fd, 'Persönliche Erstadministration angelegt.\n');
+      } catch (error) { await client.query('ROLLBACK'); throw error; }
+      finally { client.release(); }
+    } finally { await pool.end(); }
+  } finally { fs.closeSync(fd); }
+}
+void main().catch(() => { console.error('Lokale Einrichtung fehlgeschlagen; Terminal, Migration und vorhandene Konten prüfen.'); process.exitCode = 1; });
