diff --git a/packages/model/src/collaboration.ts b/packages/model/src/collaboration.ts
new file mode 100644
index 0000000..d7d921c
--- /dev/null
+++ b/packages/model/src/collaboration.ts
@@ -0,0 +1,67 @@
+import type { Item, Page, WorksheetDocument } from './index.js';
+export interface CollaborativeDoc {
+  getMap<T>(name: string): {
+    get(key: string): T | undefined;
+    set(key: string, value: T): unknown;
+    delete(key: string): void;
+    keys(): IterableIterator<string>;
+  };
+  transact(callback: () => void, origin?: unknown): unknown;
+}
+
+/** Dokument in das Yjs-Dokument schreiben (nur geänderte Felder). */
+export function writeDocument(doc: CollaborativeDoc, document_: WorksheetDocument, origin: unknown): void {
+  const items = doc.getMap<string>('items');
+  const order = doc.getMap<string>('order');
+  const meta = doc.getMap<string>('meta');
+
+  doc.transact(() => {
+    const seen = new Set<string>();
+    for (const page of document_.pages) {
+      for (const item of page.items) {
+        seen.add(item.id);
+        const json = JSON.stringify(item);
+        if (items.get(item.id) !== json) items.set(item.id, json);
+      }
+      const ids = JSON.stringify(page.items.map((item) => item.id));
+      if (order.get(page.id) !== ids) order.set(page.id, ids);
+    }
+    for (const key of [...items.keys()]) {
+      if (!seen.has(key)) items.delete(key);
+    }
+
+    // Alles, was nicht Feld ist: Seiten (ohne Felder), Einrichtung, Stile …
+    const rest = {
+      ...document_,
+      pages: document_.pages.map((page) => ({ ...page, items: [] })),
+    };
+    const json = JSON.stringify(rest);
+    if (meta.get('document') !== json) meta.set('document', json);
+  }, origin);
+}
+
+/** Dokument aus dem Yjs-Dokument zusammensetzen. */
+export function readDocument(doc: CollaborativeDoc): WorksheetDocument | null {
+  const meta = doc.getMap<string>('meta');
+  const raw = meta.get('document');
+  if (!raw) return null;
+
+  const base = JSON.parse(raw) as WorksheetDocument;
+  const items = doc.getMap<string>('items');
+  const order = doc.getMap<string>('order');
+
+  const pages: Page[] = base.pages.map((page) => {
+    const ids = order.get(page.id);
+    const list: string[] = ids ? (JSON.parse(ids) as string[]) : [];
+    return {
+      ...page,
+      items: list
+        .map((id) => items.get(id))
+        .filter((entry): entry is string => typeof entry === 'string')
+        .map((entry) => JSON.parse(entry) as Item),
+    };
+  });
+
+  return { ...base, pages };
+}
+
