+import * as Y from 'yjs';
+import { readCollaborativeDocument, writeCollaborativeDocument, type WorksheetDocument } from '@abgen/model';
+
+export const activeCollaboration = new Set<string>();
+export const closeCollaboration = new Map<string, () => Promise<void>>();
+export function seededDocument(body: WorksheetDocument): Y.Doc {
+  const doc = new Y.Doc();
+  writeCollaborativeDocument(doc, body, 'server-seed');
+  return doc;
+}
+export function snapshotBody(snapshot: Uint8Array): WorksheetDocument | null {
+  const doc = new Y.Doc();
+  try { Y.applyUpdate(doc, snapshot); return readCollaborativeDocument(doc); }
+  finally { doc.destroy(); }
+}
