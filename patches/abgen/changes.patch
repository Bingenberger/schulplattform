+FROM node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS dependencies
+ENV npm_config_cache=/tmp/npm-cache PNPM_HOME=/pnpm
+RUN npm install -g pnpm@12.15.0 && rm -rf /tmp/npm-cache
+WORKDIR /app
+COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
+COPY apps/server/package.json ./apps/server/
+COPY apps/web/package.json ./apps/web/
+COPY packages/generators/package.json ./packages/generators/
+COPY packages/model/package.json ./packages/model/
+COPY packages/render/package.json ./packages/render/
+COPY packages/text/package.json ./packages/text/
+RUN node --version && pnpm --version && pnpm install --frozen-lockfile
+
+FROM dependencies AS builder
+ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
+COPY tsconfig.base.json ./
+COPY apps ./apps
+COPY packages ./packages
+COPY assets ./assets
+COPY scripts ./scripts
+RUN pnpm fonts:check && pnpm -r --if-present build && pnpm -r --if-present typecheck
+
+FROM builder AS tests
+COPY e2e ./e2e
+COPY playwright.config.ts eslint.config.js .prettierrc.json ./
+USER 10001:10001
+
+FROM mcr.microsoft.com/playwright:v1.64.1-noble@sha256:2f05f8a734509a7b3f26a912639488ee08f58a7b292d14d62271bcff9038768f AS pdf
+ENV NODE_ENV=production PORT=3001 HOST=0.0.0.0
+WORKDIR /app
+RUN groupadd --gid 10001 abgen && useradd --uid 10001 --gid 10001 --create-home abgen
+COPY --from=builder /app /app
+USER 10001:10001
+EXPOSE 3001
+CMD ["node","apps/server/dist/pdf/index.js"]
+
+FROM node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS runtime
+ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0 RUN_MIGRATIONS=0
+WORKDIR /app
+RUN groupadd --gid 10001 abgen && useradd --uid 10001 --gid 10001 --no-create-home abgen \
+ && mkdir -p /app/data/assets && chown -R 10001:10001 /app/data
+COPY --from=builder /app /app
+USER 10001:10001
+EXPOSE 3000
+CMD ["node","apps/server/dist/index.js"]
