+  check((await request('/api/auth/me')).status===401,'deactivation immediately revokes copied HTTP session');
+  const revoked=new Promise(resolve=>schoolPeer.ws.once('close',resolve));
+  schoolPeer.ws.send(Buffer.from([0,0]));
+  await Promise.race([revoked,sleep(5000).then(()=>{throw new Error('revocation timeout');})]);
+  check(true,'existing collaborative socket rechecks deactivation on each frame');
+  cookie=adminCookie;
+  const role=await pool.query('SELECT rolsuper,rolcreatedb,rolcreaterole FROM pg_roles WHERE rolname=current_user');
+  check(!role.rows[0].rolsuper&&!role.rows[0].rolcreatedb&&!role.rows[0].rolcreaterole,'database role has no cluster administration');
+  console.log('FIXTURE_PRIVATE='+JSON.stringify({documentId:id,shareToken:share.token,playCode:code,assetHash:files[0].hash,teacherCookie}));
+ }else if(fixture.phase==='restart'||fixture.phase==='restore'){
+  const rows=await pool.query("SELECT id FROM documents WHERE id IN (SELECT document_id FROM collab_state)");
+  check(rows.rows.length>0,'snapshot survives abrupt API restart');
+  const id=rows.rows[0].id;
+  check((await load(id)).meta.title==='Synthetic restart durable','HTTP reload restores durable Yjs content after restart');
+  const client=await socket(id);
+  check(readCollaborativeDocument(client.doc).meta.title==='Synthetic restart durable','new peer restores durable Yjs content after restart');
+  client.ws.close();
+  if(fixture.phase==='restore'){
+   const saved=fixture.saved;
+   check((await request('/api/documents/'+saved.documentId+'?token='+saved.shareToken,'GET',undefined,false)).status===200,'original private share remains valid after empty restore');
+   check((await request('/api/play/'+saved.playCode,'GET',undefined,false)).status===200,'original native child play code remains valid after empty restore');
+   check((await request('/api/documents/'+saved.documentId+'/submissions','GET',undefined,false)).status===401,'anonymous restored child access cannot read teacher results');
+   const asset=await request('/api/assets/'+saved.assetHash,'GET',undefined,false);
+   const data=Buffer.from(await asset.arrayBuffer());
+   check(require('node:crypto').createHash('sha256').update(data).digest('hex')===saved.assetHash,'restored native asset bytes match original content hash');
+   check((await request('/api/auth/me','GET',undefined,false,{cookie:saved.teacherCookie})).status===401,'deactivated copied session remains revoked after restore');
+   const pdf=await request('/api/documents/'+saved.documentId+'/pdf','POST',{});
+   check(pdf.status===200&&Buffer.from(await pdf.arrayBuffer()).subarray(0,5).toString()==='%PDF-','real PDF renders restored collaborative document');
+  }
+ }
+} finally {await pool.end();}
