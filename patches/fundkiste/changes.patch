+++ b/tests/conftest.py
@@ -0,0 +1,22 @@
+import importlib
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+import pytest
+
+
+@pytest.fixture
+def env(tmp_path, monkeypatch):
+    monkeypatch.setenv("FUNDKISTE_DATA", str(tmp_path))
+    monkeypatch.setenv("FUNDKISTE_BASE_URL", "https://fundkiste.schule.example")
+    monkeypatch.delenv("FUNDKISTE_TEAM_KEY", raising=False)
+    monkeypatch.delenv("FUNDKISTE_TEAM_KEY_FILE", raising=False)
+    for name in ("app", "fk_migrate", "fk_setup"):
+        sys.modules.pop(name, None)
+    return tmp_path
+
+
+def load(name):
+    return importlib.import_module(name)
diff --git a/tests/test_platform.py b/tests/test_platform.py
new file mode 100644
index 0000000..472f42f
--- /dev/null
+++ b/tests/test_platform.py
@@ -0,0 +1,108 @@
+import io
+import os
+import sqlite3
+
+import pytest
+from PIL import Image
+
+from conftest import load
+
+LEGACY = """
+CREATE TABLE items (id TEXT PRIMARY KEY, category TEXT NOT NULL, note TEXT NOT NULL DEFAULT '',
+  photo TEXT, created_at TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'offen');
+CREATE TABLE requests (id TEXT PRIMARY KEY, text TEXT NOT NULL, category TEXT,
+  contact TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'offen');
+INSERT INTO items VALUES ('a1', 'jacke', 'blau', NULL, '2099-01-01T00:00:00+00:00', 'offen');
+INSERT INTO requests VALUES ('r1', 'Mütze', 'sonstiges', '', '2099-01-01T00:00:00+00:00', 'offen');
+"""
+
+
+def migrated(env):
+    load("fk_migrate").main()
+    return load("app")
+
+
+def test_not_ready_before_migration_and_no_schema_on_import(env):
+    app = load("app")
+    client = app.app.test_client()
+    assert client.get("/health/live").status_code == 200
+    assert client.get("/health/ready").status_code == 503
+    assert not (env / "fundkiste.db").exists()
+
+
+def test_fresh_migration_creates_schema_and_private_team_key(env):
+    app = migrated(env)
+    client = app.app.test_client()
+    assert client.get("/health/ready").status_code == 200
+    key = (env / "team_key.txt").read_text()
+    assert len(key) >= 32 and oct((env / "team_key.txt").stat().st_mode & 0o777) == "0o600"
+    assert client.get(f"/team/{key}").status_code == 200
+    assert client.get("/team/falsch-falsch-falsch").status_code == 404
+
+
+def test_legacy_database_and_short_key_are_adopted(env):
+    conn = sqlite3.connect(env / "fundkiste.db")
+    conn.executescript(LEGACY)
+    conn.close()
+    (env / "team_key.txt").write_text("AbCdEfGhIjKl")      # 12 Zeichen wie token_urlsafe(9)
+    app = migrated(env)
+    client = app.app.test_client()
+    items = client.get("/api/items").get_json()
+    assert items[0]["id"] == "a1" and items[0]["claimed_by"] == ""
+    assert client.get("/team/AbCdEfGhIjKl").status_code == 200
+    assert client.get("/api/requests").get_json()[0]["text"] == "Mütze"
+    load("fk_migrate").main()                                # wiederholbar
+
+
+def test_unknown_columns_are_refused(env):
+    conn = sqlite3.connect(env / "fundkiste.db")
+    conn.executescript(LEGACY + "ALTER TABLE requests ADD COLUMN telefon TEXT;")
+    conn.close()
+    with pytest.raises(load("fk_migrate").MigrationError):
+        load("fk_migrate").main()
+    assert sqlite3.connect(env / "fundkiste.db").execute("PRAGMA user_version").fetchone()[0] == 0
+
+
+def test_team_actions_and_photo_without_exif(env):
+    app = migrated(env)
+    client = app.app.test_client()
+    key = (env / "team_key.txt").read_text()
+    image = io.BytesIO()
+    exif = Image.Exif()
+    exif[0x010F] = "Kamera"
+    Image.new("RGB", (3000, 2000), "red").save(image, format="JPEG", exif=exif)
+    image.seek(0)
+    assert client.post("/api/items", data={"category": "jacke"}).status_code == 403
+    created = client.post("/api/items", headers={"X-Team-Key": key},
+                          data={"category": "jacke", "photo": (image, "x.jpg")}).get_json()
+    stored = Image.open(env / "photos" / os.path.basename(created["photo"]))
+    assert max(stored.size) == 1400 and not stored.getexif()
+    assert client.post(f"/api/items/{created['id']}/abholmeldung", json={"claimed_by": "Mia 2a"}).status_code == 200
+
+
+def test_qr_only_for_own_origin(env):
+    app = migrated(env)
+    client = app.app.test_client()
+    assert client.get("/qr.png?url=https://fundkiste.schule.example/team/x").status_code == 200
+    assert client.get("/qr.png?url=https://boese.example/").status_code == 400
+    key = (env / "team_key.txt").read_text()
+    page = client.get(f"/team/{key}/qr").get_data(as_text=True)
+    assert "https%3A//fundkiste.schule.example/team/" in page or "https://fundkiste.schule.example/team/" in page
+
+
+def test_retention_purges_old_entries(env, monkeypatch):
+    conn = sqlite3.connect(env / "fundkiste.db")
+    conn.executescript(LEGACY + "INSERT INTO items VALUES ('alt','jacke','',NULL,'2000-01-01T00:00:00+00:00','offen');")
+    conn.close()
+    app = migrated(env)
+    rows = sqlite3.connect(env / "fundkiste.db").execute("SELECT count(*) FROM items").fetchone()[0]
+    assert rows == 2                       # Migration/Import uebernimmt alles
+    ids = [i["id"] for i in app.app.test_client().get("/api/items").get_json()]
+    assert ids == ["a1"]                   # der erste Seitenaufruf setzt die Frist durch
+
+
+def test_key_sources_are_exclusive(env, monkeypatch):
+    monkeypatch.setenv("FUNDKISTE_TEAM_KEY", "x" * 20)
+    monkeypatch.setenv("FUNDKISTE_TEAM_KEY_FILE", str(env / "k"))
+    with pytest.raises(RuntimeError):
+        load("app")
