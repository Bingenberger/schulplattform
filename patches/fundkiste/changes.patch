index 0000000..6e05a85
--- /dev/null
+++ b/fk_migrate.py
@@ -0,0 +1,116 @@
+"""Expliziter, gesperrter Schema-Schritt der Fundkiste (Stand 1). Keine Datenumwandlung mit Verlust.
+
+- leere/fehlende Datenbank: Tabellen anlegen
+- bestehende Datenbank vor der Plattform (user_version 0): bekannte Tabellen uebernehmen,
+  fehlende Spalte claimed_by nachruesten (aeltere Fassungen)
+- unbekannte Tabellen/Spalten oder neuerer Stand: Abbruch ohne Aenderung
+- Team-Schluessel anlegen, falls noch keiner konfiguriert ist (data/team_key.txt, 0600)
+"""
+import fcntl
+import os
+import secrets
+import sqlite3
+import sys
+
+import app as fundkiste
+
+CREATE = {
+    "items": """CREATE TABLE items (
+            id         TEXT PRIMARY KEY,
+            category   TEXT NOT NULL,
+            note       TEXT NOT NULL DEFAULT '',
+            photo      TEXT,
+            created_at TEXT NOT NULL,
+            status     TEXT NOT NULL DEFAULT 'offen',
+            claimed_by TEXT NOT NULL DEFAULT ''
+        )""",
+    "requests": """CREATE TABLE requests (
+            id         TEXT PRIMARY KEY,
+            text       TEXT NOT NULL,
+            category   TEXT,
+            contact    TEXT NOT NULL DEFAULT '',
+            created_at TEXT NOT NULL,
+            status     TEXT NOT NULL DEFAULT 'offen'
+        )""",
+}
+OPTIONAL_LEGACY = {"items": {"claimed_by"}}
+
+
+class MigrationError(Exception):
+    pass
+
+
+def migrate(conn):
+    version = conn.execute("PRAGMA user_version").fetchone()[0]
+    if version == fundkiste.SCHEMA_VERSION:
+        return "aktuell"
+    if version > fundkiste.SCHEMA_VERSION:
+        raise MigrationError(f"Datenbank hat neueren Stand {version}")
+    tables = {r[0] for r in conn.execute(
+        "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")}
+    unknown = tables - set(CREATE)
+    if unknown:
+        raise MigrationError(f"Unbekannte Tabellen: {', '.join(sorted(unknown))}")
+    conn.execute("BEGIN IMMEDIATE")
+    try:
+        for table, statement in CREATE.items():
+            if table not in tables:
+                conn.execute(statement)
+                continue
+            have = {row[1] for row in conn.execute(f'PRAGMA table_info("{table}")')}
+            want = fundkiste.EXPECTED_COLUMNS[table]
+            extra = have - want
+            missing = want - have
+            if extra or missing - OPTIONAL_LEGACY.get(table, set()):
+                raise MigrationError(f"Tabelle {table}: unerwartete Spalten {sorted(extra)}, fehlend {sorted(missing)}")
+            if "claimed_by" in missing:
+                conn.execute("ALTER TABLE items ADD COLUMN claimed_by TEXT NOT NULL DEFAULT ''")
+        conn.execute(f"PRAGMA user_version = {fundkiste.SCHEMA_VERSION}")
+        conn.execute("COMMIT")
+    except BaseException:
+        conn.execute("ROLLBACK")
+        raise
+    return "uebernommen" if tables else "angelegt"
+
+
+def ensure_team_key():
+    if fundkiste.read_team_key():
+        return False
+    old = os.umask(0o077)
+    try:
+        with open(fundkiste.KEY_PATH, "x", encoding="utf-8") as fh:
+            fh.write(secrets.token_urlsafe(24))
+    finally:
+        os.umask(old)
+    return True
+
+
+def main():
+    os.makedirs(fundkiste.PHOTO_DIR, exist_ok=True)
+    with open(os.path.join(fundkiste.DATA_DIR, ".schema.lock"), "a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        conn = sqlite3.connect(fundkiste.DB_PATH, timeout=30, isolation_level=None)
+        try:
+            conn.execute("PRAGMA journal_mode=WAL")
+            result = migrate(conn)
+            problems = conn.execute("PRAGMA integrity_check").fetchone()[0]
+            if problems != "ok":
+                raise MigrationError("Integritaetspruefung fehlgeschlagen")
+        finally:
+            conn.close()
+        os.chmod(fundkiste.DB_PATH, 0o600)
+        created = ensure_team_key()
+        fundkiste.TEAM_KEY = fundkiste.read_team_key()
+        # Kein Aufraeumen hier: ein Import soll alle Zeilen unveraendert uebernehmen.
+        # Die Aufbewahrungsfrist setzt die laufende App stuendlich durch.
+    if not fundkiste.schema_ready():
+        raise MigrationError("Schema-Pruefung nach der Migration fehlgeschlagen")
+    print(f"Fundkiste: Schema {fundkiste.SCHEMA_VERSION} {result}"
+          + ("; neuer Team-Schluessel angelegt (./install.sh app-setup fundkiste zeigt ihn)" if created else ""))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except MigrationError as exc:
+        sys.exit(f"Migration abgebrochen: {exc}")
diff --git a/fk_setup.py b/fk_setup.py
new file mode 100644
index 0000000..7497773
--- /dev/null
+++ b/fk_setup.py
@@ -0,0 +1,22 @@
+"""Zeigt dem Team auf der Konsole seinen geheimen Zugang (Team-Seite und druckbarer QR-Code).
+
+Plattform: ./install.sh app-setup fundkiste
+Der Schluessel wird nicht geaendert. Ausgabe nur auf dem Terminal, nicht in Logs.
+"""
+import sys
+
+import app as fundkiste
+
+
+def main():
+    key = fundkiste.read_team_key()
+    if not key:
+        sys.exit("Noch kein Team-Schluessel – zuerst 'python fk_migrate.py' ausfuehren.")
+    root = fundkiste.BASE_URL or "http://<adresse-der-fundkiste>"
+    print(f"Team-Seite:  {root}/team/{key}")
+    print(f"QR-Code:     {root}/team/{key}/qr   (ausdrucken, nur intern aushaengen)")
+    print("Den Link nur im Team weitergeben; wer ihn kennt, kann Fundstuecke anlegen und loeschen.")
+
+
+if __name__ == "__main__":
+    main()
