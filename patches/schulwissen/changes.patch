diff --git a/kern/health.py b/kern/health.py
new file mode 100644
index 0000000..a53dc63
--- /dev/null
+++ b/kern/health.py
@@ -0,0 +1,20 @@
+"""Separate process liveness and database/migration readiness."""
+from django.db import connection, DatabaseError
+from django.db.migrations.executor import MigrationExecutor
+from django.http import JsonResponse
+
+
+def live(request):
+    return JsonResponse({"status": "alive"})
+
+
+def ready(request):
+    try:
+        with connection.cursor() as cursor:
+            cursor.execute("SELECT 1")
+        executor = MigrationExecutor(connection)
+        if executor.migration_plan(executor.loader.graph.leaf_nodes()):
+            return JsonResponse({"status": "not-ready"}, status=503)
+    except DatabaseError:
+        return JsonResponse({"status": "not-ready"}, status=503)
+    return JsonResponse({"status": "ready"})
diff --git a/kern/management/commands/platform_migrate.py b/kern/management/commands/platform_migrate.py
new file mode 100644
index 0000000..9568119
--- /dev/null
+++ b/kern/management/commands/platform_migrate.py
@@ -0,0 +1,19 @@
+"""Explicit migration job with a PostgreSQL advisory lock per database."""
+from django.core.management import call_command
+from django.core.management.base import BaseCommand, CommandError
+from django.db import connection
+
+
+class Command(BaseCommand):
+    help = "Apply migrations and roles exclusively; never run on web process startup."
+
+    def handle(self, *args, **options):
+        with connection.cursor() as cursor:
+            cursor.execute("SELECT pg_try_advisory_lock(hashtext(current_database()), 1729)")
+            if not cursor.fetchone()[0]:
+                raise CommandError("Another migration job holds the database lock.")
+            try:
+                call_command("migrate", interactive=False)
+                call_command("rollen_einrichten")
+            finally:
+                cursor.execute("SELECT pg_advisory_unlock(hashtext(current_database()), 1729)")
diff --git a/kern/proxy.py b/kern/proxy.py
new file mode 100644
index 0000000..2b326f0
--- /dev/null
+++ b/kern/proxy.py
@@ -0,0 +1,24 @@
+"""Honor forwarding metadata only from explicitly configured proxy addresses."""
+import ipaddress
+import os
+
+
+class TrustedProxyHeaders:
+    def __init__(self, get_response):
+        self.get_response = get_response
+        self.allowed = {str(ipaddress.ip_address(value.strip()))
+                        for value in os.environ.get("SW_PROXY_IPS", "127.0.0.1,::1").split(",")
+                        if value.strip()}
+
+    def __call__(self, request):
+        try:
+            trusted = str(ipaddress.ip_address(request.META.get("REMOTE_ADDR", ""))) in self.allowed
+        except ValueError:
+            trusted = False
+        if not trusted:
+            for key in list(request.META):
+                if key.startswith("HTTP_X_FORWARDED_") or key in (
+                        "HTTP_FORWARDED", "HTTP_X_REAL_IP", "REMOTE_USER",
+                        "HTTP_REMOTE_USER", "HTTP_X_AUTH_REQUEST_USER"):
+                    request.META.pop(key, None)
+        return self.get_response(request)
