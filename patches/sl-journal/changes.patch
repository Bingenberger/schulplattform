+"""Waitress für den Container. Forwarded-Header wertet die App selbst aus (JOURNAL_PROXY_IPS)."""
+from waitress import serve
+
+from journal.app import create_app
+
+
+def main():
+    serve(create_app(), listen='0.0.0.0:8000', threads=4, ident=None,
+          clear_untrusted_proxy_headers=False, channel_timeout=120)
+
+
+if __name__ == '__main__':
+    main()
