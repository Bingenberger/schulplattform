diff --git a/journal/platform.py b/journal/platform.py
new file mode 100644
index 0000000..4f1ebc9
--- /dev/null
+++ b/journal/platform.py
@@ -0,0 +1,87 @@
+"""Betrieb in der Schulplattform: expliziter Schemaschritt, Readiness, Proxy-Vertrauen."""
+from __future__ import annotations
+
+import hashlib
+import ipaddress
+import os
+from pathlib import Path
+
+from flask import jsonify
+from werkzeug.middleware.proxy_fix import ProxyFix
+
+
+def proxy_ips() -> frozenset:
+    items = [v.strip() for v in os.environ.get('JOURNAL_PROXY_IPS', '').split(',') if v.strip()]
+    for item in items:
+        ipaddress.ip_address(item)  # nur explizite Adressen, keine Netze und kein '*'
+    return frozenset(items)
+
+
+class TrustedProxyFix:
+    """X-Forwarded-For/-Proto/-Host nur von den konfigurierten Proxy-Adressen."""
+
+    def __init__(self, wsgi_app, proxies):
+        self.plain = wsgi_app
+        self.fixed = ProxyFix(wsgi_app, x_for=1, x_proto=1, x_host=1)
+        self.proxies = proxies
+
+    def __call__(self, environ, start_response):
+        target = self.fixed if environ.get('REMOTE_ADDR') in self.proxies else self.plain
+        return target(environ, start_response)
+
+
+def schema_digest() -> str:
+    """Kennung des Schemas dieses Codes: ändert sich mit jeder Schemadefinition."""
+    from . import attachment_search, db, mobile_api
+    digest = hashlib.sha256()
+    for module in (db, attachment_search, mobile_api):
+        digest.update(Path(module.__file__).read_bytes())
+    return digest.hexdigest()
+
+
+def migrate_schema(app) -> None:
+    """Alle Schemaschritte (wie bisher beim Start) und danach den Stand vermerken."""
+    from . import attachment_search, mobile_api
+    from .db import get_db, init_db, set_setting
+    with app.app_context():
+        init_db()
+        attachment_search.init()
+        mobile_api.init()
+        set_setting('platform_schema', schema_digest())
+        get_db().commit()
+
+
+def schema_ready(app) -> bool:
+    """Datenbank lässt sich mit dem Schlüssel öffnen und trägt den Schemastand dieses Codes."""
+    path = Path(app.instance_path) / 'journal.db'
+    if not path.is_file():
+        return False
+    from .db import connect
+    try:
+        db = connect(path, app.config['DATA_KEY'])
+        try:
+            row = db.execute("SELECT value FROM settings WHERE key='platform_schema'").fetchone()
+        finally:
+            db.close()
+    except Exception:
+        return False
+    if row is None:
+        return False
+    value = row[0]
+    try:
+        import json
+        value = json.loads(value)
+    except (TypeError, ValueError):
+        pass
+    return value == schema_digest()
+
+
+def register(app) -> None:
+    @app.get('/health/live')
+    def health_live():
+        return jsonify(status='ok')
+
+    @app.get('/health/ready')
+    def health_ready():
+        ready = schema_ready(app)
+        return jsonify(status='ready' if ready else 'not-ready'), (200 if ready else 503)
