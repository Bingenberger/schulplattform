+FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c AS runtime
+ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 HOME=/tmp \
+    JOURNAL_INSTANCE=/data JOURNAL_AUTO_MIGRATE=0 TZ=Europe/Berlin
+WORKDIR /app
+# PDF-Text/-Vorschau (Poppler), Texterkennung in Anhängen (Tesseract, Deutsch),
+# Office-Vorschau (LibreOffice ohne Oberfläche)
+RUN apt-get update && apt-get install -y --no-install-recommends \
+      poppler-utils tesseract-ocr tesseract-ocr-deu \
+      libreoffice-writer-nogui libreoffice-calc-nogui libreoffice-impress-nogui fonts-dejavu-core fonts-liberation \
+    && rm -rf /var/lib/apt/lists/*
+COPY requirements.lock ./
+RUN pip install --no-cache-dir --require-hashes -r requirements.lock
+COPY manage.py wsgi.py ./
+COPY journal ./journal
+RUN groupadd --gid 10001 journal && useradd --uid 10001 --gid 10001 --no-create-home journal \
+    && mkdir -p /data && chown 10001:10001 /data && chmod 700 /data
+USER 10001:10001
+EXPOSE 8000
+CMD ["python", "-m", "journal.serve"]
+
+FROM runtime AS tests
+ENV JOURNAL_AUTO_MIGRATE=1
+USER 0
+COPY requirements-test.lock ./
+RUN pip install --no-cache-dir --require-hashes -r requirements-test.lock
+COPY tests ./tests
+COPY scripts ./scripts
+USER 10001:10001
+CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]
+
+FROM runtime AS final
