diff --git a/tests/test_platform.py b/tests/test_platform.py
new file mode 100644
index 0000000..34f1493
--- /dev/null
+++ b/tests/test_platform.py
@@ -0,0 +1,88 @@
+"""Plattformbetrieb: Schema nur ausdrücklich, Readiness, Proxy-Vertrauen, Schlüssel aus Datei."""
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from cryptography.fernet import Fernet
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+@pytest.fixture
+def container_env(tmp_path, monkeypatch):
+    key = tmp_path / 'secrets' / 'master-key'
+    key.parent.mkdir()
+    key.write_bytes(Fernet.generate_key())
+    monkeypatch.setenv('JOURNAL_INSTANCE', str(tmp_path / 'data'))
+    monkeypatch.setenv('JOURNAL_KEY_FILE', str(key))
+    monkeypatch.setenv('JOURNAL_AUTO_MIGRATE', '0')
+    monkeypatch.delenv('JOURNAL_TRUST_PROXY', raising=False)
+    monkeypatch.delenv('JOURNAL_PROXY_IPS', raising=False)
+    return tmp_path
+
+
+def manage(*args):
+    return subprocess.run([sys.executable, 'manage.py', *args], cwd=ROOT, capture_output=True, text=True)
+
+
+def test_start_changes_nothing_and_ready_only_after_migrate(container_env):
+    from journal.app import create_app
+    app = create_app()
+    client = app.test_client()
+    assert client.get('/health/live').status_code == 200
+    assert client.get('/health/ready').status_code == 503
+    assert not (container_env / 'data' / 'journal.db').exists()
+    result = manage('migrate')
+    assert result.returncode == 0, result.stderr
+    assert 'Schema aktuell' in result.stdout
+    assert client.get('/health/ready').status_code == 200
+    assert manage('migrate').returncode == 0
+
+
+def test_wrong_key_is_not_ready(container_env, monkeypatch):
+    assert manage('migrate').returncode == 0
+    other = container_env / 'other-key'
+    other.write_bytes(Fernet.generate_key())
+    monkeypatch.setenv('JOURNAL_KEY_FILE', str(other))
+    from journal.app import create_app
+    assert create_app().test_client().get('/health/ready').status_code == 503
+
+
+def test_missing_platform_key_is_never_generated(container_env, monkeypatch):
+    monkeypatch.setenv('JOURNAL_KEY_FILE', str(container_env / 'fehlt'))
+    from journal.app import create_app
+    with pytest.raises(RuntimeError):
+        create_app()
+    assert not (container_env / 'fehlt').exists()
+
+
+def test_forwarded_headers_only_from_configured_proxy(container_env, monkeypatch):
+    monkeypatch.setenv('JOURNAL_PROXY_IPS', '10.231.15.2')
+    assert manage('migrate').returncode == 0
+    from journal.app import create_app
+    client = create_app().test_client()
+    headers = {'X-Forwarded-Proto': 'https', 'X-Forwarded-Host': 'journal.schule.example', 'X-Forwarded-For': '203.0.113.5'}
+    trusted = client.get('/login', headers=headers, environ_base={'REMOTE_ADDR': '10.231.15.2'})
+    assert trusted.status_code != 400            # gilt als HTTPS
+    other = client.get('/login', headers=headers, environ_base={'REMOTE_ADDR': '10.9.9.9'})
+    assert other.status_code == 400 and 'HTTPS' in other.get_data(as_text=True)
+    monkeypatch.setenv('JOURNAL_PROXY_IPS', '*')
+    with pytest.raises(ValueError):
+        create_app()
+
+
+def test_init_prints_platform_address(container_env, monkeypatch):
+    monkeypatch.setenv('JOURNAL_PUBLIC_URL', 'https://journal.schule.example')
+    assert manage('migrate').returncode == 0
+    result = manage('init')
+    assert 'Einrichtungscode' in result.stdout and 'https://journal.schule.example/setup' in result.stdout
+
+
+def test_worker_schedule():
+    from datetime import datetime
+    from zoneinfo import ZoneInfo
+    from journal import worker
+    berlin = ZoneInfo('Europe/Berlin')
+    assert worker.next_maintenance(datetime(2026, 11, 5, 2, 0, tzinfo=berlin)).hour == 3
+    assert worker.next_maintenance(datetime(2026, 11, 5, 4, 0, tzinfo=berlin)).day == 6
