@@ -0,0 +1,80 @@
+"""Hintergrunddienst im Container (ersetzt journal-sync.timer und journal-maintenance.timer).
+
+- alle fünf Minuten: Archivpostfach und Kalender abgleichen (``manage.py sync``)
+- täglich um 03:15 Ortszeit: Serienaufgaben, Löschfristen, Anhangsindex, Kalender des
+  Schuljahres; die app-eigene Sicherung nur mit JOURNAL_APP_BACKUP=1 (die Plattform
+  sichert das Datenvolume selbst)
+Fehler eines Laufs beenden den Dienst nicht. Ein Herzschlag in /tmp dient dem Healthcheck.
+"""
+import os
+import signal
+import threading
+import time
+from datetime import datetime, timedelta
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+SYNC_SECONDS = int(os.environ.get('JOURNAL_SYNC_SECONDS', '300'))
+MAINTENANCE_AT = os.environ.get('JOURNAL_MAINTENANCE_AT', '03:15')
+ZONE = ZoneInfo(os.environ.get('JOURNAL_TIMEZONE', 'Europe/Berlin'))
+HEARTBEAT = Path(os.environ.get('JOURNAL_WORKER_HEARTBEAT', '/tmp/journal-worker.alive'))
+stop = threading.Event()
+
+
+def next_maintenance(now):
+    hour, minute = (int(x) for x in MAINTENANCE_AT.split(':'))
+    due = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
+    return due if due > now else due + timedelta(days=1)
+
+
+def sync(app):
+    from journal.integrations import sync_all
+    with app.app_context():
+        print(sync_all(), flush=True)
+
+
+def maintenance(app):
+    from journal.attachment_search import process_pending
+    from journal.integrations import sync_school_year
+    from journal.maintenance import backup, purge
+    from journal.recurrence import generate
+    with app.app_context():
+        generate()
+        print(f'{len(purge(apply=True))} Einträge nach Löschfrist entfernt.', flush=True)
+        process_pending()
+        if os.environ.get('JOURNAL_APP_BACKUP') == '1':
+            print(backup(), flush=True)
+        try:
+            print(sync_school_year() + ' (Schuljahr)', flush=True)
+        except Exception as fehler:
+            print(f'Kalender des Schuljahres nicht geladen: {type(fehler).__name__}', flush=True)
+
+
+def guarded(name, job, app):
+    try:
+        job(app)
+    except Exception as fehler:  # nächster Lauf zur nächsten Zeit
+        print(f'{name} fehlgeschlagen: {type(fehler).__name__}: {fehler}', flush=True)
+
+
+def main():
+    from journal.app import create_app
+    os.umask(0o077)
+    app = create_app()
+    signal.signal(signal.SIGTERM, lambda *_: stop.set())
+    signal.signal(signal.SIGINT, lambda *_: stop.set())
+    due_maintenance = next_maintenance(datetime.now(ZONE))
+    next_sync = time.monotonic() + 60
+    while not stop.is_set():
+        HEARTBEAT.touch()
+        if time.monotonic() >= next_sync:
+            guarded('Abgleich', sync, app)
+            next_sync = time.monotonic() + SYNC_SECONDS
+        if datetime.now(ZONE) >= due_maintenance:
+            guarded('Wartung', maintenance, app)
+            due_maintenance = next_maintenance(datetime.now(ZONE))
+        stop.wait(30)
+
+
+if __name__ == '__main__':
+    main()
