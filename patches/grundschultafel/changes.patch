+// Categories follow Tagestransparenz_Kartenbibliothek.md. Flat asset URLs stay
+// unchanged; future cards can instead be placed in category subdirectories.
+export const JOURNAL_FOLDERS = [
+  { id: 'faecher', label: 'Fächer und Lernbereiche' },
+  { id: 'tagesablauf', label: 'Tagesablauf, Rituale und Ganztag' },
+  { id: 'sozialformen', label: 'Sozialformen' },
+  { id: 'sitzordnungen', label: 'Sitzordnungen' },
+  { id: 'unterrichtsphasen', label: 'Unterrichtsphasen und Ziele' },
+  { id: 'arbeitsformen', label: 'Arbeitsformen und Methoden' },
+  { id: 'aktivitaeten', label: 'Unterrichtsaktivitäten' },
+  { id: 'rueckmeldung', label: 'Rückmeldung und Unterstützung' },
+  { id: 'ereignisse', label: 'Ereignisse und Lernorte' },
+  { id: 'klassendienste', label: 'Klassendienste' },
+  { id: 'rollen', label: 'Ämter und Gruppenrollen' },
+  { id: 'material', label: 'Material und Handlungen' },
+  { id: 'steuerkarten', label: 'Steuerkarten' },
+];
+
+export interface JournalCard { url: string; name: string; folder: string }
+export interface JournalFolder { id: string; label: string; count: number }
+export interface JournalLibrary {
+  images: string[]; // retained for clients expecting the original API
+  cards: JournalCard[];
+  folders: JournalFolder[];
+}
+
+export function searchKey(value: string) {
+  return value.toLocaleLowerCase('de').replace(/ä/g, 'a').replace(/ö/g, 'o')
+    .replace(/ü/g, 'u').replace(/ß/g, 'ss').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
+}
+
+export function cardName(filename: string) {
+  return filename.replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' ')
+    .toLocaleLowerCase('de').replace(/^\p{L}/u, letter => letter.toLocaleUpperCase('de'));
+}
+
+const LEGACY_FOLDERS: Record<string, string[]> = {
+  faecher: ['Deutsch', 'Mathematik', 'Mathe', 'Sachunterricht', 'Englisch', 'Musik', 'Kunst', 'Sport', 'Religion', 'Ethik', 'Werken'],
+  tagesablauf: ['Frühstück', 'Pause', 'Klassenrat', 'Aufräumen'],
+  sozialformen: ['Einzelarbeit', 'Partnerarbeit', 'Gruppenarbeit'],
+  sitzordnungen: ['Sitzkreis'],
+  arbeitsformen: ['Stationenarbeit', 'Stationenlernen', 'Freiarbeit', 'Wochenplan'],
+  aktivitaeten: ['Lesen'],
+};
+
+export function legacyFolder(filename: string) {
+  const name = searchKey(cardName(filename));
+  return Object.entries(LEGACY_FOLDERS).find(([, names]) =>
+    names.some(candidate => searchKey(candidate) === name))?.[0] ?? 'eigene-karten';
+}
+
+export function inFolder(cardFolder: string, folder: string) {
+  return cardFolder === folder || cardFolder.startsWith(`${folder}/`);
+}
