+// Journal cards shipped with the image are added to the asset directory when
+// missing. Existing files (imported, replaced or added by the school) stay.
+function seed(source,target){
+  if(!fs.existsSync(source))return 0;
+  let added=0;
+  for(const entry of fs.readdirSync(source,{withFileTypes:true})){
+    const from=path.join(source,entry.name),to=path.join(target,entry.name);
+    if(entry.isDirectory()){fs.mkdirSync(to,{recursive:true,mode:0o700});added+=seed(from,to);}
+    else if(entry.isFile()&&/\.webp$/i.test(entry.name)&&!fs.existsSync(to)){
+      const descriptor=fs.openSync(to,'wx',0o600);
+      try{fs.writeFileSync(descriptor,fs.readFileSync(from));fs.fsyncSync(descriptor);}finally{fs.closeSync(descriptor);}
+      added++;
+    }
+  }
+  return added;
+}
