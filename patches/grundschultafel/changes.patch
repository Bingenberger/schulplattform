+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const Module = require('node:module');
+const ts = require('typescript');
+
+// Use the same lightweight TypeScript loading approach as test-users.cjs.
+function load(name, dependencies = {}) {
+  const source = path.resolve(__dirname, '../src/lib/' + name + '.ts');
+  const loaded = new Module(source, module);
+  loaded.filename = source;
+  loaded.paths = Module._nodeModulePaths(path.dirname(source));
+  const originalRequire = loaded.require.bind(loaded);
+  loaded.require = request => dependencies[request] ?? originalRequire(request);
+  loaded._compile(ts.transpileModule(fs.readFileSync(source, 'utf8'), {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, esModuleInterop: true },
+  }).outputText, source);
+  return loaded.exports;
+}
+const catalog = load('journalCatalog');
+const { readJournalLibrary } = load('journalLibrary', { './journalCatalog': catalog });
+const temporary = fs.mkdtempSync(path.join(os.tmpdir(), 'tafel-journal-test-'));
+
+(async () => {
+  try {
+    const missing = path.join(temporary, 'missing');
+    const empty = await readJournalLibrary(missing);
+    assert.equal(empty.cards.length, 0);
+    assert.equal(empty.folders.length, 13);
+    assert.ok(empty.folders.every(folder => folder.count === 0));
+    assert.equal(fs.existsSync(missing), false, 'listing must not create directories');
+
+    const root = path.join(temporary, 'journal');
+    fs.mkdirSync(path.join(root, 'faecher', 'Weitere Sprachen'), { recursive: true });
+    fs.mkdirSync(path.join(root, 'Eigene Rituale'));
+    for (const filename of ['DEUTSCH.png', 'FRÜHSTÜCK.png', 'PARTNERARBEIT.png', 'SITZKREIS.png', 'MEINE KARTE.webp', 'Tagestransparenz_Kartenbibliothek.md']) {
+      fs.writeFileSync(path.join(root, filename), 'fixture');
+    }
+    fs.writeFileSync(path.join(root, 'faecher', 'Weitere Sprachen', 'FRANZÖSISCH.png'), 'fixture');
+    fs.writeFileSync(path.join(root, 'Eigene Rituale', 'MORGENLIED.JPG'), 'fixture');
+    // A large original and the small WebP twin of scripts/optimize-journal-images.cjs
+    fs.writeFileSync(path.join(root, 'TAFELDIENST.png'), 'fixture');
+    fs.writeFileSync(path.join(root, 'TAFELDIENST.webp'), 'fixture');
+    fs.symlinkSync(root, path.join(root, 'Schleife'));
+    fs.symlinkSync(path.join(root, 'DEUTSCH.png'), path.join(root, 'Link.png'));
+    fs.writeFileSync(path.join(root, 'unzulässig?.png'), 'fixture');
+
+    const library = await readJournalLibrary(root);
+    assert.equal(library.cards.length, 8, 'ignore markdown, symlinks, unservable filenames and superseded originals');
+    assert.ok(library.images.includes('/assets/journal/TAFELDIENST.webp'), 'offer the optimized twin');
+    assert.ok(!library.images.includes('/assets/journal/TAFELDIENST.png'), 'hide the original behind its twin');
+    assert.ok(library.images.includes('/assets/journal/DEUTSCH.png'), 'keep legacy URLs');
+    assert.ok(library.images.includes('/assets/journal/FR%C3%9CHST%C3%9CCK.png'));
+    assert.ok(library.images.includes('/assets/journal/faecher/Weitere%20Sprachen/FRANZ%C3%96SISCH.png'));
+    assert.equal(library.cards.find(card => card.name === 'Sitzkreis').folder, 'sitzordnungen');
+    assert.equal(library.cards.find(card => card.name === 'Partnerarbeit').folder, 'sozialformen');
+    assert.equal(library.cards.find(card => card.name === 'Meine karte').folder, 'eigene-karten');
+    assert.equal(library.folders.find(folder => folder.id === 'faecher').count, 2, 'counts include nested folders');
+    assert.equal(library.folders.find(folder => folder.id === 'faecher/Weitere Sprachen').count, 1);
+    assert.equal(library.folders.find(folder => folder.id === 'Eigene Rituale').count, 1);
+    assert.equal(catalog.inFolder('faecher/Weitere Sprachen', 'faecher'), true);
+    assert.equal(catalog.inFolder('faecher-extra', 'faecher'), false);
+    assert.equal(catalog.searchKey('FRÜHSTÜCK'), catalog.searchKey('fruhstuck'));
+
+    const actual = await readJournalLibrary(path.resolve(__dirname, '../public/assets/journal'));
+    assert.ok(actual.cards.length >= 22);
+    assert.equal(actual.cards.find(card => card.name === 'Deutsch').folder, 'faecher');
+    assert.equal(actual.cards.find(card => card.name === 'Partnerarbeit').folder, 'sozialformen');
+    assert.equal(actual.cards.find(card => card.name === 'Sitzkreis').folder, 'sitzordnungen');
+    assert.ok(actual.images.every(url => !url.endsWith('.md')));
+    const keys = actual.cards.map(card => card.url.replace(/\.[^.]+$/, ''));
+    assert.equal(new Set(keys).size, keys.length, 'every card is offered once, optimized or original');
+    console.log('PASS: categories, existing URLs, nested folders, counts, search, non-image files, optimized twins and symlink loops');
+  } finally {
+    fs.rmSync(temporary, { recursive: true, force: true });
+  }
+})().catch(error => { console.error(error); process.exitCode = 1; });
diff --git a/src/app/api/journal/favorites/route.ts b/src/app/api/journal/favorites/route.ts
new file mode 100644
index 0000000..4910d6b
--- /dev/null
+++ b/src/app/api/journal/favorites/route.ts
@@ -0,0 +1,47 @@
+export const dynamic='force-dynamic';
+import {NextResponse} from 'next/server';
+import {createHash} from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import {getSession} from '@/lib/session';
+import {boundedJson} from '@/lib/platform';
+import * as store from '@/lib/file-store.cjs';
+
+// Favourite journal cards of a teacher, stored next to the other own settings.
+// Only card addresses are kept; cards deleted meanwhile are ignored by the picker.
+const MAX_FAVOURITES=500;
+const MAX_URL=512;
+
+const file=(userId:string)=>path.join(store.dataDir(),userId,'settings','journal-favorites.json');
+
+function sanitize(body:unknown):string[]{
+  const list=(body as {favorites?:unknown})?.favorites;
+  if(!Array.isArray(list)||list.length>MAX_FAVOURITES)throw new Error('Invalid favourites');
+  const urls=list.filter((url:unknown):url is string=>
+    typeof url==='string'&&url.length<=MAX_URL&&url.startsWith('/assets/journal/')&&!url.includes('..'));
+  return [...new Set(urls)];
+}
+
+export async function GET(){
+  const session=await getSession();
+  if(!session)return NextResponse.json({error:'Unauthorized'},{status:401});
+  try {
+    return NextResponse.json({favorites:sanitize(JSON.parse(await fs.readFile(file(session.id),'utf8')))});
+  }catch(error){
+    if((error as NodeJS.ErrnoException).code==='ENOENT')return NextResponse.json({favorites:[]});
+    return NextResponse.json({error:'Favoriten nicht verfügbar'},{status:503});
+  }
+}
+
+export async function PUT(request:Request){
+  const session=await getSession();
+  if(!session)return NextResponse.json({error:'Unauthorized'},{status:401});
+  try {
+    const favorites=sanitize(await boundedJson(request,256*1024));
+    const lock='journal-favorites-'+createHash('sha256').update(session.id).digest('hex');
+    await store.lock(lock,async()=>store.atomic(file(session.id),{favorites}));
+    return NextResponse.json({favorites});
+  }catch{
+    return NextResponse.json({error:'Favoriten konnten nicht gespeichert werden'},{status:400});
+  }
+}
