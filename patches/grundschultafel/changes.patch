+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { JOURNAL_FOLDERS, cardName, inFolder, legacyFolder, type JournalCard, type JournalLibrary } from './journalCatalog';
+
+const validSegment = (name: string) => /^[\p{L}\p{N}][\p{L}\p{N}_. -]{0,127}$/u.test(name);
+const imageFile = (name: string) => /\.(png|jpe?g|gif|svg|webp)$/i.test(name);
+const sourceFile = (name: string) => /\.(png|jpe?g)$/i.test(name);
+const withoutExtension = (name: string) => name.replace(/\.[^.]+$/, '').toLocaleLowerCase('de');
+
+export async function readJournalLibrary(root: string): Promise<JournalLibrary> {
+  const cards: JournalCard[] = [];
+  const folders = new Map(JOURNAL_FOLDERS.map(folder => [folder.id, { ...folder, count: 0 }]));
+
+  async function visit(parts: string[]) {
+    let entries;
+    try {
+      entries = await fs.readdir(path.join(root, ...parts), { withFileTypes: true });
+    } catch (error) {
+      if (parts.length === 0 && (error as NodeJS.ErrnoException).code === 'ENOENT') return;
+      throw error;
+    }
+    entries.sort((a, b) => a.name.localeCompare(b.name, 'de', { numeric: true }));
+    // scripts/optimize-journal-images.cjs writes a small WebP twin next to every
+    // large PNG/JPEG original. Offer only the twin, so the originals may stay in
+    // the folder (untracked) without the card appearing twice.
+    const optimized = new Set(entries
+      .filter(entry => entry.isFile() && /\.webp$/i.test(entry.name) && validSegment(entry.name))
+      .map(entry => withoutExtension(entry.name)));
+    for (const entry of entries) {
+      // Match the asset endpoint's URL segments. Never follow symlinks, which
+      // could escape the library or create directory loops.
+      if (!validSegment(entry.name)) continue;
+      if (entry.isDirectory()) {
+        const nested = [...parts, entry.name];
+        const id = nested.join('/');
+        if (!folders.has(id)) folders.set(id, { id, label: entry.name.replace(/[_-]+/g, ' '), count: 0 });
+        await visit(nested);
+      } else if (entry.isFile() && imageFile(entry.name)) {
+        if (sourceFile(entry.name) && optimized.has(withoutExtension(entry.name))) continue;
+        const folder = parts.length ? parts.join('/') : legacyFolder(entry.name);
+        if (!folders.has(folder)) folders.set(folder, { id: folder, label: 'Weitere Karten', count: 0 });
+        cards.push({
+          url: `/assets/journal/${[...parts, entry.name].map(encodeURIComponent).join('/')}`,
+          name: cardName(entry.name), folder,
+        });
+      }
+    }
+  }
+
+  await visit([]);
+  cards.sort((a, b) => a.name.localeCompare(b.name, 'de', { numeric: true }));
+  for (const folder of folders.values()) folder.count = cards.filter(card => inFolder(card.folder, folder.id)).length;
+  return { images: cards.map(card => card.url), cards, folders: [...folders.values()] };
+}
