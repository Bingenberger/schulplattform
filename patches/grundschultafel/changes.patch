diff --git a/scripts/optimize-journal-images.cjs b/scripts/optimize-journal-images.cjs
new file mode 100644
index 0000000..2eaaad4
--- /dev/null
+++ b/scripts/optimize-journal-images.cjs
@@ -0,0 +1,94 @@
+// Shrinks the journal cards for the repository: every PNG/JPEG below
+// public/assets/journal gets a small WebP twin next to it. The library reader
+// prefers that twin, so the large originals can stay in place while only the
+// WebP cards are committed (see .gitignore and docs/journal-bildgroessen.md).
+// Cards are never displayed wider than ~184 px, so 768 px stays generous.
+const fs = require('node:fs');
+const path = require('node:path');
+const crypto = require('node:crypto');
+
+const SOURCES = /\.(png|jpe?g)$/i;
+const DEFAULTS = { width: 768, quality: 80, root: path.resolve(__dirname, '..', 'public', 'assets', 'journal') };
+const LARGE_WEBP = 400 * 1024; // hand-made cards above this only get a warning
+
+function options(argv) {
+  const config = { ...DEFAULTS, force: false, dryRun: false };
+  for (let i = 0; i < argv.length; i++) {
+    const [flag, inline] = argv[i].split('=');
+    const value = () => (inline !== undefined ? inline : argv[++i]);
+    if (flag === '--force') config.force = true;
+    else if (flag === '--dry-run') config.dryRun = true;
+    else if (flag === '--width') config.width = Number(value());
+    else if (flag === '--quality') config.quality = Number(value());
+    else if (flag === '--root') config.root = path.resolve(value());
+    else throw new Error(`Unbekannte Option: ${argv[i]}`);
+  }
+  if (!Number.isInteger(config.width) || config.width < 64 || config.width > 4096) throw new Error('--width benötigt 64…4096');
+  if (!Number.isInteger(config.quality) || config.quality < 1 || config.quality > 100) throw new Error('--quality benötigt 1…100');
+  return config;
+}
+
+// Never follow symlinks, mirroring src/lib/journalLibrary.ts.
+function* walk(dir) {
+  for (const entry of fs.readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name, 'de'))) {
+    const file = path.join(dir, entry.name);
+    if (entry.isDirectory()) yield* walk(file);
+    else if (entry.isFile()) yield file;
+  }
+}
+
+async function main() {
+  const config = options(process.argv.slice(2));
+  if (!fs.existsSync(config.root)) throw new Error(`Bildordner fehlt: ${config.root}`);
+  const sharp = require('sharp');
+
+  const files = [...walk(config.root)];
+  const sources = files.filter(file => SOURCES.test(file));
+  const report = { converted: 0, current: 0, originals: 0, optimized: 0, failed: [] };
+
+  for (const source of sources) {
+    const target = source.replace(SOURCES, '.webp');
+    const sourceStat = fs.statSync(source);
+    report.originals += sourceStat.size;
+    const targetStat = fs.existsSync(target) ? fs.statSync(target) : null;
+    if (targetStat && !config.force && targetStat.mtimeMs >= sourceStat.mtimeMs) {
+      report.current++;
+      report.optimized += targetStat.size;
+      continue;
+    }
+    const relative = path.relative(config.root, source);
+    if (config.dryRun) {
+      console.log(`  würde erzeugen: ${relative.replace(SOURCES, '.webp')}`);
+      report.converted++;
+      continue;
+    }
+    try {
+      const buffer = await sharp(source)
+        .resize({ width: config.width, withoutEnlargement: true })
+        .webp({ quality: config.quality, effort: 6 })
+        .toBuffer();
+      const temporary = `${target}.${crypto.randomUUID()}.tmp`;
+      fs.writeFileSync(temporary, buffer);
+      fs.renameSync(temporary, target);
+      report.converted++;
+      report.optimized += buffer.length;
+      console.log(`  ${relative} → ${(sourceStat.size / 1024 / 1024).toFixed(2)} MB auf ${(buffer.length / 1024).toFixed(0)} KB`);
+    } catch (error) {
+      report.failed.push(`${relative}: ${error.message}`);
+    }
+  }
+
+  const large = files.filter(file => /\.webp$/i.test(file) && !sources.some(source => source.replace(SOURCES, '.webp') === file))
+    .filter(file => fs.statSync(file).size > LARGE_WEBP);
+
+  const mb = bytes => `${(bytes / 1024 / 1024).toFixed(1)} MB`;
+  console.log(`\n${sources.length} Originale (${mb(report.originals)}) → ${mb(report.optimized)} als WebP`);
+  console.log(`${report.converted} erzeugt, ${report.current} bereits aktuell, Breite ${config.width} px, Qualität ${config.quality}`);
+  if (large.length) console.log(`Hinweis: ${large.length} eigene WebP-Karte(n) über ${LARGE_WEBP / 1024} KB:\n  ${large.map(file => path.relative(config.root, file)).join('\n  ')}`);
+  if (report.failed.length) {
+    console.error(`\nFehlgeschlagen:\n  ${report.failed.join('\n  ')}`);
+    process.exitCode = 1;
+  }
+}
+
+main().catch(error => { console.error(error.message); process.exit(1); });
