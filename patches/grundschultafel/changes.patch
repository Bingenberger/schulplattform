@@ -0,0 +1,20 @@
+# Lokaler Erstzugang
+
+Ein HTTP-Aufruf legt keinen Standardadministrator mehr an. Auf einer neuen
+Installation lokal `node scripts/bootstrap.mjs PERSOENLICHER_NAME` ausführen.
+Der zufällige Code erscheint ausschließlich auf dem kontrollierenden Terminal,
+gilt 15 Minuten und kann nur für eine erfolgreiche Anmeldung verwendet werden.
+Die normale Anmeldung bietet dafür „Erstzugang mit Einmalcode“. Beim anschließenden
+PIN-Wechsel denselben Code unter dieser Option eingeben und eine eigene PIN setzen.
+
+Bestehende Nutzerdateien werden nicht überschrieben. Nach Verbrauch/Verlust des
+Codes ohne abgeschlossenen PIN-Wechsel ist eine lokale administrative Wiederherstellung
+erforderlich; es gibt keinen offenen HTTP-Neustart des Bootstrapverfahrens.
+Vorhandene Konten und Daten-IDs bleiben erhalten. Bereits vorhandene alte Standardkonten
+werden nicht automatisch gelöscht oder verändert; sie müssen individuell geprüft werden.
+
+`users.json` wird mit privaten Rechten atomar ersetzt. Das verhindert halbe Dateien,
+ersetzt aber noch keine Transaktion für konkurrierende vollständige Nutzerlisten.
+Die Gerätebindung der 30-Tage-Sitzung ist noch nicht umgesetzt.
+
+Tests: `node scripts/test-users.cjs`; `node node_modules/typescript/bin/tsc --noEmit`.
diff --git a/scripts/bootstrap.mjs b/scripts/bootstrap.mjs
new file mode 100644
index 0000000..6a5581f
--- /dev/null
+++ b/scripts/bootstrap.mjs
@@ -0,0 +1,24 @@
+// Run locally: node scripts/bootstrap.mjs PERSONAL_USERNAME
+// Refuses existing installations. Secret is written only to the controlling TTY.
+import fs from 'node:fs';
+import crypto from 'node:crypto';
+import path from 'node:path';
+import bcrypt from 'bcryptjs';
+
+const username = process.argv[2];
+if (!username || !/^[\p{L}\p{N}_.@-]{3,80}$/u.test(username)) {
+  throw new Error('Specify a personal username (3–80 characters).');
+}
+const tty = fs.openSync('/dev/tty', 'w');
+const directory = path.join(process.cwd(), 'data');
+fs.mkdirSync(directory, { recursive: true, mode: 0o700 });
+const token = crypto.randomBytes(24).toString('base64url');
+const user = { id: crypto.randomUUID(), username, role: 'admin',
+  passwordHash: await bcrypt.hash(token, 10), createdAt: new Date().toISOString(),
+  mustChangePassword: true, bootstrapExpiresAt: Date.now() + 15 * 60 * 1000 };
+const destination = path.join(directory, 'users.json');
+const temporary = `${destination}.${crypto.randomUUID()}.tmp`;
+fs.writeFileSync(temporary, JSON.stringify([user]), { mode: 0o600, flag: 'wx' });
+try { fs.linkSync(temporary, destination); } finally { fs.unlinkSync(temporary); }
+fs.writeSync(tty, `Initial login for ${username}; valid for 15 minutes:\n${token}\nChange it immediately after login.\n`);
+fs.closeSync(tty);
diff --git a/scripts/test-users.cjs b/scripts/test-users.cjs
new file mode 100644
index 0000000..a329320
--- /dev/null
+++ b/scripts/test-users.cjs
@@ -0,0 +1,38 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const Module = require('node:module');
+const ts = require('typescript');
+const source = path.resolve(__dirname, '../src/lib/users.ts');
+const compiled = ts.transpileModule(fs.readFileSync(source, 'utf8'), {
+  compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, esModuleInterop: true },
+}).outputText;
+const temporary = fs.mkdtempSync(path.join(os.tmpdir(), 'tafel-users-test-'));
+const original = process.cwd();
+process.chdir(temporary);
+const loaded = new Module(source, module);
+loaded.filename = source;
+loaded.paths = Module._nodeModulePaths(path.dirname(source));
+loaded._compile(compiled, source);
+const users = loaded.exports;
+(async () => {
+  try {
+    assert.deepEqual(await users.getUsers(), []);
+    assert.equal(fs.existsSync('data/users.json'), false, 'anonymous read must not bootstrap');
+    const user = { id: 'synthetic-1', username: 'synthetic', passwordHash: 'synthetic',
+      role: 'admin', createdAt: new Date().toISOString(), bootstrapExpiresAt: Date.now() + 60000 };
+    await users.saveUsers([user]);
+    const results = await Promise.all([users.consumeBootstrap(user), users.consumeBootstrap(user)]);
+    assert.equal(results.filter(Boolean).length, 1, 'bootstrap is single-use under concurrency');
+    assert.equal(await users.consumeBootstrap({ ...user, id: 'expired', bootstrapExpiresAt: 0 }), false);
+    assert.equal((fs.statSync('data/users.json').mode & 0o777), 0o600);
+    assert.deepEqual(await users.getUsers(), [user]);
+    fs.writeFileSync('data/users.json', '{invalid');
+    await assert.rejects(users.getUsers(), SyntaxError, 'corruption must not become an empty user list');
+    console.log('PASS: no default account, single-use/expired bootstrap, private atomic file, corrupt store rejected');
+  } finally {
+    process.chdir(original);
+    fs.rmSync(temporary, { recursive: true });
+  }
+})().catch(error => { console.error(error); process.exitCode = 1; });
