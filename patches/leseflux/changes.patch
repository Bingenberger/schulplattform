diff --git a/Dockerfile b/Dockerfile
new file mode 100644
index 0000000..43033b2
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,37 @@
+FROM node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS dependencies
+ENV npm_config_cache=/tmp/npm-cache NEXT_TELEMETRY_DISABLED=1
+WORKDIR /build
+RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
+COPY package.json package-lock.json ./
+COPY apps/api/package.json ./apps/api/
+COPY apps/web/package.json ./apps/web/
+COPY packages/shared/package.json ./packages/shared/
+RUN npm ci --no-audit --no-fund && rm -rf /tmp/npm-cache
+
+FROM dependencies AS builder
+COPY tsconfig.base.json ./
+COPY packages/shared ./packages/shared
+COPY apps/api ./apps/api
+COPY apps/web ./apps/web
+RUN DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build ./node_modules/.bin/prisma generate --schema apps/api/prisma/schema.prisma
+RUN npm run build && npm run typecheck -w apps/api
+
+FROM builder AS tests
+COPY contract_tests ./contract_tests
+USER 10001:10001
+
+FROM node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS runtime
+ENV NODE_ENV=production PORT=3001 HOST=0.0.0.0 WEB_ROOT=/app/web PRISMA_MIGRATIONS=/app/prisma/migrations
+WORKDIR /app
+RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/* \
+ && groupadd --gid 10001 leseflux && useradd --uid 10001 --gid 10001 --no-create-home leseflux
+COPY --from=builder /build/node_modules ./node_modules
+COPY --from=builder /build/apps/api/dist ./dist
+COPY --from=builder /build/apps/web/dist ./web
+COPY apps/api/prisma ./prisma
+COPY scripts ./scripts
+COPY packages/text ./packages/text
+USER 10001:10001
+EXPOSE 3001
+HEALTHCHECK --interval=5s --timeout=3s --retries=12 CMD node -e "fetch('http://127.0.0.1:3001/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
+CMD ["node","dist/src/server.js"]
diff --git a/PLATFORM.md b/PLATFORM.md
new file mode 100644
index 0000000..de148da
--- /dev/null
+++ b/PLATFORM.md
@@ -0,0 +1,92 @@
+# Leseflux: lokaler Betrieb
+
+Der eigenständige Compose-Stack startet PostgreSQL und einen Appcontainer für API
+und gebaute Weboberfläche. Node 22.23.4, Prisma 5.22.0 und Fastify 5.8.5 sind im
+geprüften amd64-Image enthalten. Die npm-Workspaces bleiben für die Entwicklung
+erhalten. Die Dockerfiles unter apps/api und apps/web sind kompatible Baupfade
+für denselben kombinierten Container und werden aus dem Repositorywurzel gebaut.
+
+## Erstinstallation
+
+Mit Docker Engine und Compose v2, aus dem Repositorywurzel:
+
+```sh
+python3 prepare_secrets.py
+export LESEFLUX_SECRETS_DIR="$PWD/.private"
+export CORS_ORIGIN=http://localhost:3001
+export COOKIE_SECURE=false
+docker compose build app
+docker compose up -d --wait postgres
+docker compose run --rm --no-deps app node scripts/platform-migrate.cjs
+docker compose run --rm --no-deps app node scripts/content.cjs
+docker compose run --rm --no-deps app node scripts/setup-admin.cjs admin@example.org "Persönlicher Name"
+docker compose up -d --wait app
+```
+
+Die lokale Erstadministration benötigt ein echtes interaktives Terminal und fragt
+das Passwort verdeckt zweimal ab. Bei vorhandenen Nutzern wird sie abgewiesen.
+Keine Standardkonten, ausgegebenen Passwörter oder automatisch gestarteten Seeds.
+content.cjs ergänzt Lernmaterial, überschreibt keine bearbeiteten Vorlagen und
+legt keine Benutzer an. Migrationen sind explizite Jobs; normale Starts führen
+weder Migration noch Inhaltsimport aus. Readiness prüft alle Migrationsnamen und
+SQL-Prüfsummen, Liveness bleibt bei Datenbankausfall verfügbar.
+
+prepare_secrets.py legt ausschließlich ein neues Verzeichnis .private (0700) an.
+Die einzelnen Dateien sind innerhalb dieses privaten Elternverzeichnisses für
+Container lesbar. Sicherung und spätere Rotation gehören zum Betreiberprozess.
+DATABASE_URL und JWT_SECRET bleiben für Entwicklung unterstützt; alternativ
+DATABASE_URL_FILE und JWT_SECRET_FILE verwenden, nie beide Varianten gleichzeitig.
+Compose projiziert nur einzelne Dateien und veröffentlicht keinen PostgreSQL-Port.
+Die App läuft mit UID 10001, schreibgeschütztem Rootdateisystem und begrenzten
+Ressourcen. Kapazität auf dem Zielserver ist noch nicht gemessen.
+
+Für HTTPS: CORS_ORIGIN auf genau die externe Origin setzen, COOKIE_SECURE=true,
+TRUSTED_PROXY_IPS auf die tatsächlichen Proxyadressen begrenzen. CORS_ORIGIN ist
+Laufzeitkonfiguration; das Frontend verwendet relative API-Pfade. Standalone bindet
+nur 127.0.0.1:3001. Öffentliches TLS benötigt einen separat betriebenen Proxy.
+Alte nginx-Dateien sind keine automatisch aktivierte Produktionskonfiguration.
+
+## Anmeldung und Daten
+
+Lehrkräfte melden sich persönlich per E-Mail und Passwort an. Kinder behalten
+QR- und Kurzcode-Anmeldung. Druckkarten enthalten den Kurzcode ohne Domain.
+Anton-Inhalte werden ausschließlich als undurchsichtiger lokaler Zugang verwendet;
+es besteht keine Verbindung zu Anton-Servern.
+
+JWTs werden ausschließlich als HttpOnly-/SameSite-Strict-Cookie ausgegeben und
+nicht in Response-Body oder LocalStorage gespeichert. PostgreSQL hält den Hash
+der zufälligen Sitzungskennung, Ablaufdatum und einen Credential-Fingerabdruck.
+Maximal 20 Sitzungen pro Person, 8 Stunden für Lehrkräfte und 24 für Kinder.
+Logout, Passwort-/QR-/Codewechsel und Kontolöschung widerrufen Sitzungen.
+Alle schreibenden API-Aufrufe benötigen X-Leseflux-Request: 1; vorhandene
+Origin-Header müssen exakt CORS_ORIGIN entsprechen. Das Webfrontend setzt den
+Header. Externe Clients müssen diese Änderung übernehmen.
+
+Neu erzeugte QR-Werte werden nur als Hash gespeichert, einmalig beim Anlegen/
+Rotieren zurückgegeben und nicht ins Audit übernommen. Bereits vorhandene
+qrTokenRaw- und Auditwerte werden nicht still gelöscht oder Karten rotiert.
+API-Projektionen geben alte Rohwerte und Passwort-Hashes nicht heraus.
+Vor einer Übernahme realer Altdaten müssen Schutz und Bereinigung dieser
+historischen Werte gesondert geprüft werden. Einwilligungszeitpunkt ist bei
+Einzelanlage und Import Pflicht und wird im Audit festgehalten. Importziele
+unterliegen der Klassenbesitzprüfung.
+
+Google-Font-Aufrufe wurden entfernt; Systemschriften dienen als Fallback.
+Fehlende optionale OpenDyslexic-Dateien werden nicht aus dem Netz nachgeladen.
+Die Rechteprüfung vorhandener Grundschrift-/Unterrichtsdateien bleibt offen;
+diese Änderungen erteilen keine Lizenz und veröffentlichen keine Images.
+
+## Sicherung und Prüfgrenzen
+
+Für einen konsistenten Fachstand zuerst App-Schreibprozesse stoppen, PostgreSQL
+weiter betreiben, pg_dump im Custom-Format sichern und Prüfsumme kontrollieren.
+Private DB-/JWT-Dateien separat schützen. In eine frische, leere Datenbank mit
+denselben Rollen wiederherstellen; kein Seed oder Migrationsjob beim Restore.
+Die gebauten statischen Dateien liegen im Image, keine Laufzeit-Uploads.
+
+Im Plattformrepository liegen reproduzierbare Standalone-, PostgreSQL-Restore-,
+Browser-, Domain-/Lebenszyklus- und Sitzungstests. Verwendet wurden ausschließlich
+synthetische Konten. Der Browsernachweis betrifft Lehrkraft-/Kinder-Code-Anmeldung,
+Cookie-/LocalStorage-Verhalten und fehlende Drittanfragen; Kamerascans und
+vollständige visuelle Unterrichtsabnahme sind noch offen. Keine Ubuntu-, öffentliche
+DNS-/ACME-, Offsite-, Lizenz- oder Lastabnahme.
