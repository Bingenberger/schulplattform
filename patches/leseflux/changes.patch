diff --git a/scripts/setup-admin.cjs b/scripts/setup-admin.cjs
new file mode 100644
index 0000000..a981e37
--- /dev/null
+++ b/scripts/setup-admin.cjs
@@ -0,0 +1,42 @@
+const fs=require('node:fs');
+const tty=require('node:tty');
+const {load}=require('./credentials.cjs');
+async function password(fd,label) {
+ fs.writeSync(fd,label);
+ const input=new tty.ReadStream(fd);
+ input.setRawMode(true);input.resume();
+ let value='';
+ return new Promise((resolve,reject)=>{
+  const receive=chunk=>{
+   for(const character of chunk.toString()) {
+    if(character==='\u0003'){finish();reject(new Error('Cancelled'));return;}
+    if(character==='\r'||character==='\n'){finish();resolve(value);return;}
+    if(character==='\u007f'||character==='\b')value=value.slice(0,-1);
+    else if(value.length<128&&character>=' ')value+=character;
+   }
+  };
+  function finish(){input.off('data',receive);input.setRawMode(false);input.pause();fs.writeSync(fd,'\n');}
+  input.on('data',receive);
+ });
+}
+async function main(){
+ const fd=fs.openSync('/dev/tty','r+');
+ load(['DATABASE_URL']);
+ const email=process.argv[2],displayName=process.argv[3];
+ if(!email||email.length>254||!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)||!displayName||displayName.length>80)throw new Error('Personal identity required');
+ const first=await password(fd,'Neues persönliches Passwort (mindestens 12 Zeichen): ');
+ const confirmation=await password(fd,'Wiederholen: ');
+ if(first.length<12||first!==confirmation)throw new Error('Password mismatch');
+ const {PrismaClient}=require('@prisma/client'),argon2=require('argon2');
+ const prisma=new PrismaClient({log:[]});
+ try{
+  const hash=await argon2.hash(first);
+  await prisma.$transaction(async tx=>{
+   await tx.$executeRawUnsafe('SELECT pg_advisory_xact_lock(76401982)');
+   if(await tx.user.count())throw new Error('Existing accounts preserved');
+   await tx.user.create({data:{email,displayName,role:'ADMIN',passwordHash:hash}});
+  });
+  fs.writeSync(fd,'Persönlicher Erstadmin angelegt.\n');
+ }finally{await prisma.$disconnect();fs.closeSync(fd);}
+}
+main().catch(()=>{console.error('Local setup failed; terminal, personal identity, migration and existing accounts must be checked.');process.exitCode=1;});
