@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { PrismaClient } from '@prisma/client'
+import { issue,verify,revoke } from '../apps/api/src/lib/sessions'
+process.env.DATABASE_URL=readFileSync('/run/secrets/database-url','utf8').trim()
+const p=new PrismaClient({log:[]})
+async function main() {
+ const user=await p.user.create({data:{role:'TEACHER',displayName:'Synthetic session contract',passwordHash:'fixture-only-hash'}})
+ try {
+  const results=await Promise.allSettled(Array.from({length:24},()=>issue(p,user)))
+  const successful=results.filter((r):r is PromiseFulfilledResult<{sid:string,seconds:number}>=>r.status==='fulfilled')
+  assert.equal(successful.length,20)
+  assert.equal(await p.authSession.count({where:{userId:user.id}}),20)
+  const first=successful[0]!.value
+  assert.equal((await verify(p,first.sid,user.id))?.id,user.id)
+  const rows=await p.authSession.findMany({where:{userId:user.id}})
+  assert.equal(JSON.stringify(rows).includes(first.sid),false)
+  await p.authSession.updateMany({where:{userId:user.id},data:{expiresAt:new Date(0)}})
+  assert.equal(await verify(p,first.sid,user.id),null)
+  const renewed=await issue(p,user)
+  assert.equal(await p.authSession.count({where:{userId:user.id}}),1)
+  await revoke(p,renewed.sid)
+  assert.equal(await verify(p,renewed.sid,user.id),null)
+  assert.equal(await verify(p,undefined,user.id),null)
+  console.log('PASS: 24 concurrent session reservations yield 20 slots, hash-only records, expiry, reclamation, revoke and missing SID denied')
+ }finally{await p.user.delete({where:{id:user.id}})}
+}
+main().finally(()=>p.$disconnect()).catch(()=>{console.error('Session contract failed; private fixture requires inspection');process.exitCode=1})
