--- /dev/null
+++ b/apps/api/src/lib/static.ts
@@ -0,0 +1,26 @@
+import { realpath,stat } from 'node:fs/promises'
+import { createReadStream } from 'node:fs'
+import { resolve,extname,sep } from 'node:path'
+import type { FastifyInstance } from 'fastify'
+const types:Record<string,string>={'.html':'text/html; charset=utf-8','.js':'text/javascript; charset=utf-8',
+  '.css':'text/css; charset=utf-8','.svg':'image/svg+xml','.png':'image/png','.ico':'image/x-icon',
+  '.woff2':'font/woff2','.woff':'font/woff','.otf':'font/otf','.ttf':'font/ttf','.txt':'text/plain; charset=utf-8'}
+export function staticRoutes(app:FastifyInstance) {
+  app.get('/*',async(request,reply)=>{
+    const pathname=request.url.split('?')[0]||'/'
+    if(pathname.startsWith('/api/'))return reply.code(404).send({error:'Nicht gefunden'})
+    try{
+      const root=await realpath(resolve(process.env.WEB_ROOT||'web')),decoded=decodeURIComponent(pathname)
+      if(decoded.length>2048||decoded.includes('\\')||decoded.includes('\0')||decoded.split('/').some(p=>p==='..'||p.startsWith('.')))
+        return reply.code(404).send()
+      let target=resolve(root,'.'+decoded)
+      try{if(!(await stat(target)).isFile())target=resolve(root,'index.html')}
+      catch{if(extname(decoded))return reply.code(404).send();target=resolve(root,'index.html')}
+      target=await realpath(target)
+      const metadata=await stat(target),type=types[extname(target)]
+      if(!target.startsWith(root+sep)||!type||!metadata.isFile()||metadata.size>32*1024*1024)return reply.code(404).send()
+      reply.header('Cache-Control',pathname.startsWith('/assets/')?'public, max-age=31536000, immutable':'no-store')
+      return reply.type(type).send(createReadStream(target))
+    }catch{return reply.code(503).send({error:'Oberfläche derzeit nicht verfügbar'})}
+  })
+}
