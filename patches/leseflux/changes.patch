@@ -0,0 +1,12 @@
+"""Create private one-time local credentials without printing their contents."""
+from pathlib import Path
+import os,secrets
+os.umask(0o077)
+directory=Path(".private");directory.mkdir(mode=0o700)
+password=secrets.token_hex(32)
+values={"db-admin":secrets.token_hex(32),"db-app":password,"jwt-key":secrets.token_urlsafe(48),
+ "database-url":"postgresql://leseflux:"+password+"@postgres:5432/leseflux?connection_limit=5&pool_timeout=3&connect_timeout=3"}
+for name,value in values.items():
+ fd=os.open(directory/name,os.O_CREAT|os.O_EXCL|os.O_WRONLY,0o444)
+ with os.fdopen(fd,"w") as stream:stream.write(value)
+print("Private credentials created. Set LESEFLUX_SECRETS_DIR to absolute .private path.")
