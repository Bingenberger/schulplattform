new file mode 100644
index 0000000..93444d4
--- /dev/null
+++ b/apps/api/src/lib/platform.ts
@@ -0,0 +1,39 @@
+import { readFileSync, readdirSync } from 'node:fs'
+import { resolve, join } from 'node:path'
+import { createHash } from 'node:crypto'
+import type { PrismaClient } from '@prisma/client'
+export function privateValue(name:string) {
+  const direct=process.env[name],file=process.env[name+'_FILE']
+  if(direct&&file)throw new Error('Configure one credential source')
+  return file?readFileSync(file,'utf8').trim():direct
+}
+export function configure() {
+  const secret=privateValue('JWT_SECRET'),database=privateValue('DATABASE_URL')
+  if(!secret||secret.length<32||!database)throw new Error('Private credentials required')
+  process.env.JWT_SECRET=secret;process.env.DATABASE_URL=database;publicOrigin()
+}
+export function publicOrigin() {
+  const origin=new URL(process.env.CORS_ORIGIN||'http://localhost:3001')
+  if(!['http:','https:'].includes(origin.protocol)||origin.username||origin.password||origin.pathname!=='/'||origin.search||origin.hash)
+    throw new Error('Public origin required')
+  return origin.origin
+}
+export const digest=(value:string)=>createHash('sha256').update(value).digest('hex')
+export function credentialVersion(user:{role:string,passwordHash:string|null,qrTokenHash:string|null,loginCode:string|null}) {
+  return digest(JSON.stringify([user.role,user.passwordHash,user.qrTokenHash,user.loginCode]))
+}
+export function expectedMigrations() {
+  const root=resolve(process.env.PRISMA_MIGRATIONS||'prisma/migrations')
+  return readdirSync(root,{withFileTypes:true}).filter(item=>item.isDirectory()).map(item=>({
+    name:item.name,checksum:digest(readFileSync(join(root,item.name,'migration.sql'),'utf8')),
+  })).sort((a,b)=>a.name.localeCompare(b.name))
+}
+export async function ready(prisma:PrismaClient) {
+  try{
+    const rows=await prisma.$queryRawUnsafe<{migration_name:string,checksum:string,finished_at:Date|null,rolled_back_at:Date|null}[]>(
+      'SELECT migration_name,checksum,finished_at,rolled_back_at FROM "_prisma_migrations"')
+    const active=rows.filter(row=>!row.rolled_back_at),expected=expectedMigrations()
+    return active.length===expected.length&&expected.every(row=>active.some(item=>
+      item.migration_name===row.name&&item.checksum===row.checksum&&item.finished_at!==null))
+  }catch{return false}
+}
diff --git a/apps/api/src/lib/sessions.ts b/apps/api/src/lib/sessions.ts
new file mode 100644
index 0000000..da520f6
--- /dev/null
+++ b/apps/api/src/lib/sessions.ts
@@ -0,0 +1,26 @@
+import { randomBytes } from 'node:crypto'
+import type { PrismaClient,User } from '@prisma/client'
+import { credentialVersion,digest } from './platform.js'
+export async function issue(prisma:PrismaClient,user:User) {
+  return prisma.$transaction(async tx=>{
+    await tx.$executeRawUnsafe('SELECT pg_advisory_xact_lock(hashtextextended($1,0))',user.id)
+    const current=await tx.user.findUnique({where:{id:user.id}})
+    if(!current||credentialVersion(current)!==credentialVersion(user))throw new Error('Credential changed')
+    await tx.authSession.deleteMany({where:{userId:user.id,expiresAt:{lte:new Date()}}})
+    if(await tx.authSession.count({where:{userId:user.id}})>=20)throw new Error('Session slots busy')
+    const sid=randomBytes(32).toString('base64url'),seconds=user.role==='CHILD'?86400:28800
+    await tx.authSession.create({data:{idHash:digest(sid),userId:user.id,version:credentialVersion(current),
+      expiresAt:new Date(Date.now()+seconds*1000)}})
+    return {sid,seconds}
+  })
+}
+export async function verify(prisma:PrismaClient,sid:unknown,userId:string) {
+  if(typeof sid!=='string'||!/^[A-Za-z0-9_-]{43}$/.test(sid))return null
+  const row=await prisma.authSession.findUnique({where:{idHash:digest(sid)},include:{user:true}})
+  if(!row||row.userId!==userId||row.expiresAt<=new Date()||row.version!==credentialVersion(row.user))return null
+  return row.user
+}
+export async function revoke(prisma:PrismaClient,sid:unknown) {
+  if(typeof sid==='string'&&/^[A-Za-z0-9_-]{43}$/.test(sid))
+    await prisma.authSession.deleteMany({where:{idHash:digest(sid)}})
+}
