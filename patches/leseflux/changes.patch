@@ -0,0 +1,12 @@
+const fs=require('node:fs');
+function load(names=['DATABASE_URL','JWT_SECRET']) {
+ process.umask(0o077);
+ for(const name of names) {
+  const direct=process.env[name],file=process.env[name+'_FILE'];
+  if(direct&&file)throw new Error('Configure one credential source');
+  const value=file?fs.readFileSync(file,'utf8').trim():direct;
+  if(!value||(name==='JWT_SECRET'&&value.length<32))throw new Error('Private credential required');
+  process.env[name]=value;
+ }
+}
+module.exports={load};
