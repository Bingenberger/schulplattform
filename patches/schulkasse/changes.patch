+def test_jahresendmitteilung_zusammensetzung(daten, admin_id):
+    from schulkasse import anfangsbestand as ab
+    from schulkasse.jahresende import jahresendmitteilung
+    v = jahresendmitteilung(daten, "2026-12-31")
