+{% extends "base.html" %}
+{% from "macros.html" import csrf %}
+{% block title %}Kontoauszüge{% endblock %}
+{% block content %}
+<div class="kopfzeile">
+  <h1>{{ icon('files') }} Kontoauszüge &amp; Überwachungslisten</h1>
+  {% if konto and auszuege %}
+  <div class="aktionen">
+    <a class="knopf zweit" href="{{ url_for('kontoauszuege.sammel_pdf', konto=konto.id, jahr=jahr or '') }}">{{ icon('file-pdf') }} Alle Listen{{ ' ' ~ jahr if jahr }} als PDF</a>
+    <a class="knopf zweit" href="{{ url_for('kontoauszuege.sammel_xlsx', konto=konto.id, jahr=jahr or '') }}">{{ icon('microsoft-excel-logo') }} … als Excel</a>
+  </div>
+  {% endif %}
+</div>
+<p class="leise einleitung">Nach § 8 der Richtlinie Schulgirokonten ist für jeden Kontoauszug eines jeden Kontos eine
+  Überwachungsliste zu führen. Die CAMT-Dateien der Bank enthalten keine Auszugsnummern – erfassen Sie deshalb hier Nummer,
+  Zeitraum und Endsaldo jedes Kontoauszugs. Alle gebuchten Umsätze im Zeitraum gehören automatisch dazu.</p>
+
+{% if not konten %}
+<p class="hinweis">Es ist noch kein Bankkonto angelegt.</p>
+{% else %}
+<form class="filter" method="get">
+  <div class="feld"><label for="konto">Konto</label>
+    <select id="konto" name="konto" data-autosubmit>{% for k in konten %}<option value="{{ k.id }}" {% if k.id == konto_id %}selected{% endif %}>{{ k.bezeichnung }}{% if not k.aktiv %} (inaktiv){% endif %}</option>{% endfor %}</select></div>
+  <div class="feld"><label for="jahr">Jahr</label>
+    <select id="jahr" name="jahr" data-autosubmit><option value="">alle</option>{% for j in jahre %}<option value="{{ j }}" {% if j == jahr %}selected{% endif %}>{{ j }}</option>{% endfor %}</select></div>
+  <noscript><button type="submit">Anzeigen</button></noscript>
+</form>
+
+{% if konto and not konto.geldinstitut and aktueller_user.rolle == 'admin' %}
+<p class="hinweis info">{{ icon('info') }} Für den Kopf der Überwachungsliste fehlt noch das Geldinstitut. <a href="{{ url_for('verwaltung.konten', id=konto.id) }}">Im Konto eintragen</a></p>
+{% endif %}
+{% if ohne and ohne.anzahl %}
+<p class="hinweis">{{ icon('warning') }} {{ ohne.anzahl }} gebuchte Umsätze ab {{ ohne.erstes|datum }} liegen in keinem erfassten Kontoauszug.
+  Bitte die fehlenden Auszüge erfassen.</p>
+{% endif %}
+
+<div class="tabelle-wrap"><table class="liste-auszuege">
+  <thead><tr><th>Auszug</th><th>Zeitraum</th><th class="r">Umsätze</th><th class="r">Anfangssaldo</th><th class="r">Endsaldo berechnet</th>
+    <th class="r">Endsaldo lt. Auszug</th><th>Abgleich</th><th>Prüfung</th><th></th></tr></thead>
+  <tbody>
+  {% for x in auszuege %}{% set a = x.auszug %}
+  <tr>
+    <td><a class="stark" href="{{ url_for('kontoauszuege.detail', auszug_id=a.id) }}">Nr. {{ a.nummer }}/{{ a.jahr }}</a></td>
+    <td>{{ a.datum_von|datum }} – {{ a.datum_bis|datum }}</td>
+    <td class="r">{{ x.anzahl }}</td>
+    <td class="r">{{ x.anfang|euro }}</td>
+    <td class="r">{{ x.ende|euro }}</td>
+    <td class="r">{{ a.endsaldo_cent|euro if a.endsaldo_cent is not none else '–' }}</td>
+    <td>{% if x.fehler %}<span class="badge b-offen" title="{{ x.hinweise|map(attribute=1)|join(' ') }}">{{ icon('x-circle') }} Abweichung</span>
+      {% elif a.endsaldo_cent is none %}<span class="badge b-teilweise">{{ icon('hourglass') }} Endsaldo fehlt</span>
+      {% else %}<span class="badge b-erledigt">{{ icon('check-circle') }} stimmt</span>{% endif %}</td>
+    <td>{% if a.geprueft_am %}<span class="badge {{ 'b-offen' if x.geaendert else 'b-erledigt' }}">{{ icon('seal-check') }} {{ a.geprueft_von_name }}</span>
+      {% if x.geaendert %}<small class="fehlertext">seitdem geändert</small>{% endif %}
+      {% else %}<span class="badge">ungeprüft</span>{% endif %}</td>
+    <td class="aktionen-zelle">
+      <a class="knopf klein zweit" href="{{ url_for('kontoauszuege.detail', auszug_id=a.id) }}" title="Überwachungsliste ansehen">{{ icon('list-checks') }}<span class="sr">Ansehen</span></a>
+      <a class="knopf klein zweit" href="{{ url_for('kontoauszuege.detail', auszug_id=a.id, format='pdf') }}" title="Überwachungsliste als PDF">{{ icon('file-pdf') }}<span class="sr">PDF</span></a>
+    </td>
+  </tr>
+  {% else %}
+  <tr><td colspan="9" class="leer">{{ icon('tray') }} Noch keine Kontoauszüge erfasst.</td></tr>
+  {% endfor %}
+  </tbody>
+</table></div>
+
+<h2>{{ icon('plus-circle') }} Kontoauszug erfassen</h2>
+<form method="post" class="formular karte breit">
+  {{ csrf() }}<input type="hidden" name="konto" value="{{ konto_id }}">
+  <div class="zeile">
+    <div class="feld feld-klein"><label for="nummer">Auszug Nr.</label><input id="nummer" name="nummer" type="number" min="1" value="{{ vorschlag.nummer or '' }}" required></div>
+    <div class="feld"><label for="datum_von">Zeitraum von</label><input id="datum_von" type="date" name="datum_von" value="{{ vorschlag.datum_von or '' }}" required></div>
+    <div class="feld"><label for="datum_bis">bis</label><input id="datum_bis" type="date" name="datum_bis" value="{{ vorschlag.datum_bis or '' }}" required></div>
+    <div class="feld"><label for="endsaldo">Endsaldo laut Kontoauszug</label><input id="endsaldo" name="endsaldo" inputmode="decimal" placeholder="z. B. 1.234,56" value="{{ vorschlag.endsaldo or '' }}">
+      <span class="hilfe">Kann auch später nachgetragen werden.</span></div>
+  </div>
+  <div class="feld"><label for="notiz">Notiz (optional)</label><input id="notiz" name="notiz" maxlength="300" value="{{ vorschlag.notiz or '' }}"></div>
+  <p class="hilfe">Das Jahr ergibt sich aus dem Ende des Zeitraums. Die Auszugsnummer zählt bei den meisten Banken in jedem Jahr neu ab 1.</p>
+  <div><button type="submit">{{ icon('plus') }} Kontoauszug erfassen</button></div>
+</form>
+{% endif %}
+{% endblock %}
diff --git a/schulkasse/templates/kontoauszug_form.html b/schulkasse/templates/kontoauszug_form.html
new file mode 100644
index 0000000..c0f7639
--- /dev/null
+++ b/schulkasse/templates/kontoauszug_form.html
@@ -0,0 +1,29 @@
+{% extends "base.html" %}
+{% from "macros.html" import csrf %}
+{% block title %}Kontoauszug {{ a.nummer }}/{{ a.jahr }} bearbeiten{% endblock %}
+{% block content %}
+<p class="brotkrumen"><a href="{{ url_for('kontoauszuege.detail', auszug_id=a.id) }}">{{ icon('arrow-left') }} Zurück zur Überwachungsliste</a></p>
+<h1>{{ icon('pencil-simple') }} Kontoauszug {{ a.nummer }}/{{ a.jahr }} bearbeiten <small>{{ konto.bezeichnung }}</small></h1>
+{% if a.geprueft_am %}
+<p class="hinweis">{{ icon('lock') }} Dieser Kontoauszug ist als geprüft vermerkt und kann erst nach Aufheben der Prüfung geändert werden.</p>
+{% endif %}
+<form method="post" class="formular karte">
+  {{ csrf() }}
+  <div class="zeile">
+    <div class="feld feld-klein"><label for="nummer">Auszug Nr.</label><input id="nummer" name="nummer" type="number" min="1" value="{{ werte.nummer or '' }}" required></div>
+    <div class="feld"><label for="datum_von">Zeitraum von</label><input id="datum_von" type="date" name="datum_von" value="{{ werte.datum_von or '' }}" required></div>
+    <div class="feld"><label for="datum_bis">bis</label><input id="datum_bis" type="date" name="datum_bis" value="{{ werte.datum_bis or '' }}" required></div>
+  </div>
+  <div class="feld"><label for="endsaldo">Endsaldo laut Kontoauszug</label>
+    <input id="endsaldo" name="endsaldo" inputmode="decimal" value="{% if werte.endsaldo is defined %}{{ werte.endsaldo }}{% elif werte.endsaldo_cent is not none %}{{ format_cent(werte.endsaldo_cent, False) }}{% endif %}"></div>
+  <div class="feld"><label for="notiz">Notiz</label><input id="notiz" name="notiz" maxlength="300" value="{{ werte.notiz or '' }}"></div>
+  <div class="aktionen"><button type="submit" {% if a.geprueft_am %}disabled{% endif %}>{{ icon('floppy-disk') }} Speichern</button>
+    <a href="{{ url_for('kontoauszuege.detail', auszug_id=a.id) }}">Abbrechen</a></div>
+</form>
+{% if not a.geprueft_am %}
+<form method="post" action="{{ url_for('kontoauszuege.loeschen', auszug_id=a.id) }}" class="gefahrenzone">
+  {{ csrf() }}
+  <button type="submit" class="gefahr" data-confirm="Kontoauszug {{ a.nummer }}/{{ a.jahr }} wirklich löschen? Die Umsätze bleiben erhalten.">{{ icon('trash') }} Kontoauszug löschen</button>
+</form>
+{% endif %}
+{% endblock %}
diff --git a/schulkasse/templates/pdf/erinnerungszettel.html b/schulkasse/templates/pdf/erinnerungszettel.html
new file mode 100644
index 0000000..f053055
--- /dev/null
+++ b/schulkasse/templates/pdf/erinnerungszettel.html
@@ -0,0 +1,68 @@
+<!doctype html>
+<html lang="de">
+<head>
+<meta charset="utf-8">
+<title>Erinnerungszettel</title>
+{% set hoch = pro_seite == 4 %}
+<style>
+  @page { size: A4; margin: 0; }
+  body { margin: 0; font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; color: #111;
+    font-size: {{ '9pt' if hoch else '7.4pt' }}; line-height: 1.3; }
+  .seite { width: 210mm; height: 296mm; page-break-after: always; overflow: hidden; }
+  .seite:last-child { page-break-after: auto; }
+  .zettel { float: left; box-sizing: border-box; width: 104.9mm; height: {{ '148mm' if hoch else '74mm' }};
+    padding: {{ '9mm 9mm' if hoch else '5mm 6mm' }}; border-right: .4pt dashed #999; border-bottom: .4pt dashed #999;
+    overflow: hidden; position: relative; }
+  .zettel:nth-child(2n) { border-right: 0; }
+  .kopf { border-bottom: .6pt solid #1f5f8b; padding-bottom: 1mm; margin-bottom: {{ '3mm' if hoch else '1.6mm' }}; }
+  .kopf::after { content: ""; display: block; clear: both; }
+  .schule { float: left; font-weight: bold; color: #1f5f8b; max-width: 60mm; }
+  .schule img { max-height: {{ '10mm' if hoch else '6.5mm' }}; max-width: 40mm; }
+  .titel { float: right; font-weight: bold; text-transform: uppercase; letter-spacing: .06em; font-size: {{ '8pt' if hoch else '6.6pt' }};
+    color: #8a5300; background: #fff2d9; padding: .5mm 1.6mm; border-radius: 1mm; }
+  .an { margin-bottom: 1.2mm; }
+  .an b { font-size: {{ '11pt' if hoch else '8.6pt' }}; }
+  .betrag { font-size: {{ '13pt' if hoch else '10pt' }}; font-weight: bold; }
+  table.zahlung { width: 100%; border-collapse: collapse; table-layout: fixed; }
+  table.zahlung td.qr { width: {{ '36mm' if hoch else '25.5mm' }}; text-align: right; vertical-align: top; padding: 0; }
+  table.zahlung td.qr img { width: {{ '34mm' if hoch else '24mm' }}; height: {{ '34mm' if hoch else '24mm' }}; }
+  table.zahlung td.angaben { vertical-align: top; padding: 0; }
+  table.angaben { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: {{ '8.4pt' if hoch else '6.8pt' }}; }
+  table.angaben th { width: {{ '20mm' if hoch else '14mm' }}; text-align: left; font-weight: normal; color: #555;
+    padding: .2mm 1.5mm .2mm 0; vertical-align: top; }
+  table.angaben td { padding: .2mm 0; font-weight: bold; overflow-wrap: anywhere; word-break: break-word; }
+  .qr-gross { text-align: center; margin-top: 4mm; font-size: 7.5pt; color: #555; }
+  .qr-gross img { width: 40mm; height: 40mm; }
+  .mono { font-family: "DejaVu Sans Mono", monospace; }
+  .fuss { position: absolute; left: {{ '9mm' if hoch else '6mm' }}; right: {{ '9mm' if hoch else '6mm' }}; bottom: {{ '7mm' if hoch else '3.2mm' }};
+    font-size: {{ '7.6pt' if hoch else '6pt' }}; color: #444; }
+</style>
+</head>
+<body>
+{% for seite in seiten %}
+<div class="seite">
+  {% for s in seite %}{% set po = s.posten %}
+  <div class="zettel">
+    <div class="kopf">
+      <div class="schule">{% if cfg.logo_uri %}<img src="{{ cfg.logo_uri }}" alt="">{% else %}{{ cfg.schulname }}{% endif %}</div>
+      <div class="titel">Zahlungserinnerung</div>
+    </div>
+    <div class="an">An die Eltern von <b>{{ po.vorname }} {{ po.nachname }}</b>, Klasse {{ po.klasse }}</div>
+    <p style="margin:0 0 1.4mm">Für <b>{{ s.projekt.bezeichnung }}</b> ist noch <span class="betrag">{{ s.betrag|euro }}</span> offen{% if po.faellig_am %} (fällig seit {{ po.faellig_am|datum }}){% endif %}. Bitte überweisen Sie den Betrag bald:</p>
+    <table class="zahlung"><tr>
+      <td class="angaben"><table class="angaben">
+        <tr><th>Empfänger</th><td>{{ s.konto.inhaber }}</td></tr>
+        <tr><th>IBAN</th><td class="mono">{{ s.konto.iban|iban }}</td></tr>
+        <tr><th>Betrag</th><td>{{ s.betrag|euro }}</td></tr>
+        <tr><th>Zweck</th><td class="mono">{{ s.zweck }}</td></tr>
+      </table></td>
+      {% if s.qr and not hoch %}<td class="qr"><img src="{{ s.qr }}" alt="QR-Code"></td>{% endif %}
+    </tr></table>
+    {% if s.qr and hoch %}<div class="qr-gross"><img src="{{ s.qr }}" alt="QR-Code"><br>Mit der Banking-App scannen</div>{% endif %}
+    <div class="fuss">Schon bezahlt? Dann ist dieser Zettel erledigt – vielen Dank! · {{ cfg.ort }}, {{ heute.strftime('%d.%m.%Y') }}</div>
+  </div>
+  {% endfor %}
+</div>
+{% endfor %}
+</body>
+</html>
diff --git a/schulkasse/templates/pdf/jahresendmitteilung.html b/schulkasse/templates/pdf/jahresendmitteilung.html
new file mode 100644
index 0000000..8d1374d
--- /dev/null
+++ b/schulkasse/templates/pdf/jahresendmitteilung.html
@@ -0,0 +1,92 @@
+{% extends "pdf/_basis.html" %}
+{% block title %}Jahresendmitteilung {{ v.stichtag[:4] }}{% endblock %}
+{% block body %}
+<style>
+  body { font-size: 9.5pt; line-height: 1.4; }
+  .kopf { overflow: hidden; border-bottom: .6pt solid #333; padding-bottom: 3mm; margin-bottom: 6mm; }
+  .kopf img { max-height: 18mm; max-width: 50mm; float: left; }
+  .kopf .absender { float: right; text-align: right; white-space: pre-line; font-size: 8.5pt; }
+  .an { margin-bottom: 6mm; }
+  .datum { text-align: right; margin-bottom: 5mm; }
+  h1 { font-size: 13pt; margin-bottom: 1mm; }
+  .unter { color: #444; margin-bottom: 5mm; }
+  table.uebersicht th, table.uebersicht td, table.zus th, table.zus td { border: .4pt solid #999; }
+  .vorlaeufig { border: 1pt solid #8a5300; background: #fff6e5; padding: 2mm 3mm; margin: 3mm 0; }
+  .konto { page-break-inside: avoid; margin-top: 5mm; }
+  .konto h2 { font-size: 10.5pt; margin-bottom: 1.5mm; }
+  .ok { color: #1e6b3a; }
+  em { color: #444; }
+  .bemerkung { white-space: pre-line; border-left: 1.2pt solid #999; padding-left: 3mm; margin-top: 4mm; }
+  .bestaetigung { margin-top: 8mm; page-break-inside: avoid; }
+  table.unterschriften { margin-top: 16mm; width: 100%; border-collapse: separate; border-spacing: 8mm 0; }
+  table.unterschriften td { border: 0; border-top: .6pt solid #111; padding-top: 1mm; font-size: 8pt; width: 50%; }
+  .anlagen { margin-top: 8mm; font-size: 8.5pt; }
+</style>
+<div class="kopf">
+  {% if cfg.logo_uri %}<img src="{{ cfg.logo_uri }}" alt="">{% else %}<strong>{{ cfg.schulname }}</strong>{% endif %}
+  <div class="absender">{{ cfg.schulname }}{% if schulanschrift %}
+{{ schulanschrift }}{% endif %}</div>
+</div>
+<div class="an">An die<br>Stadt Niederkassel<br>– Schulverwaltung –<br>– Fachbereich 2 – Finanzen –</div>
+<div class="datum">{{ cfg.ort }}, {{ heute.strftime('%d.%m.%Y') }}</div>
+
+<h1>Jahresendmitteilung: Bestände der Schulgirokonten zum {{ v.stichtag|datum }}</h1>
+<div class="unter">Bescheinigung nach § 9 Abs. 1 und 2 sowie Begründung der Bestände nach § 6 Abs. 2 der Richtlinie
+  über die Führung von Schulgirokonten</div>
+
+<p>Hiermit teilen wir die Bestände sämtlicher Schulgirokonten der Schule zum {{ v.stichtag|datum }} mit:</p>
+<table class="uebersicht">
+  <thead><tr><th>Bezeichnung des Kontos</th><th>IBAN</th><th>Geldinstitut</th><th class="r">Kontostand {{ v.stichtag|datum }}</th></tr></thead>
+  <tbody>
+  {% for k in v.konten %}
+  <tr><td>{{ k.konto.bezeichnung }}</td><td>{{ k.konto.iban|iban }}</td><td>{{ k.konto.geldinstitut or '' }}</td>
+    <td class="r"><b>{{ k.saldo|euro }}</b>{% if k.vorlaeufig %} *{% endif %}</td></tr>
+  {% endfor %}
+  </tbody>
+  <tfoot><tr><td colspan="3">Summe</td><td class="r">{{ v.gesamt|euro }}</td></tr></tfoot>
+</table>
+{% if v.vorlaeufig %}
+<div class="vorlaeufig">* Vorläufiger Stand: Für dieses Konto lagen bei Erstellung nur Umsätze bis
+  {% for k in v.konten if k.vorlaeufig %}{{ k.letzter_import|datum if k.letzter_import else '–' }} ({{ k.konto.bezeichnung }}){% if not loop.last %}, {% endif %}{% endfor %}
+  vor. Bis zum Stichtag erwartete Zahlungen sind nicht enthalten; der endgültige Stand ergibt sich aus dem Kontoauszug zum {{ v.stichtag|datum }}.</div>
+{% endif %}
+
+<h2>Begründung der Bestände (§ 6 Abs. 2)</h2>
+{% if not v.mit_bestand %}
+<p class="ok">Alle Konten weisen zum Stichtag keinen Bestand aus. Eine Begründung ist nicht erforderlich.</p>
+{% endif %}
+{% for k in v.konten %}
+<div class="konto">
+  <h2>{{ k.konto.bezeichnung }}: {{ k.saldo|euro }}</h2>
+  {% if not k.saldo %}
+  <p class="ok">Kein Bestand.</p>
+  {% else %}
+  <p>Der Bestand setzt sich aus zweckgebundenen Mitteln folgender Vorhaben zusammen; er wird für deren Abwicklung
+    im neuen Jahr benötigt bzw. ist als Restmittel abgeschlossener Vorhaben ausgewiesen:</p>
+  <table class="zus">
+    <thead><tr><th>Projekt / Vorhaben</th><th>Status</th><th class="r">Betrag</th></tr></thead>
+    <tbody>
+    {% for p in k.projekte %}
+    <tr><td>{{ p.bezeichnung }}</td>
+      <td>{% if p.status == 'offen' %}laufend{% else %}abgeschlossen{% if p.abgeschlossen_am %} am {{ p.abgeschlossen_am|datum }}{% endif %}, Restmittel{% endif %}</td>
+      <td class="r">{{ p.betrag|euro }}</td></tr>
+    {% endfor %}
+    {% for text, betrag in k.sonstige %}
+    <tr><td colspan="2"><em>{{ text }}</em></td><td class="r">{{ betrag|euro }}</td></tr>
+    {% endfor %}
+    </tbody>
+    <tfoot><tr><td colspan="2">Kontostand</td><td class="r">{{ k.saldo|euro }}</td></tr></tfoot>
+  </table>
+  {% endif %}
+</div>
+{% endfor %}
+{% if bemerkung %}<div class="bemerkung"><b>Ergänzende Begründung:</b>
+{{ bemerkung }}</div>{% endif %}
+
+<div class="bestaetigung">
+  <p>Die vorstehenden Kontostände werden hiermit verbindlich bestätigt. Die Bestände wurden von der Schulleitung
+    geprüft und sind sachlich und rechnerisch richtig.</p>
+  <table class="unterschriften"><tr><td>Ort, Datum</td><td>Unterschrift Schulleitung</td></tr></table>
+</div>
+<div class="anlagen"><b>Anlagen:</b> Kontoauszüge zum {{ v.stichtag|datum }} für jedes der aufgeführten Konten (§ 9 Abs. 2)</div>
+{% endblock %}
diff --git a/schulkasse/templates/pdf/klassenliste.html b/schulkasse/templates/pdf/klassenliste.html
new file mode 100644
index 0000000..11b8fab
--- /dev/null
+++ b/schulkasse/templates/pdf/klassenliste.html
@@ -0,0 +1,55 @@
+{% extends "pdf/_basis.html" %}
+{% block title %}Zahlungsstatus Klassen{% endblock %}
+{% block orientierung %}{{ 'landscape' if quer else 'portrait' }}{% endblock %}
+{% block body %}
+<style>
+  .klasse { page-break-after: always; }
+  .klasse:last-child { page-break-after: auto; }
+  .vertraulich { float: right; font-size: 7pt; color: #a4262c; border: .6pt solid #a4262c; padding: .6mm 2mm; border-radius: 1mm; }
+  table.matrix th, table.matrix td { border: .4pt solid #999; text-align: center; vertical-align: middle; }
+  table.matrix th.name, table.matrix td.name { text-align: left; }
+  table.matrix th { font-size: 7.5pt; }
+  table.matrix th small { display: block; font-weight: normal; color: #555; }
+  table.matrix tbody tr:nth-child(even) td { background: #f6f7f6; }
+  .s-bezahlt { color: #1e6b3a; font-weight: bold; }
+  .s-offen { color: #a4262c; font-weight: bold; }
+  .s-teilweise { color: #8a5300; font-weight: bold; }
+  .s-keiner { color: #999; }
+  .legende { font-size: 7.5pt; color: #444; margin-top: 3mm; }
+  .unterschrift { margin-top: 8mm; font-size: 8pt; }
+</style>
+{% for kl in listen %}
+<section class="klasse">
+  <span class="vertraulich">Vertraulich – nur für die Klassenleitung</span>
+  <h1>Zahlungsstatus Klasse {{ kl.klasse.bezeichnung }}</h1>
+  <div class="meta">{{ cfg.schulname }} · Schuljahr {{ kl.klasse.schuljahr }} · Stand {{ heute.strftime('%d.%m.%Y') }}
+    · {{ kl.zeilen|length }} Kinder{% if kl.projekte %} · {{ kl.offen_kinder }} mit offenem Betrag{% endif %}</div>
+  {% if not kl.projekte %}
+  <p>Für diese Klasse gibt es keine Projekte mit Elternbeiträgen.</p>
+  {% else %}
+  <table class="matrix">
+    <thead><tr><th class="name">Name</th>
+      {% for p in kl.projekte %}<th>{{ p.bezeichnung }}{% if p.faellig_am %}<small>fällig {{ p.faellig_am|datum }}</small>{% endif %}</th>{% endfor %}
+      {% if kl.projekte|length > 1 %}<th>Offen gesamt</th>{% endif %}</tr></thead>
+    <tbody>
+    {% for z in kl.zeilen %}
+      <tr><td class="name">{{ z.kind.nachname }}, {{ z.kind.vorname }}</td>
+        {% for f in z.felder %}<td class="s-{{ f.status }}">
+          {%- if f.status == 'bezahlt' %}✓ bezahlt
+          {%- elif f.status == 'offen' %}offen {{ f.offen|euro }}
+          {%- elif f.status == 'teilweise' %}noch {{ f.offen|euro }}
+          {%- else %}–{% endif %}</td>{% endfor %}
+        {% if kl.projekte|length > 1 %}<td class="{{ 's-offen' if z.offen else 's-bezahlt' }}">{{ z.offen|euro if z.offen else '✓' }}</td>{% endif %}</tr>
+    {% endfor %}
+    </tbody>
+    <tfoot><tr><td class="name">Bezahlt</td>
+      {% for p in kl.projekte %}{% set sp = kl.spalten[p.id] %}<td>{{ sp.bezahlt }} von {{ sp.gesamt }}</td>{% endfor %}
+      {% if kl.projekte|length > 1 %}<td></td>{% endif %}</tr></tfoot>
+  </table>
+  <p class="legende">✓ bezahlt = Betrag vollständig eingegangen · offen = noch keine Zahlung · noch … = Restbetrag nach Teilzahlung ·
+    – = kein Beitrag zu zahlen. Zahlungen der letzten Tage sind eventuell noch nicht verbucht.
+    Bitte die Liste nicht aushängen oder an Dritte weitergeben.</p>
+  {% endif %}
+</section>
+{% endfor %}
+{% endblock %}
diff --git a/schulkasse/templates/pdf/ueberwachungsliste.html b/schulkasse/templates/pdf/ueberwachungsliste.html
new file mode 100644
index 0000000..242ff53
--- /dev/null
+++ b/schulkasse/templates/pdf/ueberwachungsliste.html
@@ -0,0 +1,122 @@
+<!doctype html>
+<html lang="de">
+<head>
+<meta charset="utf-8">
+<title>Überwachungsliste {{ listen[0].konto.bezeichnung if listen }}</title>
+<style>
+  @page { size: A4 landscape; margin: 11mm 10mm 13mm;
+    @bottom-left { content: "Überwachungsliste nach § 8 Richtlinie Schulgirokonten · {{ cfg.fusszeile }} · erzeugt {{ erzeugt|zeit }} von {{ user.anzeigename|replace('"', '') }}"; font-size: 6.5pt; color: #666; }
+    @bottom-right { content: "Seite " counter(page) " von " counter(pages); font-size: 6.5pt; color: #666; } }
+  body { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; font-size: 7.6pt; color: #111; }
+  .liste { page-break-after: always; }
+  .liste:last-child { page-break-after: auto; }
+  .anlage { font-size: 7pt; text-decoration: underline; margin-bottom: 2mm; }
+  h1 { font-size: 12pt; text-align: center; margin: 0 0 3mm; }
+  .kopf { width: 62%; border-collapse: collapse; margin: 0 0 2mm 8mm; }
+  .kopf th { text-align: right; font-weight: bold; padding: .6mm 2mm .6mm 0; width: 52mm; vertical-align: top; white-space: nowrap; }
+  .kopf td { border-bottom: .5pt solid #111; padding: .6mm 1mm; white-space: pre-line; }
+  .einleitung { font-size: 7pt; margin: 2mm 0 2.5mm; }
+  .auszugnr { display: inline-block; border: .8pt solid #111; padding: .8mm 3mm; font-weight: bold; margin-bottom: 2mm; }
+  .auszugnr span { font-weight: normal; margin-left: 3mm; }
+  table.ul { width: 100%; border-collapse: collapse; table-layout: fixed; }
+  table.ul th, table.ul td { border: .5pt solid #111; padding: .7mm 1mm; vertical-align: top; overflow-wrap: anywhere; }
+  table.ul thead th { background: #f0f0f0; font-size: 7pt; text-align: center; vertical-align: middle; }
+  table.ul thead th.gruppe { background: #fff; }
+  table.ul td.r { text-align: right; white-space: nowrap; }
+  table.ul td.c { text-align: center; }
+  table.ul td.d { white-space: nowrap; }
+  table.ul .schwarz { background: #111; }
+  table.ul tr.saldo td { font-weight: bold; background: #fafafa; }
+  table.ul tfoot td { font-weight: bold; border-top: 1.2pt solid #111; }
+  .zweck { display: block; color: #555; font-size: 6.4pt; margin-top: .4mm; }
+  .neg { color: #b00; font-weight: bold; }
+  .fussnote { font-size: 6.5pt; margin-top: 1.5mm; }
+  .unten { margin-top: 4mm; width: 100%; }
+  .unten::after { content: ""; display: block; clear: both; }
+  .abgleich { float: left; width: 55%; font-size: 7.4pt; }
+  .abgleich table { border-collapse: collapse; }
+  .abgleich td { padding: .5mm 2mm .5mm 0; }
+  .abgleich td.r { text-align: right; }
+  .ok { color: #1e6b3a; font-weight: bold; }
+  .fehler { color: #b00; font-weight: bold; }
+  .bestaetigung { float: right; width: 38%; font-size: 7.4pt; }
+  .bestaetigung .linie { border-bottom: .6pt solid #111; height: 12mm; margin-top: 1mm; }
+  .bestaetigung .unterschrift { font-size: 6.5pt; color: #444; margin-top: .6mm; }
+  .vermerk { font-size: 6.8pt; color: #333; margin-top: 1.5mm; }
+  col.nr { width: 8mm; } col.datum { width: 17mm; } col.klasse { width: 12mm; } col.name { width: 30mm; }
+  col.betrag { width: 17mm; } col.auszug { width: 14mm; } col.anm { width: 42mm; }
+</style>
+</head>
+<body>
+{% for ul in listen %}
+<section class="liste">
+  <div class="anlage">ANLAGE 1: Überwachungsliste Einnahmen und Ausgaben</div>
+  <h1>Überwachungsliste (ÜL) für Einnahmen und Ausgaben</h1>
+  <table class="kopf">
+    <tr><th>Name und Anschrift der Schule:</th><td><b>{{ cfg.schulname }}</b>{% if schulanschrift %}
+{{ schulanschrift }}{% endif %}</td></tr>
+    <tr><th>Geldinstitut:</th><td>{{ ul.konto.geldinstitut or '' }}</td></tr>
+    <tr><th>IBAN:</th><td>{{ ul.konto.iban|iban }}</td></tr>
+    <tr><th>Bereich / Bezeichnung des Kontos (§ 4):</th><td>{{ ul.konto.bezeichnung }}</td></tr>
+  </table>
+  <p class="einleitung">In dieser Überwachungsliste sind sämtliche Kontobewegungen des oben genannten Schulgirokontos für den
+    jeweiligen Zahlungsbereich zu erfassen. Die Verwendung der Mittel ist entsprechend nachzuweisen bzw. zu erläutern.</p>
+  <div class="auszugnr">Kontoauszug Nr. {{ ul.bezeichnung }}<span>Zeitraum {{ ul.auszug.datum_von|datum }} – {{ ul.auszug.datum_bis|datum }}</span></div>
+
+  <table class="ul">
+    <colgroup><col class="nr"><col class="datum"><col class="klasse"><col class="name"><col>
+      <col class="betrag"><col class="betrag"><col class="betrag"><col class="auszug"><col class="betrag"><col class="anm"></colgroup>
+    <thead>
+      <tr><th rowspan="2">Lfd.-<br>Nr.</th><th rowspan="2">Datum</th><th rowspan="2">Klasse</th><th rowspan="2">Empfänger/ Einzahler</th>
+        <th rowspan="2">Zahlungsgrund lt. beigefügter Belege/Rechnungen</th>
+        <th rowspan="2">Einnahme in €</th><th rowspan="2">Ausgabe in €</th>
+        <th colspan="3" class="gruppe">Schulgirokonto:</th><th rowspan="2">ggf. Anmerkungen</th></tr>
+      <tr><th>Buchung in €</th><th>Auszugs-<br>Nr.:</th><th>Konto&shy;stand in €*¹</th></tr>
+    </thead>
+    <tbody>
+      <tr class="saldo"><td colspan="5" class="r">Anfangsbestand</td><td></td><td></td><td class="schwarz"></td>
+        <td class="c">{{ ul.bezeichnung }}</td><td class="r {{ 'neg' if ul.anfangssaldo < 0 }}">{{ ul.anfangssaldo|euro }}</td><td>Startsaldo</td></tr>
+      {% for z in ul.zeilen %}
+      <tr><td class="c">{{ z.nr }}</td><td class="d">{{ z.datum|datum }}</td><td>{{ z.klasse }}</td><td>{{ z.name }}</td>
+        <td>{{ z.grund }}{% if z.zweck and z.zweck != z.grund %}<span class="zweck">{{ z.zweck|truncate(160) }}</span>{% endif %}</td>
+        <td class="r">{{ z.einnahme|euro if z.einnahme }}</td><td class="r">{{ z.ausgabe|euro if z.ausgabe }}</td>
+        <td class="r">{{ z.buchung|euro }}</td><td class="c">{{ ul.bezeichnung }}</td>
+        <td class="r {{ 'neg' if z.stand < 0 }}">{{ z.stand|euro }}</td><td>{{ z.anmerkung }}</td></tr>
+      {% else %}
+      <tr><td colspan="11" class="c">Keine Kontobewegungen in diesem Zeitraum.</td></tr>
+      {% endfor %}
+    </tbody>
+    <tfoot>
+      <tr><td colspan="5" class="r">Endbestand:</td><td class="r">{{ ul.eingaenge|euro }}</td><td class="r">{{ ul.ausgaenge|euro }}</td>
+        <td class="schwarz"></td><td class="c">{{ ul.zeilen|length }}</td><td class="r {{ 'neg' if ul.endsaldo < 0 }}">{{ ul.endsaldo|euro }}</td><td>Endsaldo</td></tr>
+    </tfoot>
+  </table>
+  <div class="fussnote">*¹ darf nicht negativ werden{% if ul.negativ %} – <span class="fehler">Achtung: Der Kontostand war in diesem Zeitraum negativ.</span>{% endif %}</div>
+
+  <div class="unten">
+    <div class="abgleich">
+      <table>
+        <tr><td>Anfangssaldo (= Endsaldo des vorhergehenden Auszugs)</td><td class="r">{{ ul.anfangssaldo|euro }}</td></tr>
+        <tr><td>+ Einnahmen</td><td class="r">{{ ul.eingaenge|euro }}</td></tr>
+        <tr><td>− Ausgaben</td><td class="r">{{ ul.ausgaenge|euro }}</td></tr>
+        <tr><td><b>= Endsaldo laut Überwachungsliste</b></td><td class="r"><b>{{ ul.endsaldo|euro }}</b></td></tr>
+        <tr><td>Endsaldo laut Kontoauszug</td><td class="r">{{ ul.auszug.endsaldo_cent|euro if ul.auszug.endsaldo_cent is not none else 'nicht erfasst' }}</td></tr>
+        <tr><td colspan="2">{% if ul.auszug.endsaldo_cent is none %}<span class="fehler">Abgleich mit dem Kontoauszug steht noch aus.</span>
+          {% elif ul.auszug.endsaldo_cent == ul.endsaldo %}<span class="ok">✓ stimmt mit dem Kontoauszug überein</span>
+          {% else %}<span class="fehler">✗ Abweichung {{ (ul.auszug.endsaldo_cent - ul.endsaldo)|euro }}</span>{% endif %}</td></tr>
