 """Schulkasse - contribution and cash book management for GGS Niederkassel."""
 import logging
 import secrets
+import sqlite3
 from datetime import datetime, timezone
 from zoneinfo import ZoneInfo
 
@@ -9,7 +10,7 @@ from markupsafe import Markup
 
