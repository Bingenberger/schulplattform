@@ -0,0 +1,63 @@
+services:
+  app:
+    image: kompetenz-manager:0.1.0-dev
+    build:
+      context: .
+      target: runtime
+    user: "10001:10001"
+    read_only: true
+    init: true
+    cap_drop: [ALL]
+    security_opt: [no-new-privileges:true]
