+/* =====================================================================
+   Gestaltung: Pico-Anpassung, Icons und neue Bausteine
+   ===================================================================== */
+
+/* Picos eigene Variablen werden am <body> gesetzt: Pico definiert sie an
+   :root mit höherer Spezifität, die Vererbung vom body gewinnt trotzdem. */
+html { background-color: var(--c-bg); }
+body {
+  --pico-background-color: var(--c-bg);
+  --pico-card-background-color: var(--c-surface);
+  --pico-card-sectioning-background-color: var(--c-surface);
+  --pico-card-box-shadow: var(--shadow-sm);
+  --pico-border-radius: var(--radius-sm);
+  --pico-muted-border-color: var(--c-border);
+  background-color: var(--c-bg);
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+}
+.site-main { flex: 1 0 auto; padding-top: 1.75rem; padding-bottom: 3rem; }
+h1, h2, h3 { letter-spacing: -0.015em; }
+h1 { font-weight: 800; }
+
+article {
+  border: 1px solid var(--c-border);
+  border-radius: var(--radius);
+}
+
+/* ----- Icons ----- */
+.ph, .ph-fill { vertical-align: -0.14em; font-size: 1.1em; }
+:is(h1, h2, h3, legend) > .ph,
+.section-title > .ph { color: var(--c-primary); }
+.section-title .ph { font-size: 1.25em; vertical-align: -0.2em; margin-right: 0.15rem; }
+
+button, [role="button"] {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.45em;
+}
+button .ph, [role="button"] .ph { font-size: 1.15em; vertical-align: 0; }
+.btn-block { width: 100%; margin-top: 0.5rem; }
+
+/* Farbtöne für Icon-Kacheln */
+.tone-primary { background: var(--c-primary-bg); color: var(--c-primary); }
+.tone-accent  { background: var(--c-accent-bg);  color: var(--c-accent);  }
+.tone-success { background: var(--c-success-bg); color: var(--c-success); }
+.tone-danger  { background: var(--c-danger-bg);  color: var(--c-danger);  }
+.tone-warn    { background: var(--c-warning-bg); color: var(--c-warning); }
+.tone-neutral { background: var(--c-neutral-bg); color: var(--c-neutral); }
+
+.station-icon, .stat-icon, .link-card-icon, .empty-icon {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  border-radius: var(--radius-sm);
+}
+.station-icon .ph-fill, .stat-icon .ph-fill, .link-card-icon .ph-fill,
+.empty-icon .ph, .empty-icon .ph-fill { vertical-align: 0; }
+.stat-icon      { width: 2.6rem; height: 2.6rem; font-size: 1.35rem; }
+.link-card-icon { width: 2.9rem; height: 2.9rem; font-size: 1.5rem; margin-bottom: 0.85rem; }
+.empty-icon {
+  width: 4rem; height: 4rem;
+  font-size: 2rem;
+  border-radius: var(--radius-pill);
+  margin: 0 auto 0.85rem;
+  display: flex;
+  background: var(--c-primary-bg);
+  color: var(--c-primary);
+}
+.empty-icon.tone-warn { background: var(--c-warning-bg); color: var(--c-warning); }
+
+/* ----- Kopfzeile ----- */
+.site-header {
+  background: var(--c-header);
+  backdrop-filter: saturate(1.6) blur(10px);
+  -webkit-backdrop-filter: saturate(1.6) blur(10px);
+  box-shadow: 0 1px 0 var(--c-border), 0 6px 20px -16px rgb(30 27 75 / 0.4);
+  border-bottom: 0;
+}
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.6rem;
+  text-decoration: none;
+  color: var(--pico-color);
+}
+.brand:hover { text-decoration: none; }
+.brand-mark {
+  width: 2.2rem; height: 2.2rem;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 0.65rem;
+  background: var(--hero-gradient);
+  color: #fff;
+  font-size: 1.25rem;
+  box-shadow: 0 4px 10px -4px rgb(79 70 229 / 0.6);
+  transition: transform 0.2s;
+}
+.brand-mark .ph-fill { vertical-align: 0; font-size: 1em; }
+.brand:hover .brand-mark { transform: rotate(-8deg) scale(1.05); }
+.brand-mark-lg { width: 3.5rem; height: 3.5rem; font-size: 1.9rem; border-radius: 1rem; }
+.brand-name { font-weight: 800; letter-spacing: -0.02em; font-size: 1.05rem; }
+.brand-tag {
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  padding: 0.15rem 0.5rem;
+  border-radius: var(--radius-pill);
+  background: var(--c-accent-bg);
+  color: var(--c-accent-text);
+}
+.admin-nav a {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  border-radius: var(--radius-pill);
+  padding: 0.4rem 0.8rem;
+  margin: 0;
+  color: var(--c-muted);
+  font-weight: 500;
+}
+.admin-nav a:hover { background: var(--c-neutral-bg); color: var(--pico-color); text-decoration: none; }
+.admin-nav a[aria-current="page"] { background: var(--c-primary-bg); color: var(--c-primary-text); font-weight: 600; }
+.admin-nav .ph { font-size: 1.15em; vertical-align: 0; }
+.nav-form { display: inline; margin: 0; }
+
+.site-footer { border-top-color: var(--c-border); padding-bottom: 1.5rem; }
+.site-footer a { text-decoration: none; }
+
+/* ----- Begrüßungsbereich ----- */
+.hero {
+  position: relative;
+  overflow: hidden;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1.5rem;
+  padding: 2.25rem 2rem;
+  margin-bottom: 2rem;
+  border-radius: var(--radius-lg);
+  background: var(--hero-gradient);
+  color: #fff;
+  box-shadow: var(--shadow);
+}
+/* Konfetti-Punkte als dezentes Hintergrundmuster */
+.hero::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background-image:
+    radial-gradient(circle at 12% 20%, rgb(255 255 255 / 0.18) 0 3px, transparent 4px),
+    radial-gradient(circle at 78% 82%, rgb(255 209 102 / 0.55) 0 4px, transparent 5px),
+    radial-gradient(circle at 60% 14%, rgb(126 224 195 / 0.5) 0 3px, transparent 4px),
+    radial-gradient(circle at 92% 40%, rgb(255 143 163 / 0.55) 0 5px, transparent 6px),
+    radial-gradient(circle at 35% 88%, rgb(255 255 255 / 0.2) 0 2px, transparent 3px);
+  pointer-events: none;
+}
+.hero > * { position: relative; }
+.hero h1 { color: #fff; margin: 0 0 0.4rem; font-size: clamp(1.7rem, 4vw, 2.4rem); }
+.hero p { margin: 0; color: rgb(255 255 255 / 0.88); }
+.hero a { color: #fff; }
+.hero-kicker {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  margin-bottom: 0.6rem !important;
+  padding: 0.25rem 0.75rem;
+  border-radius: var(--radius-pill);
+  background: rgb(255 255 255 / 0.16);
+  font-size: 0.8rem;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+  color: #fff !important;
+}
+.hero-kicker .ph-fill { color: #ffd166; vertical-align: 0; }
+.hero-meta { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; font-weight: 500; }
+.hero-desc { margin-top: 0.75rem !important; max-width: 46rem; }
+.hero-compact { padding: 1.6rem 1.75rem; }
+.hero-art { display: flex; gap: 0.75rem; flex-shrink: 0; }
+.hero-bubble {
+  width: 4rem; height: 4rem;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 1.25rem;
+  background: rgb(255 255 255 / 0.16);
+  border: 1px solid rgb(255 255 255 / 0.22);
+  font-size: 2rem;
+  animation: bob 4s ease-in-out infinite;
+}
+.hero-bubble .ph-fill { vertical-align: 0; }
+.hero-bubble.b1 { color: #ffd166; transform: rotate(-6deg); }
+.hero-bubble.b2 { color: #ff8fa3; animation-delay: -1.3s; margin-top: 1.5rem; }
+.hero-bubble.b3 { color: #7ee0c3; animation-delay: -2.6s; }
+@keyframes bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -6px; } }
+
+.section-heading { font-size: 1.15rem; margin: 0 0 0.85rem; }
+
+/* ----- Veranstaltungs-Karten ----- */
+.event-card {
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  align-items: center;
+  gap: 1rem;
+  box-shadow: var(--shadow-sm);
+  transition: border-color 0.15s, box-shadow 0.2s, transform 0.2s;
+}
+.event-card:hover, .event-card:focus-visible {
+  box-shadow: var(--shadow);
+  transform: translateY(-2px);
+}
+.event-card-body { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
+.event-card-head strong { font-size: 1.1rem; }
+.event-card-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.2rem 1rem;
+  color: var(--c-muted);
+  font-size: 0.88rem;
+}
+.event-card-go {
+  width: 2.25rem; height: 2.25rem;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: var(--radius-pill);
+  background: var(--c-neutral-bg);
+  color: var(--c-muted);
+  transition: background 0.15s, color 0.15s, transform 0.2s;
+}
+.event-card-go .ph { vertical-align: 0; }
