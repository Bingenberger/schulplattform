+.date-tile-day { padding: 0.4rem 0 0.45rem; font-size: 1.45rem; font-weight: 800; color: var(--pico-color); }
+
+.link-card { display: flex; flex-direction: column; align-items: flex-start; }
+.link-card > [role="button"] { margin-top: auto; }
+
+/* ----- Stationen ----- */
+.station { box-shadow: var(--shadow-sm); }
+.station-head { align-items: center; gap: 0.85rem; flex-wrap: nowrap; }
