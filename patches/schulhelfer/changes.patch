diff --git a/app/migrate.py b/app/migrate.py
new file mode 100644
index 0000000..5918ab3
--- /dev/null
+++ b/app/migrate.py
@@ -0,0 +1,43 @@
+"""Explicit, exclusive Alembic job. Run with all application writers paused."""
+import argparse
+import os
+from pathlib import Path
+from alembic import command
+from alembic.config import Config
+from sqlalchemy import inspect
+from app.database import engine
+from app.platform import data_lock, database_path, HEAD, SCHEMA
+
+
+def migrate():
+    path = database_path()
+    with data_lock("migration"):
+        with engine.connect() as connection:
+            connection.exec_driver_sql("BEGIN IMMEDIATE")
+            try:
+                version = connection.exec_driver_sql("PRAGMA user_version").scalar()
+                if version not in (0, SCHEMA):
+                    raise RuntimeError("Unsupported database schema")
+                tables = set(inspect(connection).get_table_names()) - {"sqlite_sequence"}
+                if tables and "alembic_version" not in tables:
+                    raise RuntimeError("Unversioned existing database: reviewed adoption required")
+                cfg = Config(str(Path(__file__).resolve().parents[1] / "alembic.ini"))
+                cfg.set_main_option("script_location", str(Path(__file__).resolve().parents[1] / "migrations"))
+                cfg.attributes["connection"] = connection
+                command.upgrade(cfg, HEAD)
+                if connection.exec_driver_sql("PRAGMA foreign_key_check").fetchall():
+                    raise RuntimeError("Foreign key check failed")
+                connection.exec_driver_sql("PRAGMA user_version=" + str(SCHEMA))
+                connection.commit()
+            except BaseException:
+                connection.rollback()
+                raise
+        path.chmod(0o600)
+
+
+if __name__ == "__main__":
+    try:
+        migrate()
+        print("Migration verified.")
+    except Exception:
+        raise SystemExit("Migration refused or failed; inspect the private database and release compatibility.")
diff --git a/app/platform.py b/app/platform.py
new file mode 100644
index 0000000..e4b3d26
--- /dev/null
+++ b/app/platform.py
@@ -0,0 +1,45 @@
+"""Local runtime contract. SQLite jobs and scheduler share a private data root."""
+import fcntl
+import os
+from pathlib import Path
+from contextlib import contextmanager
+from sqlalchemy import text
+from sqlalchemy.engine import make_url
+from app.config import settings
+
+HEAD = "b7c2e9a41d38"
+SCHEMA = 1
+os.umask(0o077)
+
+
+def database_path():
+    url = make_url(settings.DATABASE_URL)
+    if url.drivername != "sqlite" or not url.database or url.database == ":memory:":
+        raise RuntimeError("This release requires a file-backed SQLite database")
+    return Path(url.database).resolve()
+
+
+@contextmanager
+def data_lock(name):
+    root = database_path().parent
+    root.mkdir(parents=True, exist_ok=True, mode=0o700)
+    with (root / (name + ".lock")).open("a") as stream:
+        os.chmod(stream.name, 0o600)
+        fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        try:
+            yield
+        finally:
+            fcntl.flock(stream, fcntl.LOCK_UN)
+
+
+def schema_ready():
+    from app.database import engine
+    if not database_path().is_file():
+        return False
+    try:
+        with engine.connect() as connection:
+            return (connection.execute(text("SELECT version_num FROM alembic_version")).scalars().all() == [HEAD]
+                    and connection.exec_driver_sql("PRAGMA user_version").scalar() == SCHEMA
+                    and connection.exec_driver_sql("SELECT 1").scalar() == 1)
+    except Exception:
+        return False
