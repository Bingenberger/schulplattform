+  content: "";
+  display: inline-block;
+  width: 0.5rem; height: 0.5rem;
+  margin-right: 0.4rem;
+  border-radius: var(--radius-pill);
+  background: var(--c-success);
+  box-shadow: 0 0 0 3px var(--c-success-bg);
+  animation: pulse 2s ease-in-out infinite;
+}
+@keyframes pulse { 50% { opacity: 0.35; } }
+
+/* Die Absendeleiste bleibt beim Scrollen durch lange Schichtlisten sichtbar. */
+.submit-bar {
+  position: sticky;
+  bottom: 0.75rem;
+  z-index: 50;
+  padding: 0.75rem 1rem;
+  background: var(--c-header);
+  backdrop-filter: blur(10px);
+  -webkit-backdrop-filter: blur(10px);
+  border: 1px solid var(--c-border);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow);
+}
+
+/* ----- Hinweis-Boxen: farbige Kante links ----- */
+.info-box, .success-box, .error-box, .overlap-warning, .mail-progress {
+  border-left-width: 4px;
+}
+.info-box .ph-fill    { color: var(--c-primary); }
+.success-box .ph-fill { color: var(--c-success); }
+.error-box .ph-fill   { color: var(--c-danger); }
+
+/* ----- Erfolgsseite ----- */
+.summary-list { list-style: none; padding: 0; }
+.summary-list li {
+  display: flex;
+  align-items: baseline;
+  flex-wrap: wrap;
+  gap: 0.15rem 0.4rem;
+  padding: 0.55rem 0.75rem;
+  margin-bottom: 0.35rem;
+  border-radius: var(--radius-sm);
+  background: var(--c-bg);
+  border: 1px solid var(--c-border);
+}
+.summary-icon { color: var(--c-primary); margin-right: 0.2rem; }
+.token-box {
+  display: flex;
+  align-items: center;
+  gap: 0.6rem;
+  border-style: dashed;
+}
+.token-icon { font-size: 1.4rem; color: var(--c-primary); flex-shrink: 0; }
+
+/* ----- Tabellen ----- */
+.table-scroll {
+  border: 1px solid var(--c-border);
+  border-radius: var(--radius);
+  background: var(--c-surface);
+}
+.table-scroll table { --pico-background-color: transparent; }
+.table-scroll th {
+  font-size: 0.75rem;
+  font-weight: 700;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+  color: var(--c-muted);
+  background: var(--c-bg);
+}
+.table-scroll tbody tr:last-child td { border-bottom: 0; }
+.table-scroll tbody tr:hover td { background: color-mix(in srgb, var(--c-primary-bg) 45%, transparent); }
+article .table-scroll { box-shadow: none; }
+.count-pill { display: inline-flex; align-items: center; gap: 0.3rem; font-variant-numeric: tabular-nums; }
+.count-pill .ph { color: var(--c-muted); }
+
+/* ----- Admin: Seitenkopf, Formulare, Metadaten ----- */
+.page-header h1 { font-size: 1.75rem; }
+.page-header h1 > .ph { color: var(--c-primary); }
+.form-card { max-width: 720px; }
+.form-card fieldset {
+  background: var(--c-surface);
+  border: 1px solid var(--c-border);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow-sm);
+  padding: 1.25rem 1.25rem 0.75rem;
+  margin-bottom: 1rem;
+}
+.form-card legend { font-weight: 700; font-size: 1.05rem; }
+.meta-grid { background: var(--c-surface); box-shadow: var(--shadow-sm); padding: 1.1rem 1.35rem; }
+.meta-grid dt .ph { color: var(--c-primary); margin-right: 0.25rem; }
+.status-actions { background: var(--c-surface); }
+.status-actions .label .ph { color: var(--c-primary); }
+.danger-zone { border-left-width: 4px; }
+details.panel { background: var(--c-surface); }
+.add-helper summary { display: inline-flex; align-items: center; gap: 0.3rem; }
+
+/* ----- Login ----- */
+.login-page {
+  background:
+    radial-gradient(60rem 30rem at 50% -10%, color-mix(in srgb, var(--c-primary) 22%, transparent), transparent),
+    var(--c-bg);
+}
+.login-head { text-align: center; margin-bottom: 1.25rem; }
+.login-head .brand-mark { margin-bottom: 0.85rem; }
+.login-head h1 { font-size: 1.75rem; margin: 0; }
+.login-head .eyebrow { margin-bottom: 0.15rem; }
+.login-page article { box-shadow: var(--shadow); }
+
+@media (prefers-reduced-motion: reduce) {
+  .hero-bubble, .live-hint::before, .flash { animation: none; }
+  .event-card, .event-card-go, .brand-mark { transition: none; }
+  .event-card:hover { transform: none; }
+}
+
+@media (max-width: 640px) {
+  .hero { padding: 1.5rem 1.25rem; border-radius: var(--radius); }
+  .hero-art { display: none; }
+  .event-card { grid-template-columns: auto 1fr; gap: 0.85rem; padding: 1rem; }
+  .event-card-go { display: none; }
+  /* Nur optisch ausblenden: Der Text bleibt der Name für Screenreader. */
+  .hide-sm, .admin-nav a span {
+    position: absolute;
+    width: 1px; height: 1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+  }
+  .brand-tag { display: none; }
+  .admin-nav a { padding: 0.45rem 0.65rem; font-size: 1.1rem; }
+  .station-head { flex-wrap: wrap; }
+  .submit-bar { bottom: 0.5rem; }
+  /* Auf dem Handy werden Dashboard-Zeilen zu Karten – kein Rahmen drumherum. */
+  .table-scroll:has(.dashboard-table) { border: 0; background: transparent; }
+  .dashboard-table tr { background: var(--c-surface); }
+}
+
+/* ----- Feinschliff nach Sichtprüfung ----- */
+/* Pico setzt für jedes li eine Aufzählung – in Karten-Listen unerwünscht. */
+.event-cards > li, .plain-list > li, .summary-list > li, .shift-list > li { list-style: none; }
+.section-head :is(h2, h3) { font-size: 1.15rem; }
+/* Pico zeichnet rechts einen eigenen Pfeil – wir haben links schon einen. */
+details.panel > summary::after { display: none; }
+/* Knöpfe in Formularen und Link-Knöpfe auf eine Linie bringen */
+.page-actions :is(button, [role="button"]) { margin: 0; min-height: 2.75rem; }
+.donation-list { margin-bottom: 0.5rem; }
+@media (max-width: 640px) {
+  .event-card { align-items: start; }
+}
+/* `.success-hero p { margin: 0 }` würde die Zentrierung sonst aufheben. */
+.success-hero .hero-mark { margin: 0 auto 0.85rem; }
