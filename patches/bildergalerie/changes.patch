+# Dateisignaturen der erlaubten Formate -> Pillow-Formatname und gespeicherte Endung
+SIGNATURES = (
+    (b"\x89PNG\r\n\x1a\n", "PNG", ".png"),
+    (b"\xff\xd8\xff", "JPEG", ".jpg"),
+    (b"GIF87a", "GIF", ".gif"),
+    (b"GIF89a", "GIF", ".gif"),
+)
+
+
+def sniff_format(head):
+    for signature, pil_format, extension in SIGNATURES:
+        if head.startswith(signature):
+            return pil_format, extension
+    if len(head) >= 12 and head[:4] == b"RIFF" and head[8:12] == b"WEBP":
+        return "WEBP", ".webp"
+    return None, None
+
+
+def detected_extension(file_storage):
+    file_storage.stream.seek(0)
+    head = file_storage.stream.read(16)
+    file_storage.stream.seek(0)
+    return sniff_format(head)[1] or ".png"
+
+
