new file mode 100644
index 0000000..338d193
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,146 @@
+import io
+import os
+import re
+import sqlite3
+import sys
+from pathlib import Path
+
+import pytest
+from PIL import Image as PILImage
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+os.environ.setdefault("SECRET_KEY_FILE", "")
+
+
+class Settings:
+    """Konfiguration für einen Testlauf mit eigenem Datenverzeichnis."""
+
+    def __init__(self, base):
+        from config import Config
+        self.base = base
+        self.DB_DIR = base / "db"
+        self.MEDIA_DIR = base / "media"
+        self.UPLOAD_FOLDER = str(self.MEDIA_DIR / "uploads")
+        self.THUMBNAIL_FOLDER = str(self.MEDIA_DIR / "thumbnails")
+        self.DISPLAY_FOLDER = str(self.MEDIA_DIR / "display")
+        self.overrides = {
+            "SECRET_KEY": "test-" + "x" * 40, "TESTING": True,
+            "DB_DIR": self.DB_DIR, "MEDIA_DIR": self.MEDIA_DIR,
+            "SQLALCHEMY_DATABASE_URI": "sqlite:///" + str(self.DB_DIR / "gallery.db"),
+            "UPLOAD_FOLDER": self.UPLOAD_FOLDER, "THUMBNAIL_FOLDER": self.THUMBNAIL_FOLDER,
+            "DISPLAY_FOLDER": self.DISPLAY_FOLDER, "API_TOKEN": "", "PUBLIC": True,
+            "BASE_URL": Config.BASE_URL,
+        }
+
+
+def png_bytes(size=(64, 48), color=(200, 30, 30), fmt="PNG"):
+    buffer = io.BytesIO()
+    PILImage.new("RGB", size, color).save(buffer, fmt)
+    return buffer.getvalue()
+
+
+@pytest.fixture
+def settings(tmp_path):
+    return Settings(tmp_path)
+
+
+@pytest.fixture
+def make_app(settings):
+    import migrate
+    from app import create_app
+    from extensions import db
+
+    created = []
+
+    def factory(**overrides):
+        migrate.migrate(log=lambda *_: None, settings=settings)
+        app = create_app(overrides={**settings.overrides, **overrides})
+        created.append(app)
+        return app
+
+    yield factory
+    for app in created:
+        with app.app_context():
+            db.session.remove()
+            db.engine.dispose()
+
+
+@pytest.fixture
+def app(make_app):
+    return make_app()
+
+
+@pytest.fixture
+def client(app):
+    return app.test_client()
+
+
+def csrf(client, path="/login"):
+    page = client.get(path).get_data(as_text=True)
+    return re.search(r'name="csrf-token" content="([^"]+)"', page).group(1)
+
+
+def add_image(app, name="Apfel", reviewed=True, tags=("apfel", "obst"), style="aquarell",
+              description="Ein Apfel auf einem Tisch", files=True):
+    """Bild-Datensatz samt Original, Vorschau und Anzeigeversion anlegen."""
+    from extensions import db
+    from models import Image, Tag
+    import secrets
+    with app.app_context():
+        filename = f"{name}_{secrets.token_hex(4)}.png"
+        if files:
+            data = png_bytes()
+            Path(app.config["UPLOAD_FOLDER"], filename).write_bytes(data)
+            webp = filename.rsplit(".", 1)[0] + ".webp"
+            for folder in (app.config["THUMBNAIL_FOLDER"], app.config["DISPLAY_FOLDER"]):
+                PILImage.new("RGB", (64, 48)).save(Path(folder, webp), "WEBP")
+        image = Image(filename=filename, reviewed=reviewed, style=style, description=description, width=64, height=48)
+        for tag_name in tags:
+            tag = Tag.query.filter_by(name=tag_name).first() or Tag(name=tag_name)
+            image.tags.append(tag)
+        db.session.add(image)
+        db.session.commit()
+        return image.id, filename
+
+
+def create_user(app, username="lehrkraft", password="ein-langes-passwort", **fields):
+    from werkzeug.security import generate_password_hash
+    from extensions import db
+    from models import User
+    with app.app_context():
+        user = User(username=username, password=generate_password_hash(password), **fields)
+        db.session.add(user)
+        db.session.commit()
+        return user.id
+
+
+def login(client, username="lehrkraft", password="ein-langes-passwort"):
+    token = csrf(client)
+    return client.post("/login", data={"username": username, "password": password, "csrf_token": token})
+
+
+def legacy_database(path, extra_sql=""):
+    """Datenbank der Vor-Plattform-Version wie auf pix.foerster.rocks (create_all + ALTER TABLE)."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    connection = sqlite3.connect(path)
+    connection.executescript("""
+        CREATE TABLE user (id INTEGER NOT NULL, username VARCHAR(50), password VARCHAR(100),
+            PRIMARY KEY (id), UNIQUE (username));
+        CREATE TABLE image (id INTEGER NOT NULL, filename VARCHAR(100), ai_tool TEXT, prompt TEXT,
+            upload_date DATETIME, reviewed BOOLEAN DEFAULT 1, file_hash VARCHAR(32), description TEXT,
+            PRIMARY KEY (id));
+        CREATE TABLE tag (id INTEGER NOT NULL, name VARCHAR(50), PRIMARY KEY (id), UNIQUE (name));
+        CREATE TABLE image_tags (image_id INTEGER, tag_id INTEGER,
+            FOREIGN KEY(image_id) REFERENCES image (id), FOREIGN KEY(tag_id) REFERENCES tag (id));
+        CREATE TABLE image_request (id INTEGER NOT NULL, tag_request VARCHAR(100), timestamp DATETIME,
+            PRIMARY KEY (id), UNIQUE (tag_request));
+        CREATE INDEX ix_image_reviewed_id ON image (reviewed, id);
+        INSERT INTO user VALUES (1, 'admin', 'pbkdf2:sha256:600000$x$y');
+        INSERT INTO image (id, filename, reviewed, description) VALUES (311, 'Apfel_f807ab63.png', 1, 'Ein Apfel');
+        INSERT INTO image (id, filename, reviewed, description) VALUES (312, 'Geheim_00000001.png', 0, 'neu');
+        INSERT INTO tag VALUES (7, 'apfel');
+        INSERT INTO image_tags VALUES (311, 7);
+    """ + extra_sql)
+    connection.commit()
+    connection.close()
diff --git a/tests/test_api.py b/tests/test_api.py
new file mode 100644
index 0000000..c4ec25a
--- /dev/null
+++ b/tests/test_api.py
@@ -0,0 +1,108 @@
+"""JSON-API v1: Vertrag für die Grundschultafel, inklusive Negativfälle."""
+from conftest import add_image, create_user, login
+
+
+def test_list_returns_contract_fields_newest_first(app, client):
+    first, _ = add_image(app, "Birne", tags=("birne", "obst"), style="bleistift", description="Eine Birne")
+    second, filename = add_image(app, "Apfel")
+    body = client.get("/api/v1/images").get_json()
+    assert [item["id"] for item in body["items"]] == [second, first]
+    item = body["items"][0]
+    stem = filename.rsplit(".", 1)[0]
+    assert item == {
+        "id": second, "description": "Ein Apfel auf einem Tisch", "tags": ["apfel", "obst"], "style": "aquarell",
+        "width": 64, "height": 48, "thumbnail_url": f"/media/thumbnails/{stem}.webp",
+        "display_url": f"/media/display/{stem}.webp", "license": app.config["LICENSE_NOTE"],
+    }
+    assert (body["page"], body["per_page"], body["total"], body["total_pages"]) == (1, 24, 2, 1)
+
+
+def test_search_covers_description_tags_and_style_case_insensitive(app, client):
+    apple, _ = add_image(app, "Apfel", tags=("apfel",), style="aquarell", description="Roter Apfel")
+    pear, _ = add_image(app, "Birne", tags=("birne",), style="bleistift", description="Grüne Birne")
+    bear, _ = add_image(app, "Baer", tags=("bär",), style="comic", description="Ein Tier")
+    ids = lambda q: [i["id"] for i in client.get("/api/v1/images", query_string={"q": q}).get_json()["items"]]
+    assert ids("ROTER") == [apple]          # Beschreibung
+    assert ids("Birne") == [pear]           # Schlagwort und Beschreibung, keine Doppelten
+    assert ids("BLEISTIFT") == [pear]       # Stil
+    assert ids("BÄR") == [bear]             # Umlaute ohne Groß-/Kleinschreibung
+    assert ids("%") == [] and ids("_") == []  # Platzhalter werden wörtlich genommen
+
+
+def test_tags_and_style_filter_combine(app, client):
+    both, _ = add_image(app, "A", tags=("apfel", "obst"), style="aquarell")
+    add_image(app, "B", tags=("apfel",), style="aquarell")
+    add_image(app, "C", tags=("apfel", "obst"), style="comic")
+    query = {"tags": "apfel,obst", "style": "Aquarell"}
+    assert [i["id"] for i in client.get("/api/v1/images", query_string=query).get_json()["items"]] == [both]
+
+
+def test_pagination_is_stable_and_bounded(app, client):
+    ids = [add_image(app, f"Bild{n}", files=False)[0] for n in range(5)]
+    page1 = client.get("/api/v1/images?per_page=2&page=1").get_json()
+    page3 = client.get("/api/v1/images?per_page=2&page=3").get_json()
+    assert [i["id"] for i in page1["items"]] == ids[::-1][:2]
+    assert [i["id"] for i in page3["items"]] == [ids[0]]
+    assert page1["total_pages"] == 3
+    assert client.get("/api/v1/images?per_page=500").get_json()["per_page"] == 60
+    assert client.get("/api/v1/images?page=x").status_code == 400
+    assert client.get("/api/v1/images", query_string={"q": "x" * 101}).status_code == 400
+    assert client.get("/api/v1/images", query_string={"tags": ",".join(f"t{n}" for n in range(11))}).status_code == 400
+
+
+def test_unreviewed_images_never_appear(app, client):
+    hidden, filename = add_image(app, "Geheim", reviewed=False, tags=("geheim",))
+    stem = filename.rsplit(".", 1)[0]
+    assert client.get("/api/v1/images?q=geheim").get_json()["total"] == 0
+    assert client.get(f"/api/v1/images/{hidden}").status_code == 404
+    assert client.get("/api/v1/tags?q=geh").get_json()["tags"] == []
+    for path in (f"/media/thumbnails/{stem}.webp", f"/media/display/{stem}.webp", f"/download/{filename}",
+                 f"/static/display/{stem}.webp"):
+        assert client.get(path).status_code == 404, path
+    # Angemeldet sieht die Redaktion das Bild zur Prüfung, die API bleibt trotzdem bei freigegebenen
+    create_user(app)
+    login(client)
+    assert client.get(f"/media/thumbnails/{stem}.webp").status_code == 200
+    assert client.get("/api/v1/images?q=geheim").get_json()["total"] == 0
+
+
+def test_single_image_and_unknown_endpoints(app, client):
+    image_id, _ = add_image(app)
+    assert client.get(f"/api/v1/images/{image_id}").get_json()["id"] == image_id
+    assert client.get("/api/v1/images/999999").status_code == 404
+    assert client.get("/api/v1/nichts").status_code == 404
+
+
+def test_tags_endpoint_counts_reviewed_images_by_prefix(app, client):
+    add_image(app, "A", tags=("apfel", "obst"))
+    add_image(app, "B", tags=("apfel",))
+    add_image(app, "C", tags=("apfelbaum",), reviewed=False)
+    assert client.get("/api/v1/tags?q=APF").get_json() == {"tags": [{"name": "apfel", "count": 2}]}
+    assert {t["name"] for t in client.get("/api/v1/tags").get_json()["tags"]} == {"apfel", "obst"}
+    assert client.get("/api/v1/tags", query_string={"q": "x" * 51}).status_code == 400
+
+
+def test_media_has_type_cache_and_nosniff(app, client):
+    _, filename = add_image(app)
+    stem = filename.rsplit(".", 1)[0]
+    response = client.get(f"/media/display/{stem}.webp")
+    assert response.status_code == 200
+    assert response.mimetype == "image/webp"
+    assert response.headers["X-Content-Type-Options"] == "nosniff"
+    assert response.headers["Cache-Control"] == "public, max-age=86400"
+    # frühere Adresse bleibt gültig
+    assert client.get(f"/static/thumbnails/{stem}.webp").status_code == 200
+    original = client.get(f"/download/{filename}")
+    assert original.status_code == 200 and original.mimetype == "image/png"
+    assert "attachment" in original.headers["Content-Disposition"]
+
+
+def test_media_rejects_traversal_and_foreign_files(app, client):
+    _, filename = add_image(app)
+    (app.config["MEDIA_DIR"] / "secret.webp").write_bytes(b"x")
+    (app.config["MEDIA_DIR"] / "db.webp").write_bytes(b"x")
+    for path in ("/media/display/..%2Fsecret.webp", "/media/display/../secret.webp", "/media/uploads/" + filename,
+                 "/media/display/%2e%2e%2fsecret.webp", "/media/thumbnails/.hidden.webp",
+                 "/media/display/nicht-vorhanden.webp", "/media/display/" + filename.replace(".png", ".svg"),
+                 "/media/display/secret.webp", "/download/..%2F..%2Fdb%2Fgallery.db"):
+        assert client.get(path).status_code == 404, path
