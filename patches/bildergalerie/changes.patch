+"""JSON-API v1 (nur lesend) und Auslieferung der Bilder.
+
+Vertrag siehe API.md. Nicht freigegebene Bilder (reviewed = false) erscheinen nie,
+weder in der API noch unter /media für nicht angemeldete Besucher.
+"""
+import os
+import re
+
+from flask import Blueprint, abort, current_app, jsonify, request, send_from_directory
+from flask_login import current_user
+from sqlalchemy import event, func, or_
+from sqlalchemy.engine import Engine
+from sqlalchemy.orm import selectinload
+
+from extensions import db
+from models import Image, Tag, image_tags
+
+api_bp = Blueprint("api", __name__)
+
+MAX_PER_PAGE = 60
+DEFAULT_PER_PAGE = 24
+MAX_QUERY = 100
+MAX_TAGS = 10
+MAX_TAG = 50
+MEDIA_KINDS = {"thumbnails": "THUMBNAIL_FOLDER", "display": "DISPLAY_FOLDER"}
+MEDIA_TYPES = {".webp": "image/webp", ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
+               ".gif": "image/gif"}
+# Nur einfache Dateinamen: keine Pfadanteile, kein "..", keine Glob-Sonderzeichen
+SAFE_NAME = re.compile(r"^[A-Za-z0-9ÄÖÜäöüß][A-Za-z0-9ÄÖÜäöüß._-]{0,200}$")
+
+
+@event.listens_for(Engine, "connect")
+def _register_functions(dbapi_connection, _record):
+    """Unicode-taugliches lower() für die Suche (SQLite kennt nur ASCII)."""
+    if hasattr(dbapi_connection, "create_function"):
+        dbapi_connection.create_function("py_lower", 1, lambda value: value.lower() if isinstance(value, str) else value,
+                                         deterministic=True)
+
+
+def _bad_request(message):
+    response = jsonify({"error": message})
+    response.status_code = 400
+    return response
+
+
+def _like(text):
+    escaped = text.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+    return f"%{escaped}%"
+
+
+def media_url(kind, image):
+    return f"/media/{kind}/{image.webp_filename}"
+
+
+def serialize(image):
+    return {
+        "id": image.id,
+        "description": image.description or "",
+        "tags": sorted(tag.name for tag in image.tags if tag.name),
+        "style": image.style or None,
+        "width": image.width,
+        "height": image.height,
+        "thumbnail_url": media_url("thumbnails", image),
+        "display_url": media_url("display", image),
+        "license": current_app.config["LICENSE_NOTE"],
+    }
+
+
+def _int_arg(name, default, minimum, maximum):
+    raw = request.args.get(name, "").strip()
+    if not raw:
+        return default
+    if not raw.isdigit():
+        raise ValueError(f"{name} muss eine Zahl sein")
+    return max(minimum, min(maximum, int(raw)))
+
+
+@api_bp.get("/api/v1/images")
+def list_images():
+    try:
+        page = _int_arg("page", 1, 1, 100000)
+        per_page = _int_arg("per_page", DEFAULT_PER_PAGE, 1, MAX_PER_PAGE)
+    except ValueError as error:
+        return _bad_request(str(error))
+    q = request.args.get("q", "").strip()
+    style = request.args.get("style", "").strip().lower()
+    tags = [t.strip().lower() for t in request.args.get("tags", "").split(",") if t.strip()]
+    if len(q) > MAX_QUERY or len(style) > 80 or len(tags) > MAX_TAGS or any(len(t) > MAX_TAG for t in tags):
+        return _bad_request("Suchanfrage zu lang")
+
+    query = Image.query.filter(Image.reviewed.is_(True))
+    if q:
+        pattern = _like(q.lower())
+        query = query.filter(or_(
+            func.py_lower(Image.description).like(pattern, escape="\\"),
+            func.py_lower(Image.style).like(pattern, escape="\\"),
+            Image.tags.any(func.py_lower(Tag.name).like(pattern, escape="\\")),
+        ))
+    for tag in tags:
+        query = query.filter(Image.tags.any(Tag.name == tag))
+    if style:
+        query = query.filter(func.py_lower(Image.style) == style)
+    total = query.count()
+    items = (query.options(selectinload(Image.tags)).order_by(Image.id.desc())
+             .offset((page - 1) * per_page).limit(per_page).all())
+    return jsonify({"items": [serialize(image) for image in items], "page": page, "per_page": per_page,
+                    "total": total, "total_pages": (total + per_page - 1) // per_page})
+
+
+@api_bp.get("/api/v1/images/<int:image_id>")
+def get_image(image_id):
+    image = db.session.get(Image, image_id)
+    if image is None or not image.reviewed:
+        return jsonify({"error": "Bild nicht gefunden"}), 404
+    return jsonify(serialize(image))
+
+
+@api_bp.get("/api/v1/tags")
+def list_tags():
+    prefix = request.args.get("q", "").strip().lower()
+    if len(prefix) > MAX_TAG:
+        return _bad_request("Suchanfrage zu lang")
+    count = func.count(Image.id)
+    query = (db.session.query(Tag.name, count)
+             .join(image_tags, image_tags.c.tag_id == Tag.id)
+             .join(Image, Image.id == image_tags.c.image_id)
+             .filter(Image.reviewed.is_(True)))
+    if prefix:
+        escaped = prefix.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+        query = query.filter(func.py_lower(Tag.name).like(escaped + "%", escape="\\"))
+    rows = query.group_by(Tag.id).order_by(count.desc(), Tag.name).limit(50).all()
+    return jsonify({"tags": [{"name": name, "count": n} for name, n in rows]})
+
+
+@api_bp.get("/api/v1/<path:_rest>")
+def unknown(_rest):
+    return jsonify({"error": "Unbekannter Endpunkt"}), 404
+
+
+# --- Bilder ---------------------------------------------------------------------------
+
+def _image_for_media(filename):
+    """Bild-Datensatz zu einer abgeleiteten Datei <name>.webp bzw. einer Originaldatei."""
+    stem, extension = os.path.splitext(filename)
+    candidates = [filename]
+    if extension == ".webp":
+        candidates = [stem + ext for ext in (".png", ".jpg", ".jpeg", ".gif", ".webp",
+                                             ".PNG", ".JPG", ".JPEG", ".GIF", ".WEBP")]
+    rows = Image.query.filter(Image.filename.in_(candidates)).all()
+    # Freigegebene Bilder zuerst (zwei Originale mit gleichem Stamm teilen sich eine Ableitung)
+    return sorted(rows, key=lambda image: not image.reviewed)[0] if rows else None
+
+
+def send_media(folder_key, filename, as_attachment=False):
+    if not SAFE_NAME.fullmatch(filename) or ".." in filename:
+        abort(404)
+    extension = os.path.splitext(filename)[1].lower()
+    if extension not in MEDIA_TYPES:
+        abort(404)
+    image = _image_for_media(filename)
+    if image is None or (not image.reviewed and not current_user.is_authenticated):
+        abort(404)
+    folder = current_app.config[folder_key]
+    if not os.path.isfile(os.path.join(folder, filename)):
+        abort(404)
+    response = send_from_directory(folder, filename, mimetype=MEDIA_TYPES[extension], as_attachment=as_attachment,
+                                   max_age=86400)
+    response.headers["X-Content-Type-Options"] = "nosniff"
+    response.headers["Cache-Control"] = ("public" if current_app.config["PUBLIC"] and image.reviewed
+                                         else "private") + ", max-age=86400"
+    return response
+
+
+@api_bp.get("/media/<kind>/<filename>")
+def media(kind, filename):
+    if kind not in MEDIA_KINDS:
+        abort(404)
+    return send_media(MEDIA_KINDS[kind], filename)
+
+
+# Frühere Adressen (vor der Plattform lagen die Bilder unter /static/…); bestehende Links bleiben gültig.
+@api_bp.get("/static/thumbnails/<filename>")
+def legacy_thumbnail(filename):
+    return send_media("THUMBNAIL_FOLDER", filename)
+
+
+@api_bp.get("/static/display/<filename>")
+def legacy_display(filename):
+    return send_media("DISPLAY_FOLDER", filename)
