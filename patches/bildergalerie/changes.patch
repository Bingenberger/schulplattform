-import os
+"""Optionale KI-Metadaten (Beschreibung, Schlagworte) über Gemini/Vertex AI.
+
+Standardmäßig aus. Eingeschaltet nur mit GALLERY_AI_KEY_FILE (Pfad zu einem
+Service-Account-JSON, als Secretdatei eingebunden, nie im Image). Readiness und
+Galerie funktionieren unabhängig davon; Fehler des Dienstes führen nur dazu, dass
+keine Vorschläge kommen.
+"""
 import json
-import time
 import mimetypes
