+FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c AS runtime
+ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
+    GALLERY_DB_DIR=/data/db GALLERY_MEDIA_DIR=/data/media
+WORKDIR /app
+COPY requirements.lock ./
+RUN pip install --no-cache-dir --require-hashes -r requirements.lock
+COPY *.py ./
+COPY blueprints ./blueprints
+COPY scripts ./scripts
+COPY templates ./templates
+COPY static ./static
+RUN groupadd --gid 10001 gallery && useradd --uid 10001 --gid 10001 --no-create-home gallery \
+    && mkdir -p /data/db /data/media && chown -R 10001:10001 /data && chmod 700 /data/db /data/media
+USER 10001:10001
+EXPOSE 8000
+CMD ["gunicorn", "--config", "gunicorn.conf.py"]
+
+FROM runtime AS tests
+USER 0
+COPY requirements-test.lock ./
+RUN pip install --no-cache-dir --require-hashes -r requirements-test.lock
+USER 10001:10001
+COPY tests ./tests
+CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]
+
+FROM runtime AS final
