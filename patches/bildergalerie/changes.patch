+"""Migration als Job, Übernahme der Altdatenbank, Readiness."""
+import sqlite3
+
+import pytest
+from PIL import Image as PILImage
+
+import migrate
+from conftest import legacy_database
+
+
+def test_fresh_database_and_readiness(settings):
+    from app import create_app
+    app = create_app(overrides=settings.overrides)
+    client = app.test_client()
+    assert client.get("/health/live").status_code == 200
+    ready = client.get("/health/ready")
+    assert ready.status_code == 503 and ready.get_json()["status"] == "migration-required"
+    migrate.migrate(log=lambda *_: None, settings=settings)
+    assert client.get("/health/ready").get_json() == {"status": "ok", "database": True, "media": True}
+
+
+def test_app_start_does_not_write(settings):
+    from app import create_app
+    create_app(overrides=settings.overrides).test_client().get("/health/ready")
+    assert not (settings.DB_DIR / "gallery.db").exists()
+
+
+def test_legacy_database_is_adopted_with_ids_and_names(settings):
+    path = settings.DB_DIR / "gallery.db"
+    legacy_database(path)
+    (settings.MEDIA_DIR / "display").mkdir(parents=True)
+    PILImage.new("RGB", (1200, 900)).save(settings.MEDIA_DIR / "display" / "Apfel_f807ab63.webp", "WEBP")
+    messages = []
+    migrate.migrate(log=messages.append, settings=settings)
+    assert any("übernommen" in m for m in messages)
+    connection = sqlite3.connect(path)
+    assert connection.execute("SELECT version FROM schema_version").fetchone() == (2,)
+    assert connection.execute("SELECT id, filename, width, height FROM image ORDER BY id").fetchall() == [
+        (311, "Apfel_f807ab63.png", 1200, 900), (312, "Geheim_00000001.png", None, None)]
+    assert connection.execute("SELECT username, must_change_password FROM user").fetchall() == [("admin", 0)]
+    columns = {row[1] for row in connection.execute("PRAGMA table_info(image)")}
+    assert {"style", "width", "height"} <= columns          # fehlende ältere Spalte "style" ergänzt
+    connection.close()
+    migrate.migrate(log=lambda *_: None, settings=settings)  # zweiter Lauf ändert nichts
+    assert migrate.is_current(path)
+
+
+@pytest.mark.parametrize("extra,reason", [
+    ("ALTER TABLE image ADD COLUMN geheim TEXT;", "unbekannte Spalten"),
+    ("CREATE TABLE fremd (id INTEGER);", "Fremde Tabellen"),
+])
+def test_unknown_structures_are_refused_without_changes(settings, extra, reason):
+    path = settings.DB_DIR / "gallery.db"
+    legacy_database(path, extra)
+    before = path.read_bytes()
+    with pytest.raises(migrate.MigrationError, match=reason):
+        migrate.migrate(log=lambda *_: None, settings=settings)
+    assert path.read_bytes() == before
+
+
+def test_newer_schema_is_refused(settings):
+    migrate.migrate(log=lambda *_: None, settings=settings)
+    path = settings.DB_DIR / "gallery.db"
+    connection = sqlite3.connect(path)
+    connection.execute("UPDATE schema_version SET version = 99")
+    connection.commit()
+    connection.close()
+    with pytest.raises(migrate.MigrationError, match="99"):
+        migrate.migrate(log=lambda *_: None, settings=settings)
