new file mode 100644
index 0000000..111d84a
--- /dev/null
+++ b/bootstrap.py
@@ -0,0 +1,70 @@
+"""Lokaler Einmal-Erstzugang auf dem Terminal (kein Standardkonto, kein Passwort in der Umgebung).
+
+    python bootstrap.py <benutzername>
+
+Legt nur dann ein Konto an, wenn noch keines existiert. Das Einmal-Passwort erscheint
+ausschließlich auf dem Terminal (/dev/tty), ist 15 Minuten gültig und muss bei der
+ersten Anmeldung durch ein eigenes Passwort ersetzt werden.
+Plattform: ./install.sh app-setup bildergalerie
+"""
+import os
+import re
+import secrets
+import sys
+import time
+
+from werkzeug.security import generate_password_hash
+
+VALID_NAME = re.compile(r"^[\w.@-]{3,50}$")
+VALID_SECONDS = 15 * 60
+
+
+class BootstrapError(Exception):
+    pass
+
+
+def bootstrap(username, now=None, app=None):
+    from app import create_app
+    from extensions import db
+    from models import User
+    import migrate
+
+    if not VALID_NAME.fullmatch(username or ""):
+        raise BootstrapError("Persönlicher Benutzername erforderlich (3–50 Zeichen, keine Leerzeichen).")
+    app = app or create_app()
+    with app.app_context():
+        if not migrate.is_current(os.path.join(app.config["DB_DIR"], "gallery.db")):
+            raise BootstrapError("Datenbank ist nicht migriert (zuerst 'python migrate.py').")
+        if User.query.count():
+            raise BootstrapError("Es gibt bereits ein Konto; der Erstzugang ersetzt keine bestehenden Konten.")
+        token = secrets.token_urlsafe(18)
+        db.session.add(User(username=username, password=generate_password_hash(token), must_change_password=True,
+                            bootstrap_expires_at=int((now or time.time()) + VALID_SECONDS), session_version=0))
+        db.session.commit()
+        return token
+
+
+def main(argv=None):
+    argv = sys.argv[1:] if argv is None else argv
+    if len(argv) != 1:
+        print("Aufruf: python bootstrap.py <benutzername>", file=sys.stderr)
+        return 2
+    try:
+        tty = open("/dev/tty", "w", encoding="utf-8")
+    except OSError:
+        print("Erstzugang nur auf einem Terminal (z. B. 'docker compose exec app python bootstrap.py <name>').",
+              file=sys.stderr)
+        return 1
+    try:
+        token = bootstrap(argv[0])
+    except BootstrapError as error:
+        print(f"Erstzugang fehlgeschlagen: {error}", file=sys.stderr)
+        return 1
+    with tty:
+        tty.write(f"Einmaliger Erstzugang für '{argv[0]}', 15 Minuten gültig:\n{token}\n"
+                  "Bei der ersten Anmeldung ein eigenes Passwort (mindestens 12 Zeichen) setzen.\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
