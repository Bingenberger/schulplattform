diff --git a/migrate.py b/migrate.py
new file mode 100644
index 0000000..f4e61a9
--- /dev/null
+++ b/migrate.py
@@ -0,0 +1,230 @@
+"""Datenbank-Migration als expliziter Job (nie beim Start der App).
+
+    python migrate.py            # neue Datenbank anlegen oder bestehende vorwärts migrieren
+    python migrate.py --check    # nur prüfen, Exitcode 0 = aktuell
+
+Bestehende Datenbanken der Vor-Plattform-Version (ohne Versionstabelle, mit create_all
+und nachträglichen ALTER TABLE gewachsen) werden übernommen, wenn sie nur bekannte
+Tabellen und Spalten enthalten; fehlende ältere Spalten werden ergänzt. Unbekannte
+Strukturen brechen ab, ohne etwas zu ändern. IDs und Dateinamen bleiben unverändert.
+"""
+import argparse
+import os
+import sqlite3
+import sys
+from pathlib import Path
+
+from config import Config
+
+SCHEMA_VERSION = 2
+
+LEGACY_TABLES = {
+    "user": {"required": {"id", "username", "password"}, "optional": {}},
+    "image": {"required": {"id", "filename"},
+              "optional": {"style": "VARCHAR(80)", "ai_tool": "VARCHAR(50)", "prompt": "TEXT",
+                           "upload_date": "DATETIME", "reviewed": "BOOLEAN DEFAULT 1",
+                           "file_hash": "VARCHAR(32)", "description": "TEXT"}},
+    "tag": {"required": {"id", "name"}, "optional": {}},
+    "image_tags": {"required": {"image_id", "tag_id"}, "optional": {}},
+    "image_request": {"required": {"id", "tag_request", "timestamp"}, "optional": {}},
+}
+
+# Schema 1: Stand der Vor-Plattform-Version (für neue Datenbanken)
+SCHEMA_1 = """
+CREATE TABLE user (
+    id INTEGER NOT NULL, username VARCHAR(50), password VARCHAR(100),
+    PRIMARY KEY (id), UNIQUE (username));
+CREATE TABLE image (
+    id INTEGER NOT NULL, filename VARCHAR(255), style VARCHAR(80), ai_tool VARCHAR(50), prompt TEXT,
+    upload_date DATETIME, reviewed BOOLEAN DEFAULT 1, file_hash VARCHAR(32), description TEXT,
+    PRIMARY KEY (id));
+CREATE TABLE tag (
+    id INTEGER NOT NULL, name VARCHAR(50), PRIMARY KEY (id), UNIQUE (name));
+CREATE TABLE image_tags (
+    image_id INTEGER, tag_id INTEGER,
+    FOREIGN KEY(image_id) REFERENCES image (id), FOREIGN KEY(tag_id) REFERENCES tag (id));
+CREATE TABLE image_request (
+    id INTEGER NOT NULL, tag_request VARCHAR(100), timestamp DATETIME,
+    PRIMARY KEY (id), UNIQUE (tag_request));
+"""
+
+# Schema 2: Plattform-Version (Erstzugang, Sitzungsversion, Anmeldesperre, Bildmaße, Indizes)
+SCHEMA_2 = """
+ALTER TABLE user ADD COLUMN must_change_password BOOLEAN NOT NULL DEFAULT 0;
+ALTER TABLE user ADD COLUMN bootstrap_expires_at INTEGER;
+ALTER TABLE user ADD COLUMN session_version INTEGER NOT NULL DEFAULT 0;
+ALTER TABLE image ADD COLUMN width INTEGER;
+ALTER TABLE image ADD COLUMN height INTEGER;
+CREATE TABLE login_attempt (
+    key VARCHAR(80) NOT NULL, count INTEGER NOT NULL DEFAULT 0, window_start INTEGER NOT NULL DEFAULT 0,
+    locked_until INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (key));
+CREATE INDEX IF NOT EXISTS ix_image_filename ON image (filename);
+CREATE INDEX IF NOT EXISTS ix_image_style ON image (style);
+CREATE INDEX IF NOT EXISTS ix_image_ai_tool ON image (ai_tool);
+CREATE INDEX IF NOT EXISTS ix_image_upload_date ON image (upload_date);
+CREATE INDEX IF NOT EXISTS ix_image_reviewed ON image (reviewed);
+CREATE INDEX IF NOT EXISTS ix_image_file_hash ON image (file_hash);
+CREATE INDEX IF NOT EXISTS ix_image_tags_image_id ON image_tags (image_id);
+CREATE INDEX IF NOT EXISTS ix_image_tags_tag_id ON image_tags (tag_id);
+CREATE INDEX IF NOT EXISTS ix_image_tags_image_tag ON image_tags (image_id, tag_id);
+CREATE INDEX IF NOT EXISTS ix_image_tags_tag_image ON image_tags (tag_id, image_id);
+"""
+
+STEPS = {2: SCHEMA_2}
+
+
+class MigrationError(Exception):
+    pass
+
+
+def database_path(settings=Config):
+    return Path(settings.DB_DIR) / "gallery.db"
+
+
+def connect(path):
+    connection = sqlite3.connect(path, timeout=15, isolation_level=None)
+    connection.execute("PRAGMA foreign_keys = OFF")
+    return connection
+
+
+def tables(connection):
+    return {row[0] for row in connection.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%'")}
+
+
+def columns(connection, table):
+    return {row[1] for row in connection.execute(f'PRAGMA table_info("{table}")')}
+
+
+def current_version(connection):
+    if "schema_version" not in tables(connection):
+        return None
+    row = connection.execute("SELECT version FROM schema_version").fetchone()
+    return row[0] if row else None
+
+
+def adopt_legacy(connection):
+    """Prüft eine Datenbank der Vor-Plattform-Version; gibt die nötigen ALTER-Befehle zurück."""
+    found = tables(connection)
+    unknown = found - set(LEGACY_TABLES)
+    missing = set(LEGACY_TABLES) - found
+    if unknown or missing:
+        raise MigrationError("Unbekannte Datenbankstruktur. "
+                             f"Fremde Tabellen: {sorted(unknown) or '-'}; fehlende Tabellen: {sorted(missing) or '-'}")
+    statements, problems = [], []
+    for table, spec in LEGACY_TABLES.items():
+        present = columns(connection, table)
+        allowed = spec["required"] | set(spec["optional"])
+        if spec["required"] - present:
+            problems.append(f"{table}: fehlende Spalten {sorted(spec['required'] - present)}")
+        if present - allowed:
+            problems.append(f"{table}: unbekannte Spalten {sorted(present - allowed)}")
+        for name, ddl in spec["optional"].items():
+            if name not in present:
+                statements.append(f'ALTER TABLE "{table}" ADD COLUMN {name} {ddl}')
+    if problems:
+        raise MigrationError("Datenbank weicht von der bekannten Struktur ab: " + "; ".join(problems))
+    return statements
+
+
+def run_script(connection, script):
+    for statement in (part.strip() for part in script.split(";")):
+        if statement:
+            connection.execute(statement)
+
+
+def migrate(path=None, log=print, settings=Config):
+    path = Path(path or database_path(settings))
+    path.parent.mkdir(parents=True, exist_ok=True)
+    connection = connect(path)
+    try:
+        connection.execute("BEGIN IMMEDIATE")
+        version = current_version(connection)
+        if version is None:
+            if not tables(connection):
+                log("Neue Datenbank wird angelegt.")
+                run_script(connection, SCHEMA_1)
+            else:
+                statements = adopt_legacy(connection)
+                log(f"Bestehende Datenbank wird übernommen ({len(statements)} ältere Spalten ergänzt).")
+                for statement in statements:
+                    connection.execute(statement)
+            connection.execute("CREATE TABLE schema_version (version INTEGER NOT NULL)")
+            connection.execute("INSERT INTO schema_version (version) VALUES (1)")
+            version = 1
+        if version > SCHEMA_VERSION:
+            raise MigrationError(f"Datenbank hat Version {version}, diese App kennt nur bis {SCHEMA_VERSION}.")
+        for step in range(version + 1, SCHEMA_VERSION + 1):
+            run_script(connection, STEPS[step])
+            connection.execute("UPDATE schema_version SET version = ?", (step,))
+            log(f"Schema auf Version {step} gebracht.")
+        connection.execute("COMMIT")
+    except Exception:
+        if connection.in_transaction:
+            connection.execute("ROLLBACK")
+        raise
+    finally:
+        connection.close()
+    prepare_media(settings)
+    backfill_dimensions(path, log, settings)
+
+
+def prepare_media(settings=Config):
+    for folder in (settings.UPLOAD_FOLDER, settings.THUMBNAIL_FOLDER, settings.DISPLAY_FOLDER):
+        Path(folder).mkdir(parents=True, exist_ok=True)
+
+
+def backfill_dimensions(path, log=print, settings=Config):
+    """Maße der Anzeigeversion nachtragen (liest nur die Bildköpfe)."""
+    from PIL import Image as PILImage
+    connection = connect(path)
+    try:
+        rows = connection.execute("SELECT id, filename FROM image WHERE width IS NULL OR height IS NULL").fetchall()
+        done = 0
+        for image_id, filename in rows:
+            if not filename:
+                continue
+            display = Path(settings.DISPLAY_FOLDER) / (os.path.splitext(filename)[0] + ".webp")
+            try:
+                with PILImage.open(display) as image:
+                    width, height = image.size
+            except (OSError, ValueError):
+                continue
+            connection.execute("UPDATE image SET width = ?, height = ? WHERE id = ?", (width, height, image_id))
+            done += 1
+        if done:
+            log(f"Bildmaße für {done} Bilder nachgetragen.")
+    finally:
+        connection.close()
+
+
+def is_current(path=None):
+    path = Path(path or database_path())
+    if not path.exists():
+        return False
+    connection = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=5)
+    try:
+        return current_version(connection) == SCHEMA_VERSION
+    finally:
+        connection.close()
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--check", action="store_true", help="nur prüfen, nichts ändern")
+    args = parser.parse_args(argv)
+    if args.check:
+        current = is_current()
+        print("Schema aktuell." if current else "Migration erforderlich.")
+        return 0 if current else 1
+    try:
+        migrate()
+    except MigrationError as error:
+        print(f"Migration abgebrochen, nichts geändert: {error}", file=sys.stderr)
+        return 2
+    print("Migration abgeschlossen.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
