@@ -0,0 +1,181 @@
+"""Anmeldung, Erstzugang, CSRF, Uploads und Sichtbarkeit."""
+import io
+import time
+
+import pytest
+
+from conftest import add_image, create_user, csrf, login, png_bytes
+
+
+def test_no_default_account_and_bootstrap_only_once(app, client):
+    import bootstrap
+    with app.app_context():
+        from models import User
+        assert User.query.count() == 0
+    token = bootstrap.bootstrap("schulleitung", app=app)
+    with pytest.raises(bootstrap.BootstrapError, match="bereits ein Konto"):
+        bootstrap.bootstrap("zweite", app=app)
+    with pytest.raises(bootstrap.BootstrapError, match="Benutzername"):
+        bootstrap.bootstrap("a b", app=app)
+    # Erstzugang erzwingt ein eigenes Passwort
+    response = login(client, "schulleitung", token)
+    assert response.status_code == 302 and response.headers["Location"].endswith("/change_password")
+    assert client.get("/upload").headers["Location"].endswith("/change_password")
+    token_csrf = csrf(client, "/change_password")
+    short = client.post("/change_password", data={"old_password": token, "new_password": "kurz",
+                                                  "confirm_password": "kurz", "csrf_token": token_csrf})
+    assert short.headers["Location"].endswith("/change_password")
+    done = client.post("/change_password", data={"old_password": token, "new_password": "mein-eigenes-passwort",
+                                                 "confirm_password": "mein-eigenes-passwort", "csrf_token": token_csrf})
+    assert done.status_code == 302 and client.get("/upload").status_code == 200
+
+
+def test_expired_bootstrap_token_is_refused(app, client):
+    import bootstrap
+    token = bootstrap.bootstrap("schulleitung", now=time.time() - 3600, app=app)
+    assert login(client, "schulleitung", token).status_code == 401
+
+
+def test_bootstrap_requires_migrated_database(settings):
+    import bootstrap
+    from app import create_app
+    app = create_app(overrides=settings.overrides)
+    with pytest.raises(bootstrap.BootstrapError, match="migriert"):
+        bootstrap.bootstrap("schulleitung", app=app)
+
+
+def test_login_locks_after_five_failures_also_for_the_right_password(app, client):
+    create_user(app)
+    for _ in range(5):
+        assert login(client, password="falsch-falsch-falsch").status_code == 401
+    assert login(client).status_code == 429
+    # unbekannte Namen teilen sich einen Zähler und verraten nichts
+    for _ in range(5):
+        login(client, username="gibtesnicht", password="x")
+    assert login(client, username="auchnicht", password="x").status_code == 429
+
+
+def test_success_resets_the_counter(app, client):
+    create_user(app)
+    for _ in range(4):
+        login(client, password="falsch")
+    assert login(client).status_code == 302
+    client.post("/logout", data={"csrf_token": csrf(client, "/")})
+    for _ in range(4):
+        assert login(client, password="falsch").status_code == 401
+
+
+def test_password_change_ends_other_sessions(app):
+    create_user(app)
+    first, second = app.test_client(), app.test_client()
+    login(first)
+    login(second)
+    token = csrf(first, "/change_password")
+    first.post("/change_password", data={"old_password": "ein-langes-passwort", "new_password": "ganz-neues-passwort",
+                                         "confirm_password": "ganz-neues-passwort", "csrf_token": token})
+    assert first.get("/upload").status_code == 200
+    assert second.get("/upload").status_code == 302
+
+
+def test_writes_require_csrf(app, client):
+    create_user(app)
+    assert client.post("/login", data={"username": "lehrkraft", "password": "ein-langes-passwort"}).status_code == 400
+    login(client)
+    assert client.post("/logout").status_code == 400
+    assert client.post("/upload", data={"file": (io.BytesIO(png_bytes()), "a.png")}).status_code == 400
+    assert client.post("/api/request_image", json={"tag": "zebra"}).status_code == 400
+    assert client.get("/logout").status_code == 405
+
+
+def _upload(client, data, name):
+    token = csrf(client, "/upload")
+    return client.post("/upload", data={"file": (io.BytesIO(data), name)}, headers={"X-CSRF-Token": token},
+                       content_type="multipart/form-data")
+
+
+def test_upload_checks_signature_and_uses_random_names(app, client):
+    create_user(app)
+    login(client)
+    assert _upload(client, b"<svg xmlns='http://www.w3.org/2000/svg'/>", "bild.png").status_code == 400
+    assert _upload(client, b"GIF89a" + b"\x00" * 20, "kaputt.gif").status_code == 400
+    assert _upload(client, png_bytes(), "bild.exe").status_code == 400
+    # JPEG mit PNG-Endung: gespeichert wird nach erkanntem Format
+    response = _upload(client, png_bytes(fmt="JPEG"), "../../Roter Apfel.png")
+    assert response.status_code == 200
+    with app.app_context():
+        from extensions import db
+        from models import Image
+        image = db.session.get(Image, response.get_json()["image_id"])
+        assert image.filename.startswith("Roter_Apfel_") and image.filename.endswith(".jpg")
+        assert len(image.filename) == len("Roter_Apfel_") + 12 + 4
+        assert not image.reviewed and (image.width, image.height) == (64, 48)
+    assert _upload(client, png_bytes(fmt="JPEG"), "nochmal.jpg").status_code == 409
+
+
+def test_upload_rejects_oversized_requests_and_pixel_bombs(make_app):
+    app = make_app(MAX_CONTENT_LENGTH=50_000, MAX_IMAGE_PIXELS=1000)
+    client = app.test_client()
+    create_user(app)
+    login(client)
+    assert _upload(client, b"\x89PNG\r\n\x1a\n" + b"0" * 60_000, "gross.png").status_code == 413
+    assert _upload(client, png_bytes(size=(100, 100)), "bombe.png").status_code == 400
+
+
+def test_ai_metadata_is_off_by_default(app, client):
+    image_id, _ = add_image(app)
+    create_user(app)
+    login(client)
+    token = csrf(client, "/")
+    assert client.post(f"/api/generate_ai_metadata/{image_id}", headers={"X-CSRF-Token": token}).status_code == 503
+
+
+def test_public_gallery_hides_unreviewed_images_from_visitors(app, client):
+    add_image(app, "Sichtbar", description="sichtbar-beschreibung")
+    add_image(app, "Geheim", reviewed=False, description="geheim-beschreibung")
+    page = client.get("/").get_data(as_text=True)
+    assert "sichtbar-beschreibung" in page and "geheim-beschreibung" not in page
+    assert client.get("/license").status_code == 200
+
+
+def test_private_gallery_requires_login_or_api_token(make_app):
+    app = make_app(PUBLIC=False, API_TOKEN="t" * 43)
+    client = app.test_client()
+    _, filename = add_image(app)
+    stem = filename.rsplit(".", 1)[0]
+    assert client.get("/").status_code == 302
+    assert client.get("/license").status_code == 200 and client.get("/health/live").status_code == 200
+    assert client.get("/api/v1/images").status_code == 401
+    assert client.get("/api/v1/images", headers={"Authorization": "Bearer falsch"}).status_code == 401
+    assert client.get("/api/v1/images", headers={"Authorization": "t" * 43}).status_code == 401
+    auth = {"Authorization": "Bearer " + "t" * 43}
+    assert client.get("/api/v1/images", headers=auth).get_json()["total"] == 1
+    media = client.get(f"/media/thumbnails/{stem}.webp", headers=auth)
+    assert media.status_code == 200 and media.headers["Cache-Control"] == "private, max-age=86400"
+    assert client.get(f"/media/thumbnails/{stem}.webp").status_code == 401
+    # Das Token öffnet nur API und Bilder, nicht die Oberfläche
+    assert client.get("/", headers=auth).status_code == 302
+    create_user(app)
+    login(client)
+    assert client.get("/").status_code == 200
+
+
+def test_private_gallery_without_token_has_no_anonymous_api(make_app):
+    app = make_app(PUBLIC=False, API_TOKEN="")
+    client = app.test_client()
+    assert client.get("/api/v1/images", headers={"Authorization": "Bearer "}).status_code == 401
+
+
+def test_image_wishes_are_bounded(make_app):
+    app = make_app(MAX_OPEN_IMAGE_REQUESTS=1, IMAGE_REQUEST_COOLDOWN_SECONDS=0)
+    client = app.test_client()
+    token = csrf(client, "/")
+    assert client.post("/api/request_image", json={"tag": "zebra"}, headers={"X-CSRF-Token": token}).status_code == 200
+    assert client.post("/api/request_image", json={"tag": "giraffe"}, headers={"X-CSRF-Token": token}).status_code == 429
+    assert client.post("/api/request_image", json={"tag": ["x"]}, headers={"X-CSRF-Token": token}).status_code == 400
+
+
+def test_security_headers(client):
+    response = client.get("/license")
+    assert response.headers["X-Frame-Options"] == "DENY"
+    assert "frame-ancestors 'none'" in response.headers["Content-Security-Policy"]
+    assert "https://" not in response.get_data(as_text=True).split("<body")[0]  # keine fremden Ressourcen im Kopf
