+    expected = current_app.config.get("API_TOKEN") or ""
+    header = request.headers.get("Authorization", "")
+    if not expected or not header.startswith("Bearer "):
+        return False
+    return compare_digest(header[len("Bearer "):].strip().encode(), expected.encode())
+
+
+def enforce_visibility():
+    """Bei GALLERY_PUBLIC=false: HTML und Medien nur angemeldet, API angemeldet oder mit Token."""
+    if current_app.config["PUBLIC"] or request.endpoint in ALWAYS_OPEN or request.endpoint is None:
+        return None
+    if current_user.is_authenticated:
+        return None
+    if request.path.startswith(("/api/v1/", "/media/")) and bearer_token_valid():
+        return None
+    if request.path.startswith(("/api/", "/media/")):
+        return jsonify({"error": "Anmeldung erforderlich"}), 401
+    from flask import redirect, url_for
+    return redirect(url_for("admin.login"))
+
+
+# --- Anmeldesperre nach Fehlversuchen -------------------------------------------------
+
+def _attempt_key(username, known):
+    return username.lower()[:80] if known else "_unknown"
+
+
+# Ein Prozess (gunicorn: 1 Worker, mehrere Threads): Prüfen und Zählen unter einer Sperre,
+# damit parallele Anfragen nicht alle vor dem ersten gezählten Fehlversuch durchkommen.
+_ATTEMPT_LOCK = threading.Lock()
+
+
+def login_allowed(username, known):
+    """Prüft die Sperre und zählt den Versuch vorab; ein Erfolg setzt den Zähler zurück."""
+    with _ATTEMPT_LOCK:
+        return _reserve_attempt(_attempt_key(username, known))
+
+
+def _reserve_attempt(key):
+    from models import LoginAttempt
+    now = int(time.time())
+    lock = current_app.config["LOGIN_LOCK_SECONDS"]
+    row = db.session.get(LoginAttempt, key)
+    if row and row.locked_until > now:
+        db.session.commit()
+        return False
+    if not row:
+        row = LoginAttempt(key=key, count=0, window_start=now, locked_until=0)
+        db.session.add(row)
+    if now - row.window_start > lock:
+        row.count, row.window_start, row.locked_until = 0, now, 0
+    row.count += 1
+    if row.count >= current_app.config["LOGIN_MAX_FAILURES"]:
+        row.locked_until = now + lock
+    # Alte Einträge aufräumen
+    LoginAttempt.query.filter(LoginAttempt.window_start < now - 2 * lock,
+                              LoginAttempt.locked_until <= now).delete(synchronize_session=False)
+    db.session.commit()
+    return True
+
 
+def login_succeeded(username):
+    from models import LoginAttempt
+    LoginAttempt.query.filter_by(key=_attempt_key(username, True)).delete(synchronize_session=False)
+    db.session.commit()
