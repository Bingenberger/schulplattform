+"""Plattformbetrieb: Readiness am Alembic-Stand, Proxy-Vertrauen, Schlüsseldatei, Erstzugang."""
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from app import create_app
+
+
+def file_app(directory, **extra):
+    return create_app("testing", {
+        "SQLALCHEMY_DATABASE_URI": f"sqlite:///{directory}/database.db", "AUTO_CREATE_DB": False,
+        "UPLOAD_FOLDER": f"{directory}/uploads", **extra})
+
+
+class PlatformTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.dir = self.tmp.name
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_ready_only_after_explicit_upgrade_and_no_file_created(self):
+        app = file_app(self.dir)
+        client = app.test_client()
+        self.assertEqual(client.get("/health/live").status_code, 200)
+        self.assertEqual(client.get("/health/ready").status_code, 503)
+        self.assertFalse(Path(self.dir, "database.db").exists())
+        from flask_migrate import upgrade
+        with app.app_context():
+            upgrade(directory=str(Path(__file__).resolve().parent.parent / "migrations"))
+        self.assertEqual(client.get("/health/ready").status_code, 200)
+
+    def test_unknown_revision_is_not_ready(self):
+        app = file_app(self.dir)
+        from flask_migrate import upgrade
+        with app.app_context():
+            upgrade(directory=str(Path(__file__).resolve().parent.parent / "migrations"))
+        import sqlite3
+        with sqlite3.connect(Path(self.dir, "database.db")) as conn:
+            conn.execute("UPDATE alembic_version SET version_num='ffffffffffff'")
+        self.assertEqual(app.test_client().get("/health/ready").status_code, 503)
+
+    def test_forwarded_headers_only_from_configured_proxy(self):
+        import config
+        with mock.patch.dict(os.environ, {"SL_OFFICE_PROXY_IPS": "10.231.14.2"}):
+            proxies = config._proxy_ips()
+        with mock.patch.dict(os.environ, {"SL_OFFICE_PROXY_IPS": "*"}):
+            with self.assertRaises(ValueError):
+                config._proxy_ips()
+        app = create_app("testing", {"PROXY_IPS": proxies})
+        seen = {}
+
+        @app.get("/_probe")
+        def _probe():
+            from flask import request
+            seen.update(ip=request.remote_addr, url=request.url_root)
+            return "ok"
+
+        client = app.test_client()
+        headers = {"X-Forwarded-For": "203.0.113.9", "X-Forwarded-Proto": "https", "X-Forwarded-Host": "anmeldung.schule.example"}
+        client.get("/_probe", headers=headers, environ_base={"REMOTE_ADDR": "10.231.14.2"})
+        self.assertEqual(seen, {"ip": "203.0.113.9", "url": "https://anmeldung.schule.example/"})
+        client.get("/_probe", headers=headers, environ_base={"REMOTE_ADDR": "10.9.9.9"})
+        self.assertEqual(seen["ip"], "10.9.9.9")
+        self.assertTrue(seen["url"].startswith("http://localhost"))
+
+    def test_production_secret_from_file(self):
+        key = Path(self.dir, "key")
+        key.write_text("p" * 40 + "\n")
+        env = {"SL_OFFICE_SECRET_KEY_FILE": str(key), "SL_OFFICE_DATABASE_URL": f"sqlite:///{self.dir}/x.db"}
+        with mock.patch.dict(os.environ, env):
+            os.environ.pop("SL_OFFICE_SECRET_KEY", None)
+            from config import ProductionConfig
+            self.assertEqual(ProductionConfig.values()["SECRET_KEY"], "p" * 40)
+            os.environ["SL_OFFICE_SECRET_KEY"] = "q" * 40
+            with self.assertRaises(RuntimeError):
+                ProductionConfig.values()
+
+    def test_create_admin_without_default_password(self):
+        app = create_app("testing")
+        runner = app.test_cli_runner()
+        short = runner.invoke(args=["create-admin", "--username", "sl-leitung"], input="kurz\nkurz\n" * 3)
+        self.assertNotEqual(short.exit_code, 0)
+        ok = runner.invoke(args=["create-admin", "--username", "sl-leitung"],
+                           input="ein-langes-passwort\nein-langes-passwort\n")
+        self.assertEqual(ok.exit_code, 0, ok.output)
+        with app.app_context():
+            from models import User
+            user = User.query.filter_by(username="sl-leitung").one()
+            self.assertEqual(user.role, "Administrator")
+            self.assertFalse(user.two_factor_active)
+        again = runner.invoke(args=["create-admin", "--username", "sl-leitung"], input="x\n")
+        self.assertNotEqual(again.exit_code, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
