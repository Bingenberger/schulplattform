+FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c AS runtime
+ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 HOME=/tmp \
+    SL_OFFICE_ENV=production SL_OFFICE_DATABASE_URL=sqlite:////data/database.db \
+    SL_OFFICE_UPLOAD_FOLDER=/data/uploads SL_OFFICE_BACKUP_FOLDER=/data/backups \
+    SL_OFFICE_SCHOOL_SIGNATURE=/data/briefkopf/unterschrift.png
+WORKDIR /app
+COPY requirements.lock ./
+RUN pip install --no-cache-dir --require-hashes -r requirements.lock
+COPY . ./
+RUN groupadd --gid 10001 sloffice && useradd --uid 10001 --gid 10001 --no-create-home sloffice \
+    && mkdir -p /data/uploads /data/backups /data/briefkopf && chown -R 10001:10001 /data && chmod 700 /data
+USER 10001:10001
+EXPOSE 8000
+CMD ["gunicorn", "--config", "gunicorn.conf.py"]
+
+FROM runtime AS tests
+ENV SL_OFFICE_ENV=testing
+CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-q"]
+
+FROM runtime AS final
diff --git a/PLATFORM.md b/PLATFORM.md
new file mode 100644
index 0000000..e4a60fe
--- /dev/null
+++ b/PLATFORM.md
@@ -0,0 +1,45 @@
+# SL-Office (Schulanmeldung): Containervertrag
+
+Python 3.12.12/amd64, Flask 3.1.2, SQLAlchemy 2.0, Alembic 1.19, ReportLab 4.4, Gunicorn 26.2.0
+aus Hash-Lockfile (`requirements.lock`); Basisimage mit Digest. Läuft schreibgeschützt als
+UID/GID 10001 ohne Capabilities; beschreibbar sind `/data` und `/tmp`.
+
+## Dienste
+
+| Dienst | Aufgabe |
+| --- | --- |
+| `app` | Gunicorn (2 Worker × 2 Threads), interne Verwaltung und Elternportal |
+| `worker` | `sl_worker.py`: stündliche Terminerinnerungen (ersetzt `sl-office-reminders.timer`), Herzschlag in `/tmp` |
+
+## Eigenständiger Start
+
+```sh
+openssl rand -hex 32 > .secret-key && chmod 600 .secret-key
+export SL_OFFICE_SECRET_FILE="$PWD/.secret-key"
+docker compose build
+docker compose run --rm app flask --app app db upgrade
+docker compose run --rm app flask --app app create-admin    # persönlicher Zugang, 2FA beim ersten Login
+docker compose up -d --no-build
+```
+
+`create_admin.py` (admin/admin123) bleibt ein reines Entwicklungswerkzeug; im Container gibt es
+keinen Standardzugang.
+
+## Konfiguration im Container
+
+| Variable | Bedeutung |
+| --- | --- |
+| `SL_OFFICE_SECRET_KEY_FILE` | Datei mit dem Schlüssel (oder `SL_OFFICE_SECRET_KEY`), mind. 32 Zeichen; nur Sitzungen/CSRF |
+| `SL_OFFICE_PROXY_IPS` | Adressen des Reverse-Proxys; nur von dort zählen `X-Forwarded-*` (hat Vorrang vor `SL_OFFICE_TRUSTED_PROXIES`) |
+| `SL_OFFICE_PUBLIC_BASE_URL` | öffentliche Adresse für Links in Mails des Erinnerungsdienstes |
+| `SL_OFFICE_MAIL_*` | SMTP; in der Plattform das Relay ohne TLS im internen Netz |
+| `SL_OFFICE_DATABASE_URL`, `…_UPLOAD_FOLDER`, `…_BACKUP_FOLDER` | im Image `/data/database.db`, `/data/uploads`, `/data/backups` |
+| `SL_OFFICE_SCHOOL_SIGNATURE` | `/data/briefkopf/unterschrift.png`; die Unterschrift ist **nicht** im Image |
+
+## Schema
+
+Kein Schemaaufbau beim Start. `flask --app app db upgrade` ist der explizite Schritt.
+`/health/ready` meldet erst bereit, wenn `alembic_version` genau den Heads der mitgelieferten
+Migrationen entspricht (unbekannte, neuere Revisionen → 503); `/health/live` prüft nur den Prozess.
+
+Gunicorn schreibt keine Zugriffsprotokolle: Aktivierungs- und Anmeldelinks tragen Token in der URL.
