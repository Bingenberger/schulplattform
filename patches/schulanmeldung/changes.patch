+bind = "0.0.0.0:8000"
+workers = 2
+threads = 2
+timeout = 120             # PDF-Sammeldrucke
+graceful_timeout = 30
+accesslog = None          # Aktivierungs- und Anmeldelinks tragen Token in der URL
+errorlog = "-"
