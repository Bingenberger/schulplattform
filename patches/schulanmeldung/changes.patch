+"""Erinnerungsdienst im Container (ersetzt sl-office-reminders.timer).
+
+Ein eigener Prozess, damit die mehreren Gunicorn-Arbeitsprozesse nichts doppelt senden.
+Stündlich; schreibt einen Herzschlag nach /tmp, den der Healthcheck prüft.
+"""
+import os
+import random
+import signal
+import threading
+import time
+from pathlib import Path
+
+from app import app
+from sl_office.appointments.cli import _run
+
+INTERVAL = int(os.getenv("SL_OFFICE_REMINDER_INTERVAL_SECONDS", "3600"))
+HEARTBEAT = Path(os.getenv("SL_OFFICE_WORKER_HEARTBEAT", "/tmp/sl-worker.alive"))
+stop = threading.Event()
+
+
+def beat():
+    HEARTBEAT.touch()
+
+
+def main():
+    signal.signal(signal.SIGTERM, lambda *_: stop.set())
+    signal.signal(signal.SIGINT, lambda *_: stop.set())
+    beat()
+    stop.wait(60 + random.randint(0, 120))           # nicht gleichzeitig mit dem Webstart
+    while not stop.is_set():
+        try:
+            with app.app_context():
+                sent, skipped = _run(app)
+            app.logger.warning("Erinnerungen verschickt: %s, übersprungen: %s", sent, skipped)
+        except Exception:  # ein Fehler darf den Dienst nicht beenden; nächster Lauf in einer Stunde
+            app.logger.exception("Erinnerungslauf fehlgeschlagen")
+        deadline = time.monotonic() + INTERVAL
+        while not stop.is_set() and time.monotonic() < deadline:
+            beat()
+            stop.wait(60)
+
+
+if __name__ == "__main__":
+    main()
