{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schulplattform:config:1",
  "title": "Schulplattform host configuration (platform.toml), schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "platform",
    "smtp",
    "backup",
    "apps"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management_domain",
        "acme_email",
        "acme_environment",
        "public_ipv4"
      ],
      "properties": {
        "management_domain": {
          "$ref": "#/$defs/hostname"
        },
        "acme_email": {
          "type": "string",
          "pattern": "^[^@\\s]{1,64}@[a-z0-9.-]{1,253}$"
        },
        "acme_environment": {
          "enum": [
            "staging",
            "production",
            "custom"
          ]
        },
        "acme_ca": {
          "type": "string",
          "pattern": "^https://[a-zA-Z0-9.:/_-]{1,240}$"
        },
        "acme_ca_root": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9._/-]{1,240}$"
        },
        "public_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "public_ipv6": {
          "type": "string"
        },
        "resolvers": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "network_base": {
          "type": "string",
          "pattern": "^10\\.[0-9]{1,3}\\.0\\.0/16$"
        },
        "issued_root": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9._/-]{1,240}$",
          "description": "custom (test) ACME only: root that signs issued certificates, used for verification"
        }
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "sink",
            "relay"
          ]
        },
        "host": {
          "$ref": "#/$defs/hostname"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "security": {
          "enum": [
            "starttls",
            "tls"
          ]
        },
        "username": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^\\s]*$"
        },
        "sender": {
          "type": "string",
          "pattern": "^[^@\\s<>]{1,64}@[a-z0-9.-]{1,253}$"
        },
        "sender_name": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[^<>\"\\r\\n]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "relay"
              }
            }
          },
          "then": {
            "required": [
              "host",
              "port",
              "security",
              "sender"
            ]
          }
        }
      ]
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule"
      ],
      "properties": {
        "schedule": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "offsite": {
          "type": "string",
          "pattern": "^(sftp://[a-zA-Z0-9._-]+@[a-z0-9.-]+(:[0-9]{1,5})?/[a-zA-Z0-9._/-]*|/[a-zA-Z0-9._/-]+)$"
        }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^(gswb|schulwissen|zackboing|schulhelfer|losverkauf|grundschultafel|fahrradausbildung|leseflux|kompetenz-manager|abgen|fundkiste|schuleva|schulkasse|schulanmeldung|sl-journal)$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "hostname"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hostname": {
              "$ref": "#/$defs/hostname"
            },
            "gallery_origin": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "platform": {
            "properties": {
              "acme_environment": {
                "const": "custom"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "platform": {
            "required": [
              "acme_ca"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "hostname": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
    }
  }
}
